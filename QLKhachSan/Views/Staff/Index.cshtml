@using QLKhachSan.Models
@{
    Layout = null;
    var perms = ViewBag.Permissions as List<string> ?? new List<string>();


    bool canViewBookings = perms.Contains("bookings.view") || perms.Contains("bookings.approve") || perms.Contains("bookings.checkout") || perms.Contains("payments.manage");
    bool canApproveBookings = perms.Contains("bookings.approve");
    bool canCheckIn = perms.Contains("bookings.checkin");
    bool canCheckOut = perms.Contains("bookings.checkout");
    bool canViewRooms = perms.Contains("rooms.view") || perms.Contains("rooms.manage");
    bool canFoodOrders = perms.Contains("restaurant.orders") || perms.Contains("restaurant.manage");
    bool canRevenue = perms.Contains("payments.manage") || perms.Contains("revenue.view");
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Staff Dashboard - Luxury Hotel</title>

    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
</head>

<body class="bg-[#f8f5ee] min-h-screen text-[#21170f]">
    @Html.Partial("~/Views/Shared/_SecurityClient.cshtml")

    <!-- HEADER -->
    <header class="bg-[#241c17] text-[#f8f1e7] shadow-xl border-b border-[#d4af37]/30">
        <div class="max-w-7xl mx-auto px-6 py-5 flex flex-col md:flex-row items-center justify-between gap-4">
            <div class="flex items-center gap-4">
                <div class="w-12 h-12 rounded-xl bg-gradient-to-r from-[#d4af37] to-[#f5d77a] text-[#21170f] flex items-center justify-center text-xl font-bold shadow-md">
                    <i class="fas fa-user-tie"></i>
                </div>
                <div>
                    <h1 class="text-2xl font-serif font-bold text-[#f5d77a]">STAFF DASHBOARD</h1>
                    <p class="text-gray-300 text-xs tracking-wider">HỆ THỐNG QUẢN LÝ TẬP TRUNG - LUXURY HOTEL</p>
                </div>
            </div>

            <div class="flex items-center gap-3">
                <a href="@Url.Action("Index", "Home")" class="bg-[#2c2018] hover:bg-[#38281f] border border-[#d4af37]/40 text-[#f5d77a] font-semibold px-4 py-2.5 rounded-xl transition text-sm">
                    <i class="fas fa-house mr-1"></i> Trang chủ
                </a>
                <a href="#" onclick="openLuxuryLogoutModal(event); return false;" class="bg-rose-700 hover:bg-rose-800 text-white font-bold px-4 py-2.5 rounded-xl transition text-sm shadow-md">
                    <i class="fas fa-right-from-bracket mr-1"></i> Đăng xuất
                </a>
            </div>
        </div>
    </header>

    <main class="max-w-7xl mx-auto px-6 py-10">

        <!-- WELCOME -->
        <div class="bg-white rounded-2xl border border-[#e7dbc1] p-6 shadow-sm mb-8">
            <p class="text-gray-500 text-sm">Xin chào nhân viên,</p>
            <h2 class="text-3xl font-extrabold text-[#21170f]">
                @(Session["FullName"] != null ? Session["FullName"].ToString() : Session["Username"].ToString())
            </h2>
            <p class="text-xs text-gray-500 mt-1">
                <i class="fas fa-shield-halved text-indigo-600 mr-1"></i> Bảng điều khiển công việc theo quyền hạn được cấp
            </p>
        </div>

        <!-- THỐNG KÊ THEO QUYỀN HẠN -->
        <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-5 mb-9">

            @if (canViewBookings)
            {
                <a href="@Url.Action("Bookings", "Staff", new { status = "Chờ xác nhận" })" class="bg-white rounded-2xl border border-[#e7dbc1] shadow-sm p-5 hover:shadow-md transition">
                    <div class="flex items-center justify-between">
                        <div>
                            <p class="text-gray-500 text-sm">Đơn phòng chờ xác nhận</p>
                            <p class="text-3xl font-extrabold text-amber-600 mt-2">@ViewBag.PendingBookings</p>
                        </div>
                        <div class="w-14 h-14 rounded-2xl bg-amber-100 text-amber-600 flex items-center justify-center text-2xl">
                            <i class="fas fa-clock"></i>
                        </div>
                    </div>
                </a>
            }

            @if (canCheckIn)
            {
                <a href="@Url.Action("TodayCheckIns", "Staff")" class="bg-white rounded-2xl border border-[#e7dbc1] shadow-sm p-5 hover:shadow-md transition">
                    <div class="flex items-center justify-between">
                        <div>
                            <p class="text-gray-500 text-sm">Nhận phòng hôm nay</p>
                            <p class="text-3xl font-extrabold text-blue-600 mt-2">@ViewBag.TodayCheckIns</p>
                        </div>
                        <div class="w-14 h-14 rounded-2xl bg-blue-100 text-blue-600 flex items-center justify-center text-2xl">
                            <i class="fas fa-door-open"></i>
                        </div>
                    </div>
                </a>
            }

            @if (canFoodOrders)
            {
                <a href="@Url.Action("FoodOrders", "Staff")" class="bg-white rounded-2xl border border-[#e7dbc1] shadow-sm p-5 hover:shadow-md transition">
                    <div class="flex items-center justify-between">
                        <div>
                            <p class="text-gray-500 text-sm">Đơn món đang xử lý</p>
                            <p class="text-3xl font-extrabold text-orange-600 mt-2">@ViewBag.PendingFoodOrders</p>
                        </div>
                        <div class="w-14 h-14 rounded-2xl bg-orange-100 text-orange-600 flex items-center justify-center text-2xl">
                            <i class="fas fa-utensils"></i>
                        </div>
                    </div>
                </a>
            }

            @if (canRevenue)
            {
                <div class="bg-white rounded-2xl border border-[#e7dbc1] shadow-sm p-5">
                    <div class="flex items-center justify-between gap-4">
                        <div>
                            <p class="text-gray-500 text-sm">Doanh thu hôm nay</p>
                            <p class="text-2xl font-extrabold text-emerald-600 mt-2 whitespace-nowrap">
                                @(((decimal)ViewBag.TodayRevenue).ToString("N0"))đ
                            </p>
                        </div>
                        <div class="w-14 h-14 rounded-2xl bg-emerald-100 text-emerald-600 flex items-center justify-center text-2xl flex-shrink-0">
                            <i class="fas fa-money-bill-wave"></i>
                        </div>
                    </div>
                </div>
            }

        </div>

        <!-- MA TRẬN 40 PHÒNG VẬT LÝ -->
        @if (canViewRooms)
        {
            <div class="bg-white rounded-2xl border border-[#e7dbc1] p-6 shadow-sm mb-10">
                <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-6 border-b pb-4">
                    <div>
                        <h3 class="text-xl font-bold text-[#21170f] flex items-center gap-2">
                            <i class="fas fa-th-large text-indigo-600"></i> Sơ đồ Ma trận 40 Phòng Vật lý
                        </h3>
                        <p class="text-xs text-gray-500 mt-1">Trạng thái phòng thực tế phân bố từ Tầng 1 đến Tầng 8</p>
                    </div>
                    <div class="flex flex-wrap gap-2 text-xs font-bold">
                        <span class="px-3 py-1 bg-emerald-100 text-emerald-800 rounded-full">🟩 Trống</span>
                        <span class="px-3 py-1 bg-yellow-100 text-yellow-800 rounded-full">🟨 Chờ xác nhận</span>
                        <span class="px-3 py-1 bg-amber-100 text-amber-800 rounded-full">🟧 Đã đặt</span>
                        <span class="px-3 py-1 bg-rose-100 text-rose-800 rounded-full">🟥 Đang ở</span>
                        <span class="px-3 py-1 bg-gray-200 text-gray-800 rounded-full">🧹 Bảo trì</span>
                    </div>
                </div>

                <section id="staffRoomMatrix" data-url="@Url.Action("GetPhysicalRoomsMatrixByDate", "Staff")" data-today="@DateTime.Today.ToString("yyyy-MM-dd")" data-bookings-url="@(canViewBookings ? Url.Action("Bookings", "Staff") : canCheckIn ? Url.Action("TodayCheckIns", "Staff") : "")">
                    <!-- THANH LỊCH CHỌN NGÀY (7 NGÀY & DATE PICKER) -->
                    <div class="bg-[#111827] text-white p-4 rounded-2xl mb-6 shadow-md">
                        <div class="flex flex-col lg:flex-row items-center justify-between gap-4">
                            <!-- Controls Left: Prev 7 days, Today, Next 7 days, Refresh -->
                            <div class="flex items-center gap-2 w-full lg:w-auto justify-between lg:justify-start">
                                <button type="button" data-shift="-7" class="px-3.5 py-2 bg-white/10 hover:bg-yellow-500 hover:text-gray-900 rounded-xl text-xs font-bold transition flex items-center gap-1" title="7 ngày trước">
                                    <i class="fas fa-chevron-left"></i> 7 Ngày trước
                                </button>
                                <button type="button" id="staffMatrixToday" class="px-3.5 py-2 bg-gradient-to-r from-yellow-400 to-amber-500 text-gray-900 rounded-xl text-xs font-extrabold shadow transition">
                                    <i class="fas fa-calendar-day mr-1"></i> Hôm nay
                                </button>
                                <button type="button" data-shift="7" class="px-3.5 py-2 bg-white/10 hover:bg-yellow-500 hover:text-gray-900 rounded-xl text-xs font-bold transition flex items-center gap-1" title="7 ngày sau">
                                    7 Ngày sau <i class="fas fa-chevron-right"></i>
                                </button>
                                <button type="button" id="staffMatrixRefresh" class="px-3 py-2 bg-white/10 hover:bg-white/20 rounded-xl text-xs font-bold transition" title="Tải lại">
                                    <i class="fas fa-rotate"></i>
                                </button>
                            </div>

                            <!-- 7 Days Buttons Bar -->
                            <div id="staffMatrixWeek" class="flex items-center gap-1.5 overflow-x-auto w-full lg:w-auto pb-1 lg:pb-0 justify-start lg:justify-center" aria-label="Lịch 7 ngày">
                                <!-- Dynamic 7 day pill buttons rendered by JS -->
                            </div>

                            <!-- Custom Date Picker -->
                            <div class="flex items-center gap-2 w-full lg:w-auto justify-end">
                                <span class="text-xs text-gray-300 font-semibold hidden sm:inline">Chọn ngày:</span>
                                <input type="date" id="staffMatrixDate" class="bg-gray-800 text-yellow-300 border border-yellow-500/50 rounded-xl px-3 py-1.5 text-xs font-bold outline-none focus:ring-2 focus:ring-yellow-400" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                            </div>
                        </div>
                    </div>

                    <p id="staffMatrixLoading" role="status" class="text-sm text-amber-600 font-bold mb-3" hidden><i class="fas fa-spinner fa-spin mr-1"></i> Đang tải lịch phòng...</p>
                    <p id="staffMatrixError" role="alert" class="text-sm text-red-700 font-semibold mb-3" hidden></p>
                    <p id="staffMatrixDateTitle" class="font-bold text-amber-800 mb-3 text-sm"></p>
                    <div id="staffMatrixGrid" class="grid grid-cols-2 sm:grid-cols-4 md:grid-cols-5 lg:grid-cols-8 gap-3"></div>
                    <div id="staffUnassigned" class="mt-4 text-sm" hidden></div>
                    <dialog id="staffRoomDialog" class="rounded-3xl p-6 w-full max-w-lg shadow-2xl border border-[#e7dbc1]" style="max-height:85vh;overflow:auto">
                        <div class="flex justify-between items-center pb-3 border-b mb-3">
                            <h4 id="staffRoomTitle" class="font-extrabold text-lg text-gray-900"></h4>
                            <button type="button" id="staffRoomClose" aria-label="Đóng" class="w-8 h-8 rounded-full bg-gray-100 hover:bg-gray-200 text-gray-700 flex items-center justify-center text-sm font-bold">✕</button>
                        </div>
                        <div id="staffRoomBody" class="space-y-3 text-xs"></div>
                    </dialog>
                </section>
            </div>
        }

        <!-- MENU CHỨC NĂNG NGHIỆP VỤ -->
        <div class="mb-5">
            <h2 class="text-2xl font-extrabold text-gray-900">Chức năng nghiệp vụ</h2>
            <p class="text-gray-500 mt-1">Chỉ hiển thị các chức năng tương ứng với quyền hạn được cấp.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">

            @if (canViewBookings)
            {
                <div class="bg-white rounded-2xl shadow-sm border border-[#e7dbc1] p-6">
                    <div class="w-14 h-14 rounded-xl bg-blue-100 text-blue-600 flex items-center justify-center text-2xl mb-5">
                        <i class="fas fa-calendar-check"></i>
                    </div>
                    <h3 class="text-xl font-extrabold">Đơn đặt phòng</h3>
                    <p class="text-gray-500 text-sm mt-2 mb-5">Xem và xử lý các đơn đặt phòng của khách.</p>
                    <a href="@Url.Action("Bookings", "Staff")" class="inline-flex items-center gap-2 text-blue-600 font-bold hover:underline">
                        Quản lý đơn <i class="fas fa-arrow-right"></i>
                    </a>
                </div>
            }

            @if (canApproveBookings)
            {
                <div class="bg-white rounded-2xl shadow-sm border border-[#e7dbc1] p-6">
                    <div class="w-14 h-14 rounded-xl bg-emerald-100 text-emerald-600 flex items-center justify-center text-2xl mb-5">
                        <i class="fas fa-plus"></i>
                    </div>
                    <h3 class="text-xl font-extrabold">Tạo đơn tại quầy</h3>
                    <p class="text-gray-500 text-sm mt-2 mb-5">Hỗ trợ khách đặt phòng trực tiếp tại quầy lễ tân.</p>
                    <a href="@Url.Action("CreateBooking", "Staff")" class="inline-flex items-center gap-2 text-emerald-600 font-bold hover:underline">
                        Tạo đơn <i class="fas fa-arrow-right"></i>
                    </a>
                </div>
            }

            @if (canFoodOrders)
            {
                <div class="bg-white rounded-2xl shadow-sm border border-[#e7dbc1] p-6">
                    <div class="w-14 h-14 rounded-xl bg-amber-100 text-amber-700 flex items-center justify-center text-2xl mb-5">
                        <i class="fas fa-utensils"></i>
                    </div>
                    <h3 class="text-xl font-extrabold">Đơn gọi món F&B</h3>
                    <p class="text-gray-500 text-sm mt-2 mb-5">Xác nhận và cập nhật trạng thái món ăn giao phòng.</p>
                    <a href="@Url.Action("FoodOrders", "Staff")" class="inline-flex items-center gap-2 text-amber-700 font-bold hover:underline">
                        Xử lý đơn món <i class="fas fa-arrow-right"></i>
                    </a>
                </div>
            }

        </div>

    </main>

    @Html.Partial("~/Views/Shared/_LuxuryModal.cshtml")
    <script src="@Url.Content("~/Scripts/staff-room-matrix.js")" defer></script>

</body>
</html>
