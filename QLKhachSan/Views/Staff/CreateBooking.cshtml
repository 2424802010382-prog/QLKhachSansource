@using QLKhachSan.Models
@using System.Collections.Generic

@{
    Layout = null;

    var rooms =
        ViewBag.Rooms
        as List<Room>;
}

<!DOCTYPE html>

<html lang="vi">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        Tạo đơn đặt phòng - Nhân viên
    </title>


    <script src="https://cdn.tailwindcss.com"></script>


    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

</head>


<body class="bg-gray-100 min-h-screen">


    <header class="bg-[#111827]
               text-white">

        <div class="max-w-5xl
                mx-auto
                px-6
                py-5
                flex
                justify-between
                items-center">

            <div>

                <p class="text-yellow-400
                      tracking-[3px]
                      text-xs">

                    LUXURY HOTEL

                </p>

                <h1 class="text-2xl
                       font-extrabold">

                    TẠO ĐƠN ĐẶT PHÒNG

                </h1>

                <p class="text-gray-400
                      text-sm">

                    Nhân viên hỗ trợ khách tại quầy

                </p>

            </div>


            <a href="@Url.Action(
                    "Index",
                    "Staff"
                 )"
               class="bg-yellow-500
                  hover:bg-yellow-600
                  text-black
                  font-bold
                  px-4
                  py-2.5
                  rounded-xl">

                <i class="fas
                      fa-arrow-left
                      mr-1">
                </i>

                Trang nhân viên

            </a>

        </div>

    </header>


    <main class="max-w-5xl
             mx-auto
             px-5
             py-8">


        @if (
            TempData["StaffError"] != null
        )
        {
            <div class="bg-red-50
                    text-red-700
                    border
                    border-red-200
                    rounded-xl
                    p-4
                    mb-5">

                @TempData["StaffError"]

            </div>
        }


        <div class="bg-white
                rounded-2xl
                shadow-sm
                p-7">


            <form method="post"
                  action="@Url.Action(
                          "CreateBooking",
                          "Staff"
                      )">

                @Html.AntiForgeryToken()


                <h2 class="text-xl
                       font-extrabold
                       mb-5">

                    <i class="fas
                          fa-user
                          text-yellow-600
                          mr-2">
                    </i>

                    Thông tin khách hàng

                </h2>


                <div class="grid
                        grid-cols-1
                        md:grid-cols-2
                        gap-5">


                    <div>

                        <label class="block
                                  font-bold
                                  mb-2">

                            Họ tên *

                        </label>

                        <input type="text"
                               name="customerName"
                               required
                               class="w-full
                                  border
                                  rounded-xl
                                  px-4
                                  py-3"
                               placeholder="Nguyễn Văn A" />

                    </div>


                    <div>

                        <label class="block
                                  font-bold
                                  mb-2">

                            Số điện thoại *

                        </label>

                        <input type="text"
                               name="customerPhone"
                               required
                               class="w-full
                                  border
                                  rounded-xl
                                  px-4
                                  py-3"
                               placeholder="0901234567" />

                    </div>


                    <div class="md:col-span-2">

                        <label class="block
                                  font-bold
                                  mb-2">

                            Email *

                        </label>

                        <input type="email"
                               name="customerEmail"
                               required
                               class="w-full
                                  border
                                  rounded-xl
                                  px-4
                                  py-3"
                               placeholder="khach@gmail.com" />

                    </div>

                </div>



                <hr class="my-7" />


                <h2 class="text-xl
                       font-extrabold
                       mb-5">

                    <i class="fas
                          fa-bed
                          text-yellow-600
                          mr-2">
                    </i>

                    Thông tin phòng

                </h2>


                <div class="grid
                        grid-cols-1
                        md:grid-cols-2
                        gap-5">


                    <div class="md:col-span-2">

                        <label class="block
                                  font-bold
                                  mb-2">

                            Chọn phòng *

                        </label>


                        <select name="roomId"
                                id="roomId"
                                onchange="calculateTotal()"
                                required
                                class="w-full
                                   border
                                   rounded-xl
                                   px-4
                                   py-3">

                            <option value="">
                                -- Chọn loại phòng --
                            </option>


                            @if (
                                rooms != null
                            )
                            {
                                foreach (
                                    var room
                                    in rooms
                                )
                                {
                                    <option value="@room.RoomId"
                                            data-price="@room.Price"
                                            data-capacity="@room.Capacity">

                                        @room.RoomName
                                        -
                                        @room.Price.ToString("N0")đ/đêm
                                        -
                                        @room.Capacity người/phòng

                                    </option>
                                }
                            }

                        </select>

                    </div>


                    <div>

                        <label class="block
                                  font-bold
                                  mb-2">

                            Ngày nhận *

                        </label>

                        <input type="date"
                               id="checkInDate"
                               name="checkInDate"
                               onchange="calculateTotal()"
                               required
                               class="w-full
                                  border
                                  rounded-xl
                                  px-4
                                  py-3" />

                    </div>


                    <div>

                        <label class="block
                                  font-bold
                                  mb-2">

                            Ngày trả *

                        </label>

                        <input type="date"
                               id="checkOutDate"
                               name="checkOutDate"
                               onchange="calculateTotal()"
                               required
                               class="w-full
                                  border
                                  rounded-xl
                                  px-4
                                  py-3" />

                    </div>


                    <div>

                        <label class="block
                                  font-bold
                                  mb-2">

                            Số phòng *

                        </label>

                        <input type="number"
                               id="roomCount"
                               name="roomCount"
                               value="1"
                               min="1"
                               onchange="calculateTotal()"
                               required
                               class="w-full
                                  border
                                  rounded-xl
                                  px-4
                                  py-3" />

                    </div>


                    <div>

                        <label class="block
                                  font-bold
                                  mb-2">

                            Số khách *

                        </label>

                        <input type="number"
                               id="guestCount"
                               name="guestCount"
                               value="1"
                               min="1"
                               required
                               class="w-full
                                  border
                                  rounded-xl
                                  px-4
                                  py-3" />

                    </div>

                </div>



                <hr class="my-7" />


                <h2 class="text-xl
                       font-extrabold
                       mb-5">

                    <i class="fas
                          fa-credit-card
                          text-yellow-600
                          mr-2">
                    </i>

                    Thanh toán

                </h2>


                <div class="grid
                        grid-cols-1
                        md:grid-cols-2
                        gap-5">


                    <div>

                        <label class="block
                                  font-bold
                                  mb-2">

                            Phương thức *

                        </label>


                        <select name="paymentMethod"
                                required
                                class="w-full
                                   border
                                   rounded-xl
                                   px-4
                                   py-3">

                            <option value="Tiền mặt">
                                Tiền mặt
                            </option>

                            <option value="Chuyển khoản">
                                Chuyển khoản
                            </option>

                        </select>

                    </div>


                    <div>

                        <label class="block
                                  font-bold
                                  mb-2">

                            Tổng tiền dự kiến

                        </label>


                        <div class="bg-yellow-50
                                border
                                border-yellow-200
                                rounded-xl
                                px-4
                                py-3">

                            <span id="estimatedTotal"
                                  class="text-2xl
                                     font-extrabold
                                     text-yellow-700">

                                0đ

                            </span>

                        </div>

                    </div>


                    <div class="md:col-span-2">

                        <label class="block
                                  font-bold
                                  mb-2">

                            Yêu cầu đặc biệt

                        </label>

                        <textarea name="specialRequest"
                                  rows="4"
                                  class="w-full
                                     border
                                     rounded-xl
                                     px-4
                                     py-3"
                                  placeholder="Ví dụ: phòng tầng cao, gần thang máy..."></textarea>

                    </div>

                </div>



                <div class="flex
                        gap-3
                        mt-8">


                    <a href="@Url.Action(
                            "Index",
                            "Staff"
                         )"
                       class="border
                          px-6
                          py-3
                          rounded-xl
                          font-bold">

                        Quay lại

                    </a>


                    <button type="submit"
                            class="flex-1
                               bg-yellow-500
                               hover:bg-yellow-600
                               text-black
                               font-extrabold
                               rounded-xl
                               py-3">

                        <i class="fas
                              fa-calendar-check
                              mr-2">
                        </i>

                        TẠO ĐƠN ĐẶT PHÒNG

                    </button>

                </div>

            </form>

        </div>

    </main>



    <script>

    // =========================================================
    // KHỞI TẠO NGÀY
    // =========================================================

    function formatDateInput(date) {

        const year =
            date.getFullYear();

        const month =
            String(
                date.getMonth() + 1
            ).padStart(2, '0');

        const day =
            String(
                date.getDate()
            ).padStart(2, '0');


        return (
            year +
            '-' +
            month +
            '-' +
            day
        );

    }


    function setupDates() {

        const today =
            new Date();

        const tomorrow =
            new Date(today);

        tomorrow.setDate(
            tomorrow.getDate() + 1
        );


        const checkIn =
            document.getElementById(
                'checkInDate'
            );

        const checkOut =
            document.getElementById(
                'checkOutDate'
            );


        checkIn.min =
            formatDateInput(
                today
            );


        checkIn.value =
            formatDateInput(
                today
            );


        checkOut.min =
            formatDateInput(
                tomorrow
            );


        checkOut.value =
            formatDateInput(
                tomorrow
            );


        calculateTotal();

    }



    // =========================================================
    // TÍNH TỔNG TIỀN TẠM TÍNH
    // =========================================================

    function calculateTotal() {

        const roomSelect =
            document.getElementById(
                'roomId'
            );


        const option =
            roomSelect.options[
                roomSelect.selectedIndex
            ];


        const price =
            Number(
                option &&
                option.dataset.price
                    ? option.dataset.price
                    : 0
            );


        const roomCount =
            Number(
                document.getElementById(
                    'roomCount'
                ).value || 1
            );


        const checkInValue =
            document.getElementById(
                'checkInDate'
            ).value;


        const checkOutValue =
            document.getElementById(
                'checkOutDate'
            ).value;


        let nights =
            0;


        if (
            checkInValue &&
            checkOutValue
        )
        {
            const checkIn =
                new Date(
                    checkInValue +
                    'T00:00:00'
                );

            const checkOut =
                new Date(
                    checkOutValue +
                    'T00:00:00'
                );


            nights =
                Math.round(
                    (
                        checkOut -
                        checkIn
                    )
                    /
                    86400000
                );
        }


        if (nights < 0)
        {
            nights = 0;
        }


        const total =
            price *
            roomCount *
            nights;


        document.getElementById(
            'estimatedTotal'
        ).textContent =
            total.toLocaleString(
                'vi-VN'
            )
            +
            'đ';

    }


    window.addEventListener(
        'load',
        setupDates
    );

    </script>


</body>

</html>