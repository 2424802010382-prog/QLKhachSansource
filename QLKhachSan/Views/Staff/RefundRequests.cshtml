@model IEnumerable<QLKhachSan.Models.StaffRefundListViewModel>

@{
    Layout = null;
    string currentKeyword = ViewBag.Keyword as string ?? "";
    string currentStatus = ViewBag.Status as string ?? "";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Yêu Cầu Hoàn Tiền - Nhân Viên</title>

    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400..900;1,400..900&family=Plus+Jakarta+Sans:ital,wght@0,300..800;1,300..800&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Plus Jakarta Sans', Arial, sans-serif; }
        .font-serif { font-family: 'Playfair Display', Georgia, serif !important; }
    </style>
</head>

<body class="bg-[#f8f5ee] min-h-screen text-[#21170f]">
    @Html.Partial("~/Views/Shared/_SecurityClient.cshtml")
    @Html.AntiForgeryToken()

    <!-- HEADER -->
    <header class="bg-[#241c17] text-[#f8f1e7] shadow-xl border-b border-[#d4af37]/30 sticky top-0 z-40">
        <div class="max-w-7xl mx-auto px-6 py-4 flex flex-col md:flex-row items-center justify-between gap-4">
            <div class="flex items-center gap-4">
                <div class="w-12 h-12 rounded-xl bg-gradient-to-r from-[#d4af37] to-[#f5d77a] text-[#21170f] flex items-center justify-center text-xl font-bold shadow-md">
                    <i class="fas fa-hand-holding-dollar"></i>
                </div>
                <div>
                    <h1 class="text-2xl font-serif font-bold text-[#f5d77a]">YÊU CẦU HOÀN TIỀN</h1>
                    <p class="text-gray-300 text-xs tracking-wider">KIỂM TRA &amp; XÁC NHẬN YÊU CẦU HOÀN TIỀN CỦA KHÁCH HÀNG</p>
                </div>
            </div>

            <div class="flex items-center gap-2 flex-wrap justify-center">
                <a href="@Url.Action("Index", "Staff")" class="bg-white/10 hover:bg-white/20 text-yellow-300 border border-yellow-500/30 text-xs font-semibold px-3 py-2 rounded-xl transition">
                    <i class="fas fa-chart-line mr-1"></i> Dashboard
                </a>
                <a href="@Url.Action("RefundRequests", "Staff")" class="bg-[#d4af37] text-[#21170f] font-bold text-xs px-3 py-2 rounded-xl shadow-md">
                    <i class="fas fa-hand-holding-dollar mr-1"></i> Hoàn tiền
                </a>
                <a href="@Url.Action("Index", "Home")" class="bg-[#2c2018] hover:bg-[#38281f] border border-[#d4af37]/40 text-[#f5d77a] font-semibold px-3 py-2 rounded-xl transition text-xs">
                    <i class="fas fa-house mr-1"></i> Trang chủ
                </a>
            </div>
        </div>
    </header>

    <main class="max-w-7xl mx-auto px-6 py-8">

        <!-- THÔNG BÁO -->
        <div id="alertBox" class="hidden mb-6 rounded-xl p-4 flex items-center gap-3"></div>

        <!-- BỘ LỌC TÌM KIẾM -->
        <div class="bg-white rounded-2xl border border-[#e7dbc1] p-6 shadow-sm mb-8">
            <form method="get" action="@Url.Action("RefundRequests", "Staff")" class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                <div>
                    <label class="block text-xs font-bold uppercase tracking-wider text-gray-600 mb-2">Tìm kiếm</label>
                    <div class="relative">
                        <i class="fas fa-search absolute left-3.5 top-1/2 -translate-y-1/2 text-gray-400"></i>
                        <input type="text" name="keyword" value="@currentKeyword" placeholder="Mã đơn, Tên, SĐT, Email..." class="w-full border border-gray-300 rounded-xl pl-10 pr-3 py-2.5 text-sm focus:ring-2 focus:ring-[#d4af37] focus:outline-none" />
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-bold uppercase tracking-wider text-gray-600 mb-2">Trạng thái</label>
                    <select name="status" class="w-full border border-gray-300 rounded-xl px-3 py-2.5 text-sm focus:ring-2 focus:ring-[#d4af37] focus:outline-none">
                        <option value="">-- Tất cả trạng thái --</option>
                        <option value="ChoDuyet" @(currentStatus == "ChoDuyet" ? "selected" : "")>Chờ nhân viên duyệt</option>
                        <option value="NhanVienDaDuyet" @(currentStatus == "NhanVienDaDuyet" ? "selected" : "")>Nhân viên đã xác nhận (Chờ Admin)</option>
                        <option value="DaHoanTien" @(currentStatus == "DaHoanTien" ? "selected" : "")>Đã hoàn tiền</option>
                        <option value="TuChoi" @(currentStatus == "TuChoi" ? "selected" : "")>Đã từ chối</option>
                    </select>
                </div>

                <div class="flex items-end gap-2">
                    <button type="submit" class="bg-[#d4af37] hover:bg-[#b89428] text-[#21170f] font-bold px-5 py-2.5 rounded-xl transition flex-1 text-sm shadow-sm">
                        <i class="fas fa-filter mr-1.5"></i> Lọc danh sách
                    </button>
                    <a href="@Url.Action("RefundRequests", "Staff")" class="border border-gray-300 text-gray-600 font-bold px-4 py-2.5 rounded-xl hover:bg-gray-50 transition text-sm">
                        Đặt lại
                    </a>
                </div>
            </form>
        </div>

        <!-- DANH SÁCH YÊU CẦU HOÀN TIỀN -->
        <div class="bg-white rounded-2xl border border-[#e7dbc1] shadow-xl overflow-hidden">
            <div class="p-6 border-b border-[#e7dbc1] bg-gradient-to-r from-[#faf8f3] to-[#f4efe3] flex justify-between items-center">
                <h2 class="font-serif font-bold text-[#21170f] text-xl flex items-center gap-2">
                    <i class="fas fa-list-check text-[#d4af37]"></i> Danh sách Yêu cầu Hoàn tiền (@(Model != null ? Model.Count() : 0))
                </h2>
            </div>

            @if (Model == null || !Model.Any())
            {
                <div class="p-16 text-center text-gray-500">
                    <i class="fas fa-inbox text-5xl mb-3 text-gray-300"></i>
                    <p class="font-semibold text-gray-600">Không tìm thấy yêu cầu hoàn tiền nào phù hợp.</p>
                </div>
            }
            else
            {
                <div class="overflow-x-auto">
                    <table class="w-full text-left text-sm">
                        <thead class="bg-[#171006] text-[#f5d77a] uppercase text-xs font-bold tracking-wider border-b border-[#d4af37]/30">
                            <tr>
                                <th class="p-4">Mã Đơn</th>
                                <th class="p-4">Khách hàng</th>
                                <th class="p-4">Thông tin Thanh toán</th>
                                <th class="p-4">Ngân hàng &amp; STK</th>
                                <th class="p-4">Trạng thái</th>
                                <th class="p-4 text-center">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-[#eee8db]">
                            @foreach (var item in Model)
                            {
                                <tr class="hover:bg-[#fcfbfa] transition">
                                    <td class="p-4 align-top">
                                        <div class="font-bold text-gray-900 text-base">#@item.BookingId</div>
                                        <div class="text-xs text-gray-500 font-medium">@item.RoomName</div>
                                        <div class="text-xs text-gray-400 mt-1">@item.RequestedAt.ToString("dd/MM/yyyy HH:mm")</div>
                                    </td>
                                    <td class="p-4 align-top">
                                        <div class="font-bold text-gray-900">@item.CustomerName</div>
                                        <div class="text-xs text-gray-600"><i class="fas fa-phone mr-1 text-amber-600"></i>@item.CustomerPhone</div>
                                        <div class="text-xs text-gray-600"><i class="fas fa-envelope mr-1 text-amber-600"></i>@item.CustomerEmail</div>
                                    </td>
                                    <td class="p-4 align-top">
                                        <div class="text-xs text-gray-500">Đã thanh toán: <strong class="text-gray-900">@item.PaidAmount.ToString("N0")đ</strong></div>
                                        <div class="text-xs text-amber-700 font-bold mt-0.5">Mức hoàn: @item.RefundRate%</div>
                                        <div class="text-sm font-black text-rose-600 mt-1">Cần hoàn: @item.RefundAmount.ToString("N0")đ</div>
                                    </td>
                                    <td class="p-4 align-top">
                                        <div class="font-bold text-[#21170f]">@item.BankName</div>
                                        <div class="text-xs font-mono font-bold text-indigo-700 tracking-wider">@item.AccountNumber</div>
                                        <div class="text-xs font-bold text-gray-800 uppercase mt-0.5">@item.AccountHolder</div>
                                        <div class="text-xs text-gray-500 mt-1.5 italic max-w-xs truncate bg-[#faf9f6] p-1.5 rounded-lg border border-[#eee8db]" title="@item.Reason">Lý do: "@item.Reason"</div>
                                    </td>
                                    <td class="p-4 align-top">
                                        @if (item.Status == "ChoDuyet")
                                        {
                                            <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-amber-100 text-amber-800 border border-amber-300">
                                                <i class="fas fa-clock mr-1.5"></i> Chờ duyệt
                                            </span>
                                        }
                                        else if (item.Status == "NhanVienDaDuyet")
                                        {
                                            <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-blue-100 text-blue-800 border border-blue-300">
                                                <i class="fas fa-user-check mr-1.5"></i> NV đã xác nhận (Chờ Admin)
                                            </span>
                                        }
                                        else if (item.Status == "DaHoanTien")
                                        {
                                            <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-green-100 text-green-800 border border-green-300">
                                                <i class="fas fa-circle-check mr-1.5"></i> Đã hoàn tiền
                                            </span>
                                        }
                                        else if (item.Status == "TuChoi")
                                        {
                                            <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-rose-100 text-rose-800 border border-rose-300" title="@item.RejectedReason">
                                                <i class="fas fa-circle-xmark mr-1.5"></i> Từ chối
                                            </span>
                                            if (!string.IsNullOrWhiteSpace(item.RejectedReason))
                                            {
                                                <div class="text-xs text-rose-600 mt-1 max-w-xs">Lý do: @item.RejectedReason</div>
                                            }
                                        }
                                    </td>
                                    <td class="p-4 align-top text-center">
                                        @if (item.Status == "ChoDuyet")
                                        {
                                            <div class="flex flex-col gap-2">
                                                <button type="button" onclick="verifyRefund(@item.RefundRequestId)" class="bg-emerald-600 hover:bg-emerald-700 text-white font-bold px-3.5 py-2 rounded-xl text-xs transition shadow-md flex items-center justify-center gap-1">
                                                    <i class="fas fa-check"></i> Xác nhận hợp lệ
                                                </button>
                                                <button type="button" onclick="openRejectModal(@item.RefundRequestId)" class="bg-rose-600 hover:bg-rose-700 text-white font-bold px-3.5 py-2 rounded-xl text-xs transition shadow-md flex items-center justify-center gap-1">
                                                    <i class="fas fa-xmark"></i> Từ chối
                                                </button>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-xs text-gray-400 font-semibold italic">Đã xử lý</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </main>

    <!-- MODAL TỪ CHỐI -->
    <div id="rejectModal" class="fixed inset-0 bg-black/70 hidden justify-center items-center p-4 z-50">
        <div class="bg-white rounded-2xl max-w-md w-full p-6 shadow-2xl relative">
            <h3 class="text-xl font-bold text-gray-900 mb-3">Từ chối Yêu cầu Hoàn tiền</h3>
            <p class="text-xs text-gray-500 mb-4">Nhập rõ lý do từ chối để thông báo cho khách hàng.</p>
            <input type="hidden" id="rejectRequestId" value="0" />
            <div class="mb-5">
                <label class="block text-xs font-bold uppercase text-gray-700 mb-1">Lý do từ chối <span class="text-red-500">*</span></label>
                <textarea id="rejectReason" rows="3" class="w-full border border-gray-300 rounded-xl p-3 text-sm focus:ring-2 focus:ring-rose-500 focus:outline-none" placeholder="Ví dụ: Thông tin tài khoản ngân hàng không chính xác..."></textarea>
            </div>
            <div class="flex gap-3 justify-end">
                <button type="button" onclick="closeRejectModal()" class="px-4 py-2 border border-gray-300 rounded-xl text-sm font-bold text-gray-700 hover:bg-gray-50">Hủy</button>
                <button type="button" onclick="submitRejectRefund()" class="px-4 py-2 bg-rose-600 hover:bg-rose-700 text-white rounded-xl text-sm font-bold shadow-md">Xác nhận Từ chối</button>
            </div>
        </div>
    </div>

    <script>
        function getAntiForgeryToken() {
            const el = document.querySelector('input[name="__RequestVerificationToken"]');
            return el ? el.value : '';
        }

        function showAlert(msg, isSuccess) {
            const box = document.getElementById('alertBox');
            box.className = 'mb-6 rounded-xl p-4 flex items-center gap-3 ' + (isSuccess ? 'bg-green-50 border border-green-200 text-green-800' : 'bg-red-50 border border-red-200 text-red-800');
            box.innerHTML = '<i class="fas ' + (isSuccess ? 'fa-circle-check text-green-600' : 'fa-circle-exclamation text-red-600') + ' text-xl"></i><div>' + msg + '</div>';
            box.classList.remove('hidden');
        }

        let pendingVerifyId = null;

        function verifyRefund(id) {
            pendingVerifyId = id;
            const modal = document.getElementById('customStaffConfirmModal');
            modal.classList.remove('hidden');
            modal.classList.add('flex');
            setTimeout(() => {
                modal.classList.remove('opacity-0');
                modal.children[0].classList.remove('scale-95');
                modal.children[0].classList.add('scale-100');
            }, 10);
        }

        function closeStaffConfirmModal() {
            const modal = document.getElementById('customStaffConfirmModal');
            modal.classList.add('opacity-0');
            modal.children[0].classList.remove('scale-100');
            modal.children[0].classList.add('scale-95');
            setTimeout(() => {
                modal.classList.add('hidden');
                modal.classList.remove('flex');
            }, 300);
            pendingVerifyId = null;
        }

        function executeStaffVerify() {
            if (!pendingVerifyId) return;
            const id = pendingVerifyId;
            closeStaffConfirmModal();

            fetch('@Url.Action("VerifyRefundRequest", "Staff")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken': getAntiForgeryToken()
                },
                body: '__RequestVerificationToken=' + encodeURIComponent(getAntiForgeryToken()) + '&id=' + id
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    showAlert(data.message, true);
                    setTimeout(() => location.reload(), 1200);
                } else {
                    showAlert(data.message, false);
                }
            })
            .catch(err => showAlert('Có lỗi xảy ra kết nối server.', false));
        }

        function openRejectModal(id) {
            document.getElementById('rejectRequestId').value = id;
            document.getElementById('rejectReason').value = '';
            document.getElementById('rejectModal').classList.remove('hidden');
            document.getElementById('rejectModal').classList.add('flex');
        }

        function closeRejectModal() {
            document.getElementById('rejectModal').classList.add('hidden');
            document.getElementById('rejectModal').classList.remove('flex');
        }

        function submitRejectRefund() {
            const id = document.getElementById('rejectRequestId').value;
            const reason = document.getElementById('rejectReason').value.trim();
            if (!reason) {
                showAlert('Vui lòng nhập lý do từ chối.', false);
                return;
            }

            fetch('@Url.Action("RejectRefundRequest", "Staff")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken': getAntiForgeryToken()
                },
                body: '__RequestVerificationToken=' + encodeURIComponent(getAntiForgeryToken()) + '&id=' + id + '&reason=' + encodeURIComponent(reason)
            })
            .then(res => res.json())
            .then(data => {
                closeRejectModal();
                if (data.success) {
                    showAlert(data.message, true);
                    setTimeout(() => location.reload(), 1200);
                } else {
                    showAlert(data.message, false);
                }
            })
            .catch(err => showAlert('Có lỗi xảy ra kết nối server.', false));
        }
    </script>

    <!-- MODAL XÁC NHẬN HỢP LỆ (STAFF) -->
    <div id="customStaffConfirmModal" class="fixed inset-0 bg-black/70 hidden justify-center items-center p-4 z-[60] transition-opacity duration-300 opacity-0">
        <div class="bg-white rounded-2xl max-w-sm w-full p-6 shadow-2xl text-center relative transform scale-95 transition-transform duration-300">
            <div class="w-14 h-14 mx-auto rounded-full bg-emerald-100 text-emerald-700 flex items-center justify-center text-xl mb-4">
                <i class="fas fa-check-circle"></i>
            </div>
            <h4 class="text-xl font-bold text-gray-900 mb-2">Xác Nhận Hợp Lệ</h4>
            <p class="text-gray-600 text-sm mb-6 leading-relaxed">Bạn đã kiểm tra thông tin và chuyển yêu cầu này cho Admin xử lý chuyển khoản hoàn tiền?</p>
            <div class="flex gap-3">
                <button type="button" onclick="closeStaffConfirmModal()" class="w-1/2 border border-gray-300 text-gray-700 font-bold py-2.5 rounded-xl hover:bg-gray-50 transition text-sm">Hủy</button>
                <button type="button" onclick="executeStaffVerify()" class="w-1/2 bg-[#171006] hover:bg-black text-[#f5d77a] font-bold py-2.5 rounded-xl transition shadow-md text-sm">Xác Nhận</button>
            </div>
        </div>
    </div>
</body>
</html>
