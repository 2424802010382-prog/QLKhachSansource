@using System
@{ Layout = null; ViewBag.AdminPage = "Revenue"; int selectedYear = ViewBag.SelectedYear != null ? Convert.ToInt32(ViewBag.SelectedYear) : DateTime.Today.Year; decimal roomYearRevenue = ViewBag.RoomYearRevenue != null ? Convert.ToDecimal(ViewBag.RoomYearRevenue) : 0; decimal foodYearRevenue = ViewBag.FoodYearRevenue != null ? Convert.ToDecimal(ViewBag.FoodYearRevenue) : 0; decimal yearRevenue = ViewBag.YearRevenue != null ? Convert.ToDecimal(ViewBag.YearRevenue) : 0; }
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>Thống kê doanh thu</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
</head>
<body class="bg-[#f4f6fb] min-h-screen">
    @Html.Partial("_AdminSidebar")<div class="lg:ml-72 min-h-screen">
    <header class="bg-white border-b sticky top-0 z-30"><div class="px-5 lg:px-8 py-4 flex flex-col md:flex-row md:items-center md:justify-between gap-4"><div><p class="text-xs tracking-[2px] font-bold text-indigo-500">THỐNG KÊ</p><h1 class="text-3xl font-extrabold">Doanh thu năm @selectedYear</h1></div><form method="get" action="@Url.Action("Revenue","Admin")" class="flex gap-3"><input type="number" name="year" min="2000" max="2100" value="@selectedYear" class="border rounded-xl px-4 py-2.5 w-32" /><button type="submit" class="bg-indigo-600 text-white font-bold px-4 py-2.5 rounded-xl">Xem</button></form></div></header><main class="p-5 lg:p-8">
        <section class="grid grid-cols-1 md:grid-cols-3 gap-5 mb-7"><div class="bg-white rounded-2xl border p-6"><p class="text-gray-500">Doanh thu phòng</p><p class="text-2xl font-extrabold text-blue-700 mt-2">@roomYearRevenue.ToString("N0")đ</p></div><div class="bg-white rounded-2xl border p-6"><p class="text-gray-500">Doanh thu nhà hàng</p><p class="text-2xl font-extrabold text-orange-700 mt-2">@foodYearRevenue.ToString("N0")đ</p></div><div class="bg-white rounded-2xl border p-6"><p class="text-gray-500">Tổng doanh thu</p><p class="text-2xl font-extrabold text-green-700 mt-2">@yearRevenue.ToString("N0")đ</p></div></section>
        <section class="grid grid-cols-1 lg:grid-cols-3 gap-5 mb-7"><div class="lg:col-span-2 bg-white rounded-2xl border p-6"><h2 class="text-xl font-extrabold mb-5">Doanh thu 12 tháng</h2><div style="height:420px"><canvas id="yearChart"></canvas></div></div><div class="bg-white rounded-2xl border p-6"><h2 class="text-xl font-extrabold mb-5">Giao dịch đã thanh toán</h2><div class="space-y-4"><div class="bg-blue-50 rounded-2xl p-5"><p class="text-gray-500 text-sm">Thanh toán phòng</p><p class="text-3xl font-extrabold text-blue-700 mt-1">@ViewBag.PaidRoomPayments</p></div><div class="bg-orange-50 rounded-2xl p-5"><p class="text-gray-500 text-sm">Đơn món thanh toán</p><p class="text-3xl font-extrabold text-orange-700 mt-1">@ViewBag.PaidFoodOrders</p></div></div></div></section>
        <section class="bg-white rounded-2xl border overflow-hidden"><div class="p-6 border-b"><h2 class="text-xl font-extrabold">Chi tiết theo tháng</h2></div><div class="overflow-x-auto"><table class="w-full min-w-[800px]"><thead class="bg-[#111827] text-white"><tr><th class="p-4 text-left">Tháng</th><th class="p-4 text-right">Phòng</th><th class="p-4 text-right">Nhà hàng</th><th class="p-4 text-right">Tổng</th></tr></thead><tbody id="revenueTableBody"></tbody></table></div></section>
    </main>
</div>
<script>const labels=@Html.Raw(System.Web.Helpers.Json.Encode(ViewBag.MonthLabels));const roomData=@Html.Raw(System.Web.Helpers.Json.Encode(ViewBag.RoomRevenueData));const foodData=@Html.Raw(System.Web.Helpers.Json.Encode(ViewBag.FoodRevenueData));const totalData=@Html.Raw(System.Web.Helpers.Json.Encode(ViewBag.TotalRevenueData));new Chart(document.getElementById('yearChart'),{type:'bar',data:{labels:labels,datasets:[{label:'Phòng',data:roomData,backgroundColor:'rgba(37,99,235,.72)',borderRadius:8},{label:'Nhà hàng',data:foodData,backgroundColor:'rgba(249,115,22,.72)',borderRadius:8}]},options:{responsive:true,maintainAspectRatio:false}});const body=document.getElementById('revenueTableBody');function money(v){return Number(v||0).toLocaleString('vi-VN')+'đ'}for(let i=0;i<labels.length;i++){const r=document.createElement('tr');r.className='border-b hover:bg-gray-50';r.innerHTML='<td class="p-4 font-bold">'+labels[i]+'</td><td class="p-4 text-right text-blue-700 font-bold">'+money(roomData[i])+'</td><td class="p-4 text-right text-orange-700 font-bold">'+money(foodData[i])+'</td><td class="p-4 text-right text-green-700 font-extrabold">'+money(totalData[i])+'</td>';body.appendChild(r)}</script>
</body>
</html>
