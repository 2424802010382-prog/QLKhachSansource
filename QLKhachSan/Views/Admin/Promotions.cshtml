@model IEnumerable<QLKhachSan.Models.KhuyenMai>
@using System
@using System.Linq
@{ Layout = null; ViewBag.AdminPage = "Promotions"; DateTime today = DateTime.Today; }
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>Quản lý khuyến mãi</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <style>
        .modal-hidden {
            display: none
        }
    </style>
</head>
<body class="bg-[#f4f6fb] min-h-screen">
    @Html.Partial("_AdminSidebar")<div class="lg:ml-72 min-h-screen">
    <header class="bg-white border-b sticky top-0 z-30"><div class="px-5 lg:px-8 py-4 flex justify-between gap-4"><div><p class="text-xs tracking-[2px] font-bold text-indigo-500">DỊCH VỤ & ƯU ĐÃI</p><h1 class="text-3xl font-extrabold">Quản lý khuyến mãi</h1></div><button type="button" onclick="openCreateModal()" class="bg-indigo-600 hover:bg-indigo-700 text-white font-bold px-4 py-2.5 rounded-xl"><i class="fas fa-plus mr-1"></i>Thêm khuyến mãi</button></div></header><main class="p-5 lg:p-8">
        @if (TempData["AdminSuccess"] != null)
        {<div class="mb-6 bg-green-50 border border-green-200 text-green-700 rounded-2xl px-5 py-4 font-semibold">@TempData["AdminSuccess"]</div>}@if (TempData["AdminError"] != null)
        {<div class="mb-6 bg-red-50 border border-red-200 text-red-700 rounded-2xl px-5 py-4 font-semibold">@TempData["AdminError"]</div>}
        <section class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-7"><div class="bg-white rounded-2xl border p-5"><p class="text-gray-500">Tổng khuyến mãi</p><p class="text-3xl font-extrabold mt-2">@ViewBag.TotalPromotions</p></div><div class="bg-white rounded-2xl border p-5"><p class="text-gray-500">Đang hiệu lực</p><p class="text-3xl font-extrabold text-green-600 mt-2">@ViewBag.ActivePromotions</p></div></section>
        <section class="bg-white rounded-2xl border p-6 mb-7"><form method="get" action="@Url.Action("Promotions","Admin")" class="flex gap-3"><input type="text" name="keyword" value="@ViewBag.Keyword" placeholder="Mã hoặc tên khuyến mãi..." class="border rounded-xl px-4 py-3 flex-1" /><button type="submit" class="bg-indigo-600 text-white font-bold px-5 py-3 rounded-xl">Tìm kiếm</button></form></section>
        <div class="grid grid-cols-1 xl:grid-cols-2 2xl:grid-cols-3 gap-6">@if (Model != null)
        {
            foreach (var item in Model)
            {
                bool activeNow = item.HoatDong && item.NgayBatDau.Date <= today && item.NgayKetThuc.Date >= today;<article class="bg-white rounded-3xl border shadow-sm p-6"><div class="flex justify-between gap-3"><div><span class="inline-block bg-indigo-100 text-indigo-700 px-3 py-1 rounded-lg font-extrabold">@item.MaCode</span><h2 class="text-2xl font-extrabold mt-3">@item.TenKhuyenMai</h2></div><span class="h-fit px-3 py-1 rounded-full text-sm font-bold @(activeNow?"bg-green-100 text-green-700":"bg-gray-200 text-gray-600")">@(activeNow?"Đang hiệu lực":"Không hiệu lực")</span></div><p class="text-gray-500 mt-4">@item.MoTa</p><div class="bg-yellow-50 rounded-2xl p-4 mt-5"><p class="text-sm text-gray-500">Mức giảm</p><p class="text-2xl font-extrabold text-yellow-700">@(item.LoaiGiamGia=="PhanTram"?item.GiaTriGiam.ToString("0.##")+"%":item.GiaTriGiam.ToString("N0")+"đ")</p><p class="text-sm text-gray-500 mt-2">Đơn tối thiểu: <strong>@item.DonToiThieu.ToString("N0")đ</strong></p>@if (item.GiamToiDa.HasValue)
                {<p class="text-sm text-gray-500">Giảm tối đa: <strong>@item.GiamToiDa.Value.ToString("N0")đ</strong></p>}</div><div class="mt-4 text-sm text-gray-500">@item.NgayBatDau.ToString("dd/MM/yyyy") → @item.NgayKetThuc.ToString("dd/MM/yyyy")</div><div class="mt-2 text-sm text-gray-500">Đã dùng: <strong>@item.SoLuotDaSuDung</strong>@if (item.SoLuotSuDungToiDa.HasValue)
                {<span> / @item.SoLuotSuDungToiDa.Value</span>}</div><div class="grid grid-cols-2 gap-3 mt-5"><button type="button" data-id="@item.MaKhuyenMai" data-code="@item.MaCode" data-name="@item.TenKhuyenMai" data-desc="@item.MoTa" data-type="@item.LoaiGiamGia" data-value="@item.GiaTriGiam" data-min="@item.DonToiThieu" data-max="@(item.GiamToiDa.HasValue?item.GiamToiDa.Value.ToString():"")" data-start="@item.NgayBatDau.ToString("yyyy-MM-dd")" data-end="@item.NgayKetThuc.ToString("yyyy-MM-dd")" data-limit="@(item.SoLuotSuDungToiDa.HasValue?item.SoLuotSuDungToiDa.Value.ToString():"")" data-active="@item.HoatDong.ToString().ToLower()" onclick="openEditModal(this)" class="bg-indigo-50 text-indigo-700 font-bold py-3 rounded-xl">Chỉnh sửa</button><form method="post" action="@Url.Action("TogglePromotion","Admin")">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@item.MaKhuyenMai" /><button type="submit" class="w-full font-bold py-3 rounded-xl @(item.HoatDong?"bg-red-50 text-red-700":"bg-green-50 text-green-700")">@(item.HoatDong?"Tắt":"Bật")</button></form></div></article>}
        }</div>
    </main>
</div>
<div id="createModal" class="modal-hidden fixed inset-0 z-[100] bg-black/60 p-4 overflow-y-auto"><div class="min-h-full flex items-center justify-center"><div class="bg-white w-full max-w-3xl rounded-3xl overflow-hidden"><div class="bg-[#111827] text-white p-5 flex justify-between"><h2 class="text-xl font-extrabold">Thêm khuyến mãi</h2><button type="button" onclick="closeCreateModal()">✕</button></div><form method="post" action="@Url.Action("SavePromotion","Admin")" class="p-6">@Html.AntiForgeryToken()<input type="hidden" name="hoatDong" value="true" /><div class="grid grid-cols-1 md:grid-cols-2 gap-4"><input type="text" name="maCode" required placeholder="Mã code" class="border rounded-xl px-4 py-3" /><input type="text" name="tenKhuyenMai" required placeholder="Tên khuyến mãi" class="border rounded-xl px-4 py-3" /><select name="loaiGiamGia" required class="border rounded-xl px-4 py-3"><option value="PhanTram">Giảm phần trăm</option><option value="SoTien">Giảm số tiền</option></select><input type="number" name="giaTriGiam" min="0.01" step="0.01" required placeholder="Giá trị giảm" class="border rounded-xl px-4 py-3" /><input type="number" name="donToiThieu" min="0" value="0" required placeholder="Đơn tối thiểu" class="border rounded-xl px-4 py-3" /><input type="number" name="giamToiDa" min="0" placeholder="Giảm tối đa" class="border rounded-xl px-4 py-3" /><input type="date" name="ngayBatDau" required class="border rounded-xl px-4 py-3" /><input type="date" name="ngayKetThuc" required class="border rounded-xl px-4 py-3" /><input type="number" name="soLuotSuDungToiDa" min="1" placeholder="Số lượt tối đa" class="border rounded-xl px-4 py-3 md:col-span-2" /><textarea name="moTa" rows="3" placeholder="Mô tả" class="border rounded-xl px-4 py-3 md:col-span-2"></textarea></div><button type="submit" class="w-full bg-indigo-600 text-white font-bold py-3 rounded-xl mt-5">Thêm khuyến mãi</button></form></div></div></div>
<div id="editModal" class="modal-hidden fixed inset-0 z-[100] bg-black/60 p-4 overflow-y-auto"><div class="min-h-full flex items-center justify-center"><div class="bg-white w-full max-w-3xl rounded-3xl overflow-hidden"><div class="bg-indigo-700 text-white p-5 flex justify-between"><h2 class="text-xl font-extrabold">Sửa khuyến mãi</h2><button type="button" onclick="closeEditModal()">✕</button></div><form method="post" action="@Url.Action("SavePromotion","Admin")" class="p-6">@Html.AntiForgeryToken()<input type="hidden" id="editId" name="id" /><input type="hidden" id="editActive" name="hoatDong" /><div class="grid grid-cols-1 md:grid-cols-2 gap-4"><input type="text" id="editCode" name="maCode" required class="border rounded-xl px-4 py-3" /><input type="text" id="editName" name="tenKhuyenMai" required class="border rounded-xl px-4 py-3" /><select id="editType" name="loaiGiamGia" required class="border rounded-xl px-4 py-3"><option value="PhanTram">Giảm phần trăm</option><option value="SoTien">Giảm số tiền</option></select><input type="number" id="editValue" name="giaTriGiam" min="0.01" step="0.01" required class="border rounded-xl px-4 py-3" /><input type="number" id="editMin" name="donToiThieu" min="0" required class="border rounded-xl px-4 py-3" /><input type="number" id="editMax" name="giamToiDa" min="0" class="border rounded-xl px-4 py-3" /><input type="date" id="editStart" name="ngayBatDau" required class="border rounded-xl px-4 py-3" /><input type="date" id="editEnd" name="ngayKetThuc" required class="border rounded-xl px-4 py-3" /><input type="number" id="editLimit" name="soLuotSuDungToiDa" min="1" class="border rounded-xl px-4 py-3 md:col-span-2" /><textarea id="editDesc" name="moTa" rows="3" class="border rounded-xl px-4 py-3 md:col-span-2"></textarea></div><button type="submit" class="w-full bg-indigo-600 text-white font-bold py-3 rounded-xl mt-5">Lưu thay đổi</button></form></div></div></div>
<script>function openCreateModal(){document.getElementById('createModal').classList.remove('modal-hidden')}function closeCreateModal(){document.getElementById('createModal').classList.add('modal-hidden')}function openEditModal(b){document.getElementById('editId').value=b.dataset.id||'';document.getElementById('editCode').value=b.dataset.code||'';document.getElementById('editName').value=b.dataset.name||'';document.getElementById('editDesc').value=b.dataset.desc||'';document.getElementById('editType').value=b.dataset.type||'PhanTram';document.getElementById('editValue').value=b.dataset.value||'';document.getElementById('editMin').value=b.dataset.min||'0';document.getElementById('editMax').value=b.dataset.max||'';document.getElementById('editStart').value=b.dataset.start||'';document.getElementById('editEnd').value=b.dataset.end||'';document.getElementById('editLimit').value=b.dataset.limit||'';document.getElementById('editActive').value=b.dataset.active||'true';document.getElementById('editModal').classList.remove('modal-hidden')}function closeEditModal(){document.getElementById('editModal').classList.add('modal-hidden')}</script>
</body>
</html>
