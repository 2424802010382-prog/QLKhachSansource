@model IEnumerable<QLKhachSan.Models.User>
@using System
@using System.Linq
@{ Layout = null; string roleFilter = Convert.ToString(ViewBag.RoleFilter); ViewBag.AdminPage = roleFilter == "Customer" ? "Customers" : roleFilter == "Staff" ? "Staff" : "Users"; }
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>Quản lý tài khoản</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <style>
        .modal-hidden {
            display: none
        }
    </style>
</head>
<body class="bg-[#f4f6fb] min-h-screen">
    @Html.Partial("~/Views/Shared/_SecurityClient.cshtml")
    @Html.Partial("_AdminSidebar")<div class="lg:ml-72 min-h-screen">
    <header class="bg-white border-b sticky top-0 z-30"><div class="px-5 lg:px-8 py-4 flex flex-col md:flex-row md:items-center md:justify-between gap-4"><div><p class="text-xs tracking-[2px] font-bold text-indigo-500">QUẢN LÝ NGƯỜI DÙNG</p><h1 class="text-3xl font-extrabold">@(roleFilter=="Customer"?"Khách hàng":roleFilter=="Staff"?"Nhân viên":"Tất cả tài khoản")</h1></div><button type="button" onclick="openStaffModal()" class="bg-indigo-600 hover:bg-indigo-700 text-white font-bold px-4 py-2.5 rounded-xl"><i class="fas fa-user-plus mr-1"></i>Tạo nhân viên</button></div></header>
    <main class="p-5 lg:p-8">
        @if (TempData["AdminSuccess"] != null)
        {<div class="mb-6 bg-green-50 border border-green-200 text-green-700 rounded-2xl px-5 py-4 font-semibold">@TempData["AdminSuccess"]</div>}@if (TempData["AdminError"] != null)
    {<div class="mb-6 bg-red-50 border border-red-200 text-red-700 rounded-2xl px-5 py-4 font-semibold">@TempData["AdminError"]</div>}
        <section class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-5 mb-7"><div class="bg-white rounded-2xl border p-5"><p class="text-gray-500">Tổng tài khoản</p><p class="text-3xl font-extrabold mt-2">@ViewBag.TotalUsers</p></div><div class="bg-white rounded-2xl border p-5"><p class="text-gray-500">Khách hàng</p><p class="text-3xl font-extrabold text-blue-600 mt-2">@ViewBag.CustomerCount</p></div><div class="bg-white rounded-2xl border p-5"><p class="text-gray-500">Nhân viên</p><p class="text-3xl font-extrabold text-indigo-600 mt-2">@ViewBag.StaffCount</p></div><div class="bg-white rounded-2xl border p-5"><p class="text-gray-500">Đang hoạt động</p><p class="text-3xl font-extrabold text-green-600 mt-2">@ViewBag.ActiveUsers</p></div></section>
        <section class="bg-white rounded-2xl border p-6 mb-7"><form method="get" action="@Url.Action("Users","Admin")" class="flex flex-col md:flex-row gap-3"><input type="text" name="keyword" value="@ViewBag.Keyword" placeholder="Tên, email hoặc username..." class="border rounded-xl px-4 py-3 flex-1" /><select name="role" class="border rounded-xl px-4 py-3"><option value="">-- Tất cả quyền --</option><option value="Customer" @(roleFilter == "Customer" ? "selected" : "")>Customer</option><option value="Staff" @(roleFilter == "Staff" ? "selected" : "")>Staff</option><option value="Admin" @(roleFilter == "Admin" ? "selected" : "")>Admin</option></select><button type="submit" class="bg-indigo-600 text-white font-bold px-5 py-3 rounded-xl">Tìm kiếm</button></form></section>
        <div class="bg-white rounded-2xl border shadow-sm overflow-hidden"><div class="overflow-x-auto"><table class="w-full min-w-[1050px]"><thead class="bg-[#111827] text-white"><tr><th class="p-4 text-left">ID</th><th class="p-4 text-left">Người dùng</th><th class="p-4 text-left">Username</th><th class="p-4 text-center">Quyền</th><th class="p-4 text-center">Trạng thái</th><th class="p-4 text-left">Ngày tạo</th><th class="p-4 text-center">Thao tác</th></tr></thead><tbody>@if (Model != null && Model.Any())
        {
            foreach (var user in Model)
            {<tr class="border-b hover:bg-gray-50"><td class="p-4 font-bold">#@user.UserId</td><td class="p-4"><p class="font-bold">@user.FullName</p><p class="text-gray-500 text-sm">@user.Email</p></td><td class="p-4">@user.Username</td><td class="p-4 text-center"><span class="px-3 py-1 rounded-full text-sm font-bold @(user.Role=="Admin"?"bg-red-100 text-red-700":user.Role=="Staff"?"bg-indigo-100 text-indigo-700":"bg-blue-100 text-blue-700")">@user.Role</span></td><td class="p-4 text-center"><span class="px-3 py-1 rounded-full text-sm font-bold @(user.IsActive?"bg-green-100 text-green-700":"bg-gray-200 text-gray-600")">@(user.IsActive?"Hoạt động":"Đã khóa")</span></td><td class="p-4">@user.CreatedAt.ToString("dd/MM/yyyy")</td><td class="p-4">@if (user.Role == "Admin")
            {<div class="text-center text-gray-400">Tài khoản Admin</div>}
            else
            {<div class="flex flex-col gap-2"><form method="post" action="@Url.Action("ChangeUserRole","Admin")" class="flex gap-2">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@user.UserId" /><select name="role" class="border rounded-lg px-3 py-2 flex-1"><option value="Customer" @(user.Role == "Customer" ? "selected" : "")>Customer</option><option value="Staff" @(user.Role == "Staff" ? "selected" : "")>Staff</option></select><button type="submit" class="bg-indigo-600 text-white px-3 py-2 rounded-lg font-bold">Lưu</button></form><form method="post" action="@Url.Action("ToggleUser","Admin")">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@user.UserId" /><button type="submit" class="w-full font-bold py-2 rounded-lg @(user.IsActive?"bg-red-50 text-red-700":"bg-green-50 text-green-700")">@(user.IsActive?"Khóa tài khoản":"Mở khóa")</button></form></div>}</td></tr>}
    }
    else
    {<tr><td colspan="7" class="p-12 text-center text-gray-400">Không có tài khoản phù hợp.</td></tr>}</tbody></table></div></div>
    </main>
</div>
<div id="staffModal" class="modal-hidden fixed inset-0 z-[100] bg-black/60 p-4"><div class="min-h-full flex items-center justify-center"><div class="bg-white w-full max-w-lg rounded-3xl overflow-hidden"><div class="bg-indigo-700 text-white p-5 flex justify-between"><h2 class="text-xl font-extrabold">Tạo tài khoản nhân viên</h2><button type="button" onclick="closeStaffModal()">✕</button></div><form method="post" action="@Url.Action("CreateStaff","Admin")" class="p-6 space-y-4">@Html.AntiForgeryToken()<input type="text" name="fullName" required placeholder="Họ tên nhân viên" class="w-full border rounded-xl px-4 py-3" /><input type="email" name="email" required placeholder="Email" class="w-full border rounded-xl px-4 py-3" /><input type="password" name="password" required minlength="6" placeholder="Mật khẩu ít nhất 6 ký tự" class="w-full border rounded-xl px-4 py-3" /><button type="submit" class="w-full bg-indigo-600 text-white font-bold py-3 rounded-xl">Tạo nhân viên</button></form></div></div></div>
<script>function openStaffModal(){document.getElementById('staffModal').classList.remove('modal-hidden')}function closeStaffModal(){document.getElementById('staffModal').classList.add('modal-hidden')}</script>
</body>
</html>
