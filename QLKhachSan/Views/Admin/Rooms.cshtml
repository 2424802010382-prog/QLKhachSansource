    <!-- JAVASCRIPT -->
    <!-- ====================================================== -->

    <script>

        function openCreateRoomModal() {

            document
                .getElementById(
                    'createRoomModal'
                )
                .classList
                .remove(
                    'modal-hidden'
                );

            document.body.style.overflow =
                'hidden';
        }


        function closeCreateRoomModal() {

            document
                .getElementById(
                    'createRoomModal'
                )
                .classList
                .add(
                    'modal-hidden'
                );

            document.body.style.overflow =
                '';
        }


        function openEditRoomModal(
            id,
            roomName,
            roomType,
            price,
            capacity,
            totalRooms,
            description,
            imageUrl,
            isActive
        ) {

            document.getElementById(
                'editRoomId'
            ).value =
                id;

            document.getElementById(
                'editRoomName'
            ).value =
                roomName;

            document.getElementById(
                'editRoomType'
            ).value =
                roomType;

            document.getElementById(
                'editRoomPrice'
            ).value =
                price;

            document.getElementById(
                'editRoomCapacity'
            ).value =
                capacity;

            document.getElementById(
                'editRoomTotal'
            ).value =
                totalRooms;

            document.getElementById(
                'editRoomDescription'
            ).value =
                description;

            document.getElementById(
                'editRoomImage'
            ).value =
                imageUrl;

            document.getElementById(
                'editRoomActive'
            ).value =
                isActive;


            document
                .getElementById(
                    'editRoomModal'
                )
                .classList
                .remove(
                    'modal-hidden'
                );


            document.body.style.overflow =
                'hidden';
        }


        function closeEditRoomModal() {

            document
                .getElementById(
                    'editRoomModal'
                )
                .classList
                .add(
                    'modal-hidden'
                );


            document.body.style.overflow =
                '';
        }


        document.addEventListener(
            'keydown',
            function (
                event
            ) {

                if (
                    event.key ===
                    'Escape'
                ) {

                    closeCreateRoomModal();

                    closeEditRoomModal();
                }
            }
        );


        document
            .getElementById(
                'createRoomModal'
            )
            .addEventListener(
                'click',
                function (
                    event
                ) {

                    if (
                        event.target ===
                        this
                    ) {

                        closeCreateRoomModal();
                    }
                }
            );




        document
            .getElementById(
                'editRoomModal'
            )
            .addEventListener(
                'click',
                function (
                    event
                ) {

                    if (
                        event.target ===
                        this
                    ) {

                        closeEditRoomModal();
                    }
                }
            );

        // =========================================================
        // MA TRẬN PHÒNG THEO LỊCH NGÀY
        // =========================================================
        let currentMatrixDateStr = '@DateTime.Today.ToString("yyyy-MM-dd")';
        let matrixWindowStartStr = '@DateTime.Today.AddDays(-3).ToString("yyyy-MM-dd")';
        let matrixRoomsCache = [];
        let fetchMatrixRequestSeq = 0;

        const dayNames = ['CN', 'T2', 'T3', 'T4', 'T5', 'T6', 'T7'];

        function formatDateToYYYYMMDD(d) {
            const yyyy = d.getFullYear();
            const mm = String(d.getMonth() + 1).padStart(2, '0');
            const dd = String(d.getDate()).padStart(2, '0');
            return `${yyyy}-${mm}-${dd}`;
        }

        function parseYYYYMMDD(s) {
            const parts = s.split('-');
            return new Date(parseInt(parts[0]), parseInt(parts[1]) - 1, parseInt(parts[2]));
        }

        function formatDateToDDMMYYYY(s) {
            const parts = s.split('-');
            if (parts.length === 3) return `${parts[2]}/${parts[1]}/${parts[0]}`;
            return s;
        }

        function renderSevenDaysBar() {
            const bar = document.getElementById('sevenDaysBar');
            if (!bar) return;

            const startDate = parseYYYYMMDD(matrixWindowStartStr);
            let html = '';

            for (let i = 0; i < 7; i++) {
                const dayObj = new Date(startDate);
                dayObj.setDate(dayObj.getDate() + i);

                const dayStr = formatDateToYYYYMMDD(dayObj);
                const dayName = dayNames[dayObj.getDay()];
                const dateDisplay = `${String(dayObj.getDate()).padStart(2, '0')}/${String(dayObj.getMonth() + 1).padStart(2, '0')}`;
                const isSelected = (dayStr === currentMatrixDateStr);

                const btnClass = isSelected
                    ? 'bg-yellow-400 text-gray-950 font-black ring-2 ring-yellow-300 shadow-md scale-105'
                    : 'bg-gray-800 text-gray-200 hover:bg-gray-700 hover:text-white font-bold';

                html += `
                    <button type="button" onclick="selectMatrixDate('${dayStr}')" class="px-3.5 py-2 rounded-xl text-xs transition flex flex-col items-center min-w-[65px] ${btnClass}">
                        <span class="text-[10px] uppercase opacity-80">${dayName}</span>
                        <span class="text-sm font-black mt-0.5">${dateDisplay}</span>
                    </button>
                `;
            }

            bar.innerHTML = html;
        }

        function selectMatrixDate(dateStr) {
            currentMatrixDateStr = dateStr;

            const selDate = parseYYYYMMDD(dateStr);
            const winStart = parseYYYYMMDD(matrixWindowStartStr);
            const winEnd = new Date(winStart);
            winEnd.setDate(winEnd.getDate() + 6);

            if (selDate < winStart || selDate > winEnd) {
                const newStart = new Date(selDate);
                newStart.setDate(newStart.getDate() - 3);
                matrixWindowStartStr = formatDateToYYYYMMDD(newStart);
            }

            const datePicker = document.getElementById('adminMatrixDatePicker');
            if (datePicker) datePicker.value = dateStr;

            const dateDisplay = document.getElementById('selectedDateDisplayText');
            if (dateDisplay) dateDisplay.innerText = 'Đang xem: ' + formatDateToDDMMYYYY(dateStr);

            renderSevenDaysBar();
            loadMatrixDataForDate(dateStr);
        }

        function navigateMatrixWindow(offset) {
            const start = parseYYYYMMDD(matrixWindowStartStr);
            start.setDate(start.getDate() + offset);
            matrixWindowStartStr = formatDateToYYYYMMDD(start);
            selectMatrixDate(matrixWindowStartStr);
        }

        function goToToday() {
            const todayStr = formatDateToYYYYMMDD(new Date());
            const start = new Date();
            start.setDate(start.getDate() - 3);
            matrixWindowStartStr = formatDateToYYYYMMDD(start);
            selectMatrixDate(todayStr);
        }

        function onDatePickerChange(val) {
            if (val) {
                selectMatrixDate(val);
            }
        }

        function showMatrixError(message) {
            const box = document.getElementById('adminMatrixError');
            if (box) {
                box.textContent = message;
                box.classList.remove('hidden');
            }
        }

        function clearMatrixError() {
            const box = document.getElementById('adminMatrixError');
            if (box) {
                box.textContent = '';
                box.classList.add('hidden');
            }
        }

        function loadMatrixDataForDate(dateStr) {
            const loading = document.getElementById('adminMatrixLoading');
            const grid = document.getElementById('adminMatrixGrid');
            const thisSeq = ++fetchMatrixRequestSeq;
            const url = '@Url.Action("GetPhysicalRoomsMatrixByDate", "Admin")' + '?date=' + encodeURIComponent(dateStr);

            clearMatrixError();
            matrixRoomsCache = []; // Không dùng dữ liệu của ngày trước cho ngày vừa chọn.
            if (loading) loading.classList.remove('hidden');
            if (grid) {
                grid.classList.add('opacity-50');
                grid.setAttribute('aria-busy', 'true');
                // Ngăn hiển thị trạng thái phòng cũ dưới ngày đang xem mới.
                grid.innerHTML = '<div class="col-span-full py-6 text-center text-sm font-semibold text-gray-500">Đang kiểm tra lịch đặt và bảo trì của ngày ' + formatDateToDDMMYYYY(dateStr) + '...</div>';
            }

            fetch(url, { credentials: 'same-origin', headers: { 'Accept': 'application/json' }, cache: 'no-store' })
                .then(async response => {
                    const body = await response.text();
                    let data;
                    try { data = JSON.parse(body); }
                    catch (e) { throw new Error('Máy chủ không trả JSON hợp lệ (HTTP ' + response.status + ').'); }
                    if (!response.ok) throw new Error('HTTP ' + response.status + ': ' + (data.message || data.Message || 'Không thể tải lịch phòng.'));
                    return data;
                })
                .then(res => {
                    if (thisSeq !== fetchMatrixRequestSeq) return;
                    const rooms = res && (res.rooms || res.Rooms);
                    const success = res && (res.success === true || res.Success === true);
                    if (!success || !Array.isArray(rooms)) {
                        throw new Error((res && (res.message || res.Message)) || 'Endpoint chưa trả đúng danh sách phòng theo ngày.');
                    }
                    if (rooms.length !== 40) {
                        // Vẫn cho hiển thị kết quả thật, nhưng báo rõ dữ liệu thiếu.
                        showMatrixError('Ngày ' + formatDateToDDMMYYYY(dateStr) + ': server chỉ trả ' + rooms.length + '/40 phòng. Cần kiểm tra GetPhysicalRoomsMatrixByDate.');
                    }
                    matrixRoomsCache = rooms;
                    renderMatrixGrid(rooms);
                })
                .catch(err => {
                    if (thisSeq !== fetchMatrixRequestSeq) return;
                    if (grid) grid.innerHTML = '<div class="col-span-full rounded-xl border border-red-200 bg-red-50 p-5 text-center text-red-800 font-bold">Chưa thể hiển thị trạng thái phòng của ngày đã chọn. Xem thông báo lỗi phía trên.</div>';
                    const msg = 'Không tải được ma trận ngày ' + formatDateToDDMMYYYY(dateStr) + ': ' + (err && err.message ? err.message : 'Lỗi không xác định') + '. Kiểm tra endpoint Admin/GetPhysicalRoomsMatrixByDate và Console/Network.';
                    showMatrixError(msg);
                    console.error('[Luxury Hotel] Matrix API failure', url, err);
                })
                .finally(() => {
                    if (thisSeq !== fetchMatrixRequestSeq) return;
                    if (loading) loading.classList.add('hidden');
                    if (grid) { grid.classList.remove('opacity-50'); grid.removeAttribute('aria-busy'); }
                });
        }

        function renderMatrixGrid(rooms) {
            const grid = document.getElementById('adminMatrixGrid');
            if (!grid) return;

            if (!rooms || rooms.length === 0) {
                grid.innerHTML = '<div class="col-span-full text-center py-8 text-gray-400">Chưa có dữ liệu phòng vật lý.</div>';
                return;
            }

            let html = '';
            for (let i = 0; i < rooms.length; i++) {
                const room = rooms[i];
                let bg = 'bg-emerald-50 border-emerald-300 text-emerald-900 hover:border-emerald-500';
                let statusText = room.status || 'Trống';

                if (room.status === 'Đang ở') {
                    bg = 'bg-rose-50 border-rose-300 text-rose-900 hover:border-rose-500';
                    statusText = 'Đang ở';
                } else if (room.status === 'Đã đặt') {
                    bg = 'bg-amber-50 border-amber-300 text-amber-900 hover:border-amber-500';
                    statusText = 'Đã đặt';
                } else if (room.status === 'Chờ xác nhận') {
                    bg = 'bg-yellow-50 border-yellow-300 text-yellow-900 hover:border-yellow-500';
                    statusText = 'Chờ xác nhận';
                } else if (room.status === 'Đã trả phòng') {
                    bg = 'bg-purple-50 border-purple-300 text-purple-800';
                    statusText = 'Đã trả phòng';
                } else if (room.status === 'Chờ gán phòng') {
                    bg = 'bg-amber-50 border-amber-400 text-amber-900';
                    statusText = 'Chờ gán phòng';
                } else if (room.status === 'Ngừng hoạt động') {
                    bg = 'bg-slate-200 border-slate-400 text-slate-700';
                    statusText = 'Ngừng hoạt động';
                } else if (room.status === 'Bảo trì') {
                    bg = 'bg-gray-100 border-gray-300 text-gray-600 hover:border-gray-500';
                    statusText = 'Bảo trì';
                }

                html += `
                    <div class="border rounded-xl p-3 text-center transition shadow-sm cursor-pointer ${bg}" onclick="openAdminRoomDetailModal(${i})">
                        <div class="font-extrabold text-base">Phòng ${hotelEscapeHtml(room.roomNumber)}</div>
                        <div class="text-[11px] opacity-75 truncate">${hotelEscapeHtml(room.roomTypeName || 'Phòng')}</div>
                        <div class="text-[10px] font-bold mt-1 uppercase tracking-wider">${statusText}</div>
                    </div>
                `;
            }
            grid.innerHTML = html;
        }

        function openAdminRoomDetailModal(roomIndex) {
            const room = matrixRoomsCache[roomIndex];
            if (!room) {
                showMatrixError('Không thể mở chi tiết phòng: dữ liệu của ngày đang xem chưa tải thành công. Không được phép lập bảo trì dựa vào trạng thái chưa xác minh.');
                console.error('[Luxury Hotel] Missing room data at index', roomIndex, 'for date', currentMatrixDateStr);
                return;
            }

            const modal = document.getElementById('adminRoomDetailModal');
            const titleEl = document.getElementById('adminModalRoomTitle');
            const dateTitleEl = document.getElementById('adminModalDateTitle');
            const bodyEl = document.getElementById('adminModalBody');

            if (titleEl) titleEl.innerText = `Phòng ${hotelEscapeHtml(room.roomNumber)} - ${hotelEscapeHtml(room.roomTypeName)}`;
            if (dateTitleEl) dateTitleEl.innerText = `Đang xem lịch ngày ${formatDateToDDMMYYYY(currentMatrixDateStr)}`;

            let html = '';
            if (room.currentBooking && room.currentBooking.isProvisionalAssignment) {
                html += '<p class="rounded-xl border border-amber-300 bg-amber-50 p-3 text-sm">Đơn cũ chưa lưu số phòng thực tế. Đây là vị trí giữ chỗ tạm để bảo toàn số lượng; nhân viên cần gán phòng khi xác nhận hoặc nhận phòng.</p>';
            }

            if (room.currentMaintenance) {
                const cm = room.currentMaintenance;
                html += `
                    <div class="bg-gray-100 border border-gray-300 rounded-2xl p-4 space-y-3">
                        <div class="flex justify-between items-center border-b border-gray-300 pb-2">
                            <span class="font-extrabold text-gray-900 text-base"><i class="fas fa-screwdriver-wrench text-amber-600 mr-1.5"></i> Đang bảo trì</span>
                            <span class="px-2.5 py-1 bg-gray-200 text-gray-800 rounded-lg text-xs font-bold">${hotelEscapeHtml(cm.status)}</span>
                        </div>
                        <div class="text-xs space-y-1.5 text-gray-700">
                            <div><strong class="text-gray-900">Lý do:</strong> ${hotelEscapeHtml(cm.reason)}</div>
                            <div><strong class="text-gray-900">Thời gian:</strong> ${hotelEscapeHtml(cm.startDate)} ➔ ${hotelEscapeHtml(cm.endDate)}</div>
                            ${cm.note ? `<div><strong class="text-gray-900">Ghi chú:</strong> ${hotelEscapeHtml(cm.note)}</div>` : ''}
                        </div>
                        <div class="pt-2">
                            <button type="button" onclick="endMaintenance(${hotelEscapeHtml(cm.maintenanceId)})" class="w-full bg-red-600 hover:bg-red-700 text-white font-bold py-2.5 rounded-xl text-xs transition">
                                Kết thúc bảo trì sớm
                            </button>
                        </div>
                    </div>
                `;
            } else if (room.currentBooking) {
                const cb = room.currentBooking;
                const statusBadge = cb.status === 'Đang ở'
                    ? '<span class="px-2.5 py-1 bg-rose-100 text-rose-800 rounded-lg text-xs font-bold">Đang ở</span>'
                    : cb.status === 'Đã xác nhận'
                    ? '<span class="px-2.5 py-1 bg-amber-100 text-amber-800 rounded-lg text-xs font-bold">Đã xác nhận</span>'
                    : '<span class="px-2.5 py-1 bg-yellow-100 text-yellow-800 rounded-lg text-xs font-bold">Chờ xác nhận</span>';

                const payBadge = cb.isPaid
                    ? '<span class="px-2.5 py-1 bg-emerald-100 text-emerald-800 rounded-lg text-xs font-bold">Đã thanh toán</span>'
                    : '<span class="px-2.5 py-1 bg-gray-100 text-gray-800 rounded-lg text-xs font-bold">Chưa thanh toán</span>';

                html += `
                    <div class="bg-amber-50 border border-amber-200 rounded-2xl p-4 space-y-3">
                        <div class="flex justify-between items-center border-b border-amber-200 pb-2">
                            <span class="font-extrabold text-amber-900 text-base">Đơn đặt phòng #${hotelEscapeHtml(cb.bookingId)}</span>
                            <div class="flex gap-1.5">${statusBadge} ${payBadge}</div>
                        </div>
                        <div class="text-xs space-y-1.5 text-gray-700">
                            <div><strong class="text-gray-900">Khách hàng:</strong> ${hotelEscapeHtml(cb.customerName)}</div>
                            <div><strong class="text-gray-900">Số điện thoại:</strong> ${cb.customerPhone || 'Chưa cung cấp'}</div>
                            <div><strong class="text-gray-900">Email:</strong> ${cb.customerEmail || 'Chưa cung cấp'}</div>
                            <div class="flex justify-between pt-1">
                                <span><strong>Nhận phòng:</strong> ${hotelEscapeHtml(cb.checkInDate)}</span>
                                <span><strong>Trả phòng:</strong> ${hotelEscapeHtml(cb.checkOutDate)}</span>
                            </div>
                            <div class="text-sm font-extrabold text-amber-800 pt-1">Tổng tiền: ${hotelEscapeHtml(cb.totalAmount)}</div>
                        </div>
                    </div>
                `;
            } else {
                html += `
                    <div class="bg-gray-50 border border-gray-200 rounded-2xl p-4 space-y-3">
                        <h4 class="font-bold text-sm text-gray-900 flex items-center gap-1.5"><i class="fas fa-screwdriver-wrench text-amber-600"></i> Đưa phòng vào bảo trì</h4>
                        <div class="space-y-2 text-xs">
                            <div>
                                <label class="block font-semibold mb-1">Ngày bắt đầu *</label>
                                <input type="date" id="maintStartDate" class="w-full border rounded-xl px-3 py-2 text-xs" value="${currentMatrixDateStr}" />
                            </div>
                            <div>
                                <label class="block font-semibold mb-1">Ngày kết thúc *</label>
                                <input type="date" id="maintEndDate" class="w-full border rounded-xl px-3 py-2 text-xs" />
                            </div>
                            <div>
                                <label class="block font-semibold mb-1">Lý do bảo trì *</label>
                                <input type="text" id="maintReason" class="w-full border rounded-xl px-3 py-2 text-xs" placeholder="VD: Sửa điều hòa, bảo dưỡng..." />
                            </div>
                            <div>
                                <label class="block font-semibold mb-1">Ghi chú</label>
                                <textarea id="maintNote" rows="2" class="w-full border rounded-xl px-3 py-2 text-xs" placeholder="Ghi chú thêm..."></textarea>
                            </div>
                            <button type="button" onclick="saveMaintenance(${hotelEscapeHtml(room.physicalRoomId)})" class="w-full bg-amber-600 hover:bg-amber-700 text-white font-bold py-2.5 rounded-xl text-xs transition">
                                Lưu lịch bảo trì
                            </button>
                        </div>
                    </div>
                `;
            }

            if (room.upcomingBookings && room.upcomingBookings.length > 0) {
                html += `
                    <div class="pt-2">
                        <h4 class="font-bold text-xs uppercase text-gray-500 tracking-wider mb-2">Các lịch đặt khác của phòng này</h4>
                        <div class="space-y-2 max-h-40 overflow-y-auto pr-1">
                `;
                room.upcomingBookings.forEach(ub => {
                    html += `
                        <div class="p-2.5 bg-gray-50 border rounded-xl flex justify-between items-center text-xs">
                            <div>
                                <span class="font-bold text-gray-900">#${hotelEscapeHtml(ub.bookingId)} - ${hotelEscapeHtml(ub.customerName)}</span>
                                <div class="text-[11px] text-gray-500">${hotelEscapeHtml(ub.checkInDate)} ➔ ${hotelEscapeHtml(ub.checkOutDate)}</div>
                            </div>
                            <span class="px-2 py-0.5 bg-blue-50 text-blue-700 rounded text-[11px] font-bold">${hotelEscapeHtml(ub.status)}</span>
                        </div>
                    `;
                });
                html += `</div></div>`;
            }

            if (room.maintenanceHistory && room.maintenanceHistory.length > 0) {
                html += `
                    <div class="pt-2">
                        <h4 class="font-bold text-xs uppercase text-gray-500 tracking-wider mb-2">Lịch sử bảo trì</h4>
                        <div class="space-y-2 max-h-40 overflow-y-auto pr-1">
                `;
                room.maintenanceHistory.forEach(mh => {
                    html += `
                        <div class="p-2.5 bg-gray-50 border rounded-xl flex justify-between items-center text-xs">
                            <div>
                                <span class="font-bold text-gray-900">${hotelEscapeHtml(mh.reason)}</span>
                                <div class="text-[11px] text-gray-500">${hotelEscapeHtml(mh.startDate)} ➔ ${hotelEscapeHtml(mh.endDate)}</div>
                            </div>
                            <span class="px-2 py-0.5 bg-gray-200 text-gray-800 rounded text-[11px] font-bold">${hotelEscapeHtml(mh.status)}</span>
                        </div>
                    `;
                });
                html += `</div></div>`;
            }

            if (bodyEl) bodyEl.innerHTML = html;
            if (modal) modal.classList.remove('modal-hidden');
            document.body.style.overflow = 'hidden';
        }

        async function saveMaintenance(physicalRoomId) {
            const startInput = document.getElementById('maintStartDate');
            const endInput = document.getElementById('maintEndDate');
            const reasonInput = document.getElementById('maintReason');
            const noteInput = document.getElementById('maintNote');
            const startDate = startInput ? startInput.value : '';
            const endDate = endInput ? endInput.value : '';
            const reason = reasonInput ? reasonInput.value.trim() : '';
            const note = noteInput ? noteInput.value.trim() : '';
            const notify = (message, title, kind) => {
                if (typeof showLuxuryAlert === 'function') {
                    showLuxuryAlert(message, title, kind);
                } else {
                    window.alert(title + ': ' + message);
                }
            };

            if (!startDate || !endDate || !reason) {
                notify('Nhập đủ ngày bắt đầu, ngày kết thúc và lý do bảo trì.', 'Thiếu thông tin', 'warning');
                return;
            }
            if (endDate <= startDate) {
                notify('Ngày kết thúc phải sau ngày bắt đầu.', 'Ngày không hợp lệ', 'warning');
                return;
            }

            const tokenField = document.querySelector('input[name="__RequestVerificationToken"]');
            if (!tokenField || !tokenField.value) {
                notify('Trang thiếu mã xác thực. Tải lại trang rồi thử lại.', 'Không thể lưu', 'error');
                return;
            }

            const button = document.querySelector('#adminRoomDetailModal button[onclick^="saveMaintenance("]');
            if (button && button.disabled) return;
            const originalText = button ? button.innerHTML : '';
            if (button) {
                button.disabled = true;
                button.innerText = 'Đang lưu...';
            }

            const formData = new FormData();
            formData.append('physicalRoomId', physicalRoomId);
            formData.append('startDate', startDate);
            formData.append('endDate', endDate);
            formData.append('reason', reason);
            formData.append('note', note);
            formData.append('__RequestVerificationToken', tokenField.value);

            try {
                const response = await fetch('@Url.Action("SaveRoomMaintenance", "Admin")', {
                    method: 'POST',
                    credentials: 'same-origin',
                    body: formData,
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                });
                const raw = await response.text();
                let result;
                try {
                    result = JSON.parse(raw);
                } catch (_) {
                    throw new Error('Máy chủ trả dữ liệu không đúng định dạng JSON (HTTP ' + response.status + '). Kiểm tra Admin/SaveRoomMaintenance và quyền Admin.');
                }
                if (!response.ok || !result || !result.success) {
                    throw new Error((result && result.message) || ('Không lưu được lịch bảo trì (HTTP ' + response.status + ').'));
                }
                notify(result.message || 'Lịch bảo trì đã được lưu.', 'Thành công', 'success');
                closeAdminRoomDetailModal();
                loadMatrixDataForDate(currentMatrixDateStr);
            } catch (error) {
                console.error('SaveRoomMaintenance failed:', error);
                notify(error.message || 'Không kết nối được máy chủ.', 'Lưu bảo trì thất bại', 'error');
            } finally {
                if (button) {
                    button.disabled = false;
                    button.innerHTML = originalText;
                }
            }
        }

        function endMaintenance(maintenanceId) {
            if (!confirm('Bạn có chắc muốn kết thúc bảo trì sớm cho phòng này?')) return;

            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
            const formData = new FormData();
            formData.append('maintenanceId', maintenanceId);
            formData.append('__RequestVerificationToken', token);

            fetch('@Url.Action("EndMaintenanceEarly", "Admin")', {
                method: 'POST',
                body: formData,
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            })
            .then(res => res.json())
            .then(res => {
                if (res && res.success) {
                    if (typeof showLuxuryAlert === 'function') showLuxuryAlert(res.message, 'Thành công', 'success');
                    closeAdminRoomDetailModal();
                    loadMatrixDataForDate(currentMatrixDateStr);
                } else {
                    if (typeof showLuxuryAlert === 'function') showLuxuryAlert(res ? res.message : 'Không thể kết thúc bảo trì.', 'Thất bại', 'warning');
                }
            })
            .catch(err => {
                if (typeof showLuxuryAlert === 'function') showLuxuryAlert('Lỗi kết nối máy chủ.', 'Lỗi', 'error');
            });
        }

        function closeAdminRoomDetailModal() {
            const modal = document.getElementById('adminRoomDetailModal');
            if (modal) modal.classList.add('modal-hidden');
            document.body.style.overflow = '';
        }

        document.addEventListener('DOMContentLoaded', function () {
            renderSevenDaysBar();
            loadMatrixDataForDate(currentMatrixDateStr);
        });

        window.selectMatrixDate = selectMatrixDate;
        window.navigateMatrixWindow = navigateMatrixWindow;
        window.goToToday = goToToday;
        window.onDatePickerChange = onDatePickerChange;
        window.openAdminRoomDetailModal = openAdminRoomDetailModal;
        window.closeAdminRoomDetailModal = closeAdminRoomDetailModal;
        window.saveMaintenance = saveMaintenance;
        window.endMaintenance = endMaintenance;

    </script>

    <!-- ====================================================== -->
    <!-- ADMIN ROOM DETAIL MODAL BY DATE -->
    <!-- ====================================================== -->
    <div id="adminRoomDetailModal" class="modal-hidden fixed inset-0 z-[100] bg-black/60 p-4 overflow-y-auto">
        <div class="min-h-full flex items-center justify-center">
            <div class="bg-white w-full max-w-lg rounded-3xl shadow-2xl overflow-hidden transform transition-all">
                <div class="bg-[#111827] text-white px-6 py-5 flex justify-between items-center border-b border-yellow-500/30">
                    <div>
                        <h2 class="text-xl font-extrabold text-yellow-400" id="adminModalRoomTitle">Phòng 101</h2>
                        <p class="text-xs text-gray-300 mt-0.5" id="adminModalDateTitle">Đang xem lịch ngày --/--/----</p>
                    </div>
                    <button type="button" onclick="closeAdminRoomDetailModal()" class="w-9 h-9 rounded-full bg-white/10 hover:bg-white/20 text-white flex items-center justify-center transition">
                        <i class="fas fa-xmark text-lg"></i>
                    </button>
                </div>

                <div class="p-6 space-y-4 text-gray-800" id="adminModalBody">
                    <!-- Dynamic details rendered via JavaScript -->
                </div>

                <div class="bg-gray-50 px-6 py-4 border-t flex justify-end">
                    <button type="button" onclick="closeAdminRoomDetailModal()" class="bg-gray-800 hover:bg-gray-900 text-white font-bold px-5 py-2.5 rounded-xl text-sm transition">
                        Đóng
                    </button>
                </div>
            </div>
        </div>
    </div>

</body>

</html>