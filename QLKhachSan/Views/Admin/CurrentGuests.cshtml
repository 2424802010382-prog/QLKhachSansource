@model IEnumerable<QLKhachSan.Models.Booking>
@using System.Linq
@{ Layout = null; ViewBag.AdminPage = "CurrentGuests"; }
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>Khách đang ở</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
</head>
<body class="bg-[#f4f6fb] min-h-screen">
    @Html.Partial("~/Views/Shared/_SecurityClient.cshtml")
    @Html.Partial("_AdminSidebar")
<div class="lg:ml-72 min-h-screen">
    <header class="bg-white border-b sticky top-0 z-30"><div class="px-5 lg:px-8 py-4"><p class="text-xs tracking-[2px] font-bold text-indigo-500">QUẢN LÝ KHÁCH SẠN</p><h1 class="text-3xl font-extrabold">Khách đang lưu trú</h1><p class="text-gray-500 text-sm mt-1">Theo dõi thanh toán và trả phòng.</p></div></header>
    <main class="p-5 lg:p-8">
        @if (TempData["AdminSuccess"] != null)
        {<div class="mb-6 bg-green-50 border border-green-200 text-green-700 rounded-2xl px-5 py-4 font-semibold">@TempData["AdminSuccess"]</div>}
        @if (TempData["AdminError"] != null)
        {<div class="mb-6 bg-red-50 border border-red-200 text-red-700 rounded-2xl px-5 py-4 font-semibold">@TempData["AdminError"]</div>}
        <section class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-7"><div class="bg-white rounded-2xl border shadow-sm p-6"><p class="text-gray-500">Khách đang ở</p><p class="text-4xl font-extrabold text-indigo-600 mt-2">@ViewBag.CurrentGuestCount</p></div><div class="bg-white rounded-2xl border shadow-sm p-6"><p class="text-gray-500">Chưa thanh toán</p><p class="text-4xl font-extrabold text-orange-600 mt-2">@ViewBag.UnpaidGuests</p></div></section>
        @if (Model == null || !Model.Any())
        {<div class="bg-white rounded-3xl border shadow-sm p-14 text-center"><i class="fas fa-person-shelter text-6xl text-gray-300"></i><h2 class="text-xl font-extrabold mt-5">Hiện không có khách đang lưu trú</h2></div>}
        else
        {<div class="grid grid-cols-1 xl:grid-cols-2 gap-6">@foreach (var booking in Model)
            {
                bool paid = (QLKhachSan.Models.HotelOperations.PaymentStatus(booking) == "Đã thanh toán");<article class="bg-white rounded-3xl border shadow-sm overflow-hidden"><div class="bg-[#111827] text-white px-6 py-5 flex justify-between gap-4"><div><p class="text-blue-200 text-sm">Booking #@booking.BookingId</p><h2 class="text-2xl font-extrabold">@booking.CustomerName</h2></div><span class="bg-blue-500 px-3 py-1.5 rounded-full h-fit text-sm font-bold">Đang ở</span></div><div class="p-6"><div class="grid grid-cols-2 gap-4"><div class="bg-gray-50 rounded-xl p-4"><p class="text-xs text-gray-400">Phòng</p><p class="font-extrabold mt-1">@(booking.Room!=null?booking.Room.RoomName:"Không xác định")</p></div><div class="bg-gray-50 rounded-xl p-4"><p class="text-xs text-gray-400">Số phòng</p><p class="font-extrabold mt-1">@booking.RoomCount</p></div><div class="bg-gray-50 rounded-xl p-4"><p class="text-xs text-gray-400">Ngày nhận</p><p class="font-extrabold mt-1">@booking.CheckInDate.ToString("dd/MM/yyyy")</p></div><div class="bg-gray-50 rounded-xl p-4"><p class="text-xs text-gray-400">Ngày trả</p><p class="font-extrabold mt-1">@booking.CheckOutDate.ToString("dd/MM/yyyy")</p></div></div><div class="mt-5"><p class="font-bold">@booking.CustomerPhone</p><p class="text-gray-500">@booking.CustomerEmail</p></div><div class="mt-5 flex items-center justify-between gap-3"><div><p class="text-sm text-gray-400">Tổng tiền</p><p class="text-2xl font-extrabold text-yellow-700">@booking.TotalAmount.ToString("N0")đ</p></div><span class="px-4 py-2 rounded-xl font-bold @(paid?"bg-green-100 text-green-700":"bg-orange-100 text-orange-700")">@(paid?"Đã thanh toán":"Chưa thanh toán")</span></div><div class="mt-6"><a href="@Url.Action("BookingDetails","Admin", new { id = booking.BookingId })" class="w-full block bg-blue-50 hover:bg-blue-100 text-blue-600 font-bold py-3 rounded-xl text-center">Xem chi tiết đơn (Chỉ đọc)</a></div></div></article>}</div>}
    </main>
</div>
</body>
</html>
