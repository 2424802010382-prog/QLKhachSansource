@model IEnumerable<QLKhachSan.Models.Booking>

@using System
@using System.Linq

@{
    Layout = null;

    ViewBag.Title =
        "Dashboard quản trị";

    ViewBag.AdminPage =
        "Dashboard";


    decimal todayRevenue =
        ViewBag.TodayRevenue != null
        ? Convert.ToDecimal(
            ViewBag.TodayRevenue
        )
        : 0;


    decimal monthRevenue =
        ViewBag.MonthRevenue != null
        ? Convert.ToDecimal(
            ViewBag.MonthRevenue
        )
        : 0;


    decimal todayRoomRevenue =
        ViewBag.TodayRoomRevenue != null
        ? Convert.ToDecimal(
            ViewBag.TodayRoomRevenue
        )
        : 0;


    decimal todayFoodRevenue =
        ViewBag.TodayFoodRevenue != null
        ? Convert.ToDecimal(
            ViewBag.TodayFoodRevenue
        )
        : 0;
}

<!DOCTYPE html>

<html lang="vi">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width,
                   initial-scale=1.0" />

    <title>
        Dashboard quản trị - Luxury Hotel
    </title>


    <script src="https://cdn.tailwindcss.com"></script>

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>


    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />


    <style>

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        }

        ::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }

        ::-webkit-scrollbar-track {
            background: #f3f4f6;
        }

        ::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 999px;
        }

            ::-webkit-scrollbar-thumb:hover {
                background: #94a3b8;
            }
    </style>

</head>


<body class="bg-[#f4f6fb]
             text-gray-900
             min-h-screen">
    @Html.Partial("~/Views/Shared/_SecurityClient.cshtml")
    <a href="@Url.Action("Orders", "RoomService")" class="block lg:hidden p-4 bg-[#153044] text-yellow-200">Quản lý dịch vụ phòng</a>


    <!-- ====================================================== -->
    <!-- SIDEBAR -->
    <!-- ====================================================== -->

    @Html.Partial(
        "_AdminSidebar"
    )

    <!-- ====================================================== -->
    <!-- MOBILE ADMIN SIDEBAR DRAWER -->
    <!-- ====================================================== -->
    <div id="adminMobileSidebar" class="hidden fixed inset-0 z-50 bg-black/60 lg:hidden" onclick="toggleAdminMobileSidebar()">
        <div class="w-72 h-full bg-gradient-to-b from-[#111827] via-[#172554] to-[#312e81] text-white overflow-y-auto p-5 flex flex-col shadow-2xl" onclick="event.stopPropagation()">
            <div class="flex justify-between items-center pb-4 mb-4 border-b border-white/10">
                <div class="font-bold text-lg text-yellow-400 flex items-center gap-2"><i class="fas fa-hotel"></i> LUXURY ADMIN</div>
                <button type="button" onclick="toggleAdminMobileSidebar()" class="text-white text-xl p-1 hover:text-yellow-400 transition"><i class="fas fa-times"></i></button>
            </div>
            <p class="px-3 mb-2 text-xs font-extrabold tracking-[2px] text-blue-300">TỔNG QUAN</p>
            <a href="@Url.Action("Index", "Admin")" class="py-2.5 px-3 rounded-xl hover:bg-white/10 text-sm font-semibold flex items-center gap-3 mb-1"><i class="fas fa-chart-line text-blue-400"></i> Dashboard</a>
            <a href="@Url.Action("Rooms", "Admin")" class="py-2.5 px-3 rounded-xl hover:bg-white/10 text-sm font-semibold flex items-center gap-3 mb-1"><i class="fas fa-bed text-yellow-400"></i> Quản lý phòng</a>
            <a href="@Url.Action("Bookings", "Admin")" class="py-2.5 px-3 rounded-xl hover:bg-white/10 text-sm font-semibold flex items-center gap-3 mb-1"><i class="fas fa-calendar-check text-green-400"></i> Đơn đặt phòng</a>
            <a href="@Url.Action("CurrentGuests", "Admin")" class="py-2.5 px-3 rounded-xl hover:bg-white/10 text-sm font-semibold flex items-center gap-3 mb-1"><i class="fas fa-users text-purple-400"></i> Khách đang ở</a>
            <p class="px-3 mt-4 mb-2 text-xs font-extrabold tracking-[2px] text-blue-300">QUẢN LÝ</p>
            <a href="@Url.Action("Users", "Admin")" class="py-2.5 px-3 rounded-xl hover:bg-white/10 text-sm font-semibold flex items-center gap-3 mb-1"><i class="fas fa-user-gear text-indigo-400"></i> Tài khoản</a>
            <a href="@Url.Action("StaffPermissions", "Admin")" class="py-2.5 px-3 rounded-xl hover:bg-white/10 text-sm font-semibold flex items-center gap-3 mb-1"><i class="fas fa-shield-halved text-rose-400"></i> Phân quyền nhân viên</a>
            <a href="@Url.Action("Services", "Admin")" class="py-2.5 px-3 rounded-xl hover:bg-white/10 text-sm font-semibold flex items-center gap-3 mb-1"><i class="fas fa-concierge-bell text-amber-400"></i> Dịch vụ</a>
            <a href="@Url.Action("Revenue", "Admin")" class="py-2.5 px-3 rounded-xl hover:bg-white/10 text-sm font-semibold flex items-center gap-3 mb-1"><i class="fas fa-coins text-emerald-400"></i> Doanh thu</a>
            <a href="@Url.Action("ManageFoods", "Restaurant")" class="py-2.5 px-3 rounded-xl hover:bg-white/10 text-sm font-semibold flex items-center gap-3 mb-1"><i class="fas fa-utensils text-orange-400"></i> Quản lý thực đơn</a>
        </div>
    </div>


    <!-- ====================================================== -->
    <!-- MAIN -->
    <!-- ====================================================== -->

    <div class="lg:ml-72 min-h-screen">

        <!-- ================================================== -->
        <!-- TOP BAR -->
        <!-- ================================================== -->

        <header class="bg-white border-b sticky top-0 z-30">
            <div class="px-4 lg:px-8 py-4 flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
                <div class="flex items-center justify-between w-full md:w-auto">
                    <div class="flex items-center gap-2">
                        <button type="button" onclick="toggleAdminMobileSidebar()" class="lg:hidden text-gray-700 hover:text-gray-900 text-2xl p-1.5 focus:outline-none mr-1">
                            <i class="fas fa-bars"></i>
                        </button>
                        <div>
                            <p class="text-xs tracking-[2px] font-bold text-indigo-500">LUXURY HOTEL</p>
                            <h1 class="text-xl sm:text-2xl lg:text-3xl font-extrabold">Dashboard quản trị</h1>
                            <p class="text-gray-500 text-xs sm:text-sm mt-0.5">Theo dõi và quản lý toàn bộ hoạt động khách sạn.</p>
                        </div>
                    </div>
                </div>

                <div class="flex flex-wrap items-center gap-2 sm:gap-3 w-full md:w-auto">
                    <form action="@Url.Action("ClearAllBookings", "Admin")" method="post" onsubmit="return confirm('Hủy các đơn chưa thanh toán và chưa nhận phòng? Lịch sử, đơn đã thu tiền và khách đang ở được giữ nguyên.');" class="w-full sm:w-auto">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="w-full sm:w-auto bg-amber-600 hover:bg-amber-700 text-white font-bold px-3 sm:px-4 py-2 text-xs sm:text-sm rounded-xl transition">
                            <i class="fas fa-trash-can mr-1"></i> Giải phóng đơn chưa thanh toán
                        </button>
                    </form>

                    <a href="@Url.Action("Index", "Home")" class="flex-1 sm:flex-none text-center bg-yellow-400 hover:bg-yellow-500 text-gray-900 font-bold px-3 sm:px-4 py-2 text-xs sm:text-sm rounded-xl transition">
                        <i class="fas fa-house mr-1"></i> Trang chủ
                    </a>

                    <a href="#" onclick="openLuxuryLogoutModal(event); return false;" class="flex-1 sm:flex-none text-center bg-red-500 hover:bg-red-600 text-white font-bold px-3 sm:px-4 py-2 text-xs sm:text-sm rounded-xl transition">
                        <i class="fas fa-right-from-bracket mr-1"></i> Đăng xuất
                    </a>
                </div>
            </div>
        </header>



        <!-- ================================================== -->
        <!-- CONTENT -->
        <!-- ================================================== -->

        <main class="p-5
                     lg:p-8">


            <!-- ============================================== -->
            <!-- THÔNG BÁO -->
            <!-- ============================================== -->

            @if (
                TempData["AdminSuccess"] != null
            )
            {
                <div class="mb-6
                            bg-green-50
                            border
                            border-green-200
                            text-green-700
                            rounded-2xl
                            px-5
                            py-4
                            font-semibold">

                    <i class="fas
                              fa-circle-check
                              mr-2">
                    </i>

                    @TempData["AdminSuccess"]

                </div>
            }


            @if (
                TempData["AdminError"] != null
            )
            {
                <div class="mb-6
                            bg-red-50
                            border
                            border-red-200
                            text-red-700
                            rounded-2xl
                            px-5
                            py-4
                            font-semibold">

                    <i class="fas
                              fa-circle-exclamation
                              mr-2">
                    </i>

                    @TempData["AdminError"]

                </div>
            }



            <!-- ============================================== -->
            <!-- WELCOME -->
            <!-- ============================================== -->

            <section class="mb-7">

                <div class="bg-gradient-to-r
                            from-[#111827]
                            via-[#172554]
                            to-[#312e81]
                            rounded-3xl
                            p-7
                            text-white
                            shadow-lg">

                    <div class="flex
                                flex-col
                                lg:flex-row
                                lg:items-center
                                lg:justify-between
                                gap-5">

                        <div>

                            <p class="text-blue-200
                                      text-sm">

                                Xin chào,

                            </p>

                            <h2 class="text-3xl
                                       font-extrabold
                                       mt-1">

                                @(Session["FullName"] != null
                                    ? Session["FullName"].ToString()
                                    : "Quản trị viên")

                            </h2>

                            <p class="text-blue-100
                                      mt-2">

                                Đây là tổng quan hoạt động của Luxury Hotel.

                            </p>

                        </div>


                        <div class="flex
                                    items-center
                                    gap-3
                                    flex-wrap">

                            <a href="@Url.Action(
                                        "Rooms",
                                        "Admin"
                                    )"
                               class="bg-white/10
                                      hover:bg-white/20
                                      border
                                      border-white/20
                                      px-4
                                      py-3
                                      rounded-xl
                                      font-bold">

                                <i class="fas
                                          fa-bed
                                          mr-1">
                                </i>

                                Quản lý phòng

                            </a>


                            <a href="@Url.Action(
                                        "CurrentGuests",
                                        "Admin"
                                    )"
                               class="bg-yellow-400
                                      hover:bg-yellow-500
                                      text-gray-900
                                      px-4
                                      py-3
                                      rounded-xl
                                      font-bold">

                                <i class="fas
                                          fa-person-shelter
                                          mr-1">
                                </i>

                                Khách đang ở

                            </a>

                        </div>

                    </div>

                </div>

            </section>



            <!-- ============================================== -->
            <!-- THỐNG KÊ -->
            <!-- ============================================== -->

            <section class="grid
                            grid-cols-1
                            md:grid-cols-2
                            xl:grid-cols-3
                            2xl:grid-cols-6
                            gap-5
                            mb-8">


                <!-- TỔNG BOOKING -->

                <div class="bg-white
                            rounded-2xl
                            border
                            shadow-sm
                            p-5">

                    <div class="flex
                                justify-between
                                items-start">

                        <div>

                            <p class="text-gray-500
                                      text-sm">

                                Tổng đơn phòng

                            </p>

                            <p class="text-3xl
                                      font-extrabold
                                      mt-2">

                                @ViewBag.TotalBookings

                            </p>

                        </div>

                        <div class="w-12
                                    h-12
                                    bg-blue-100
                                    text-blue-600
                                    rounded-2xl
                                    flex
                                    items-center
                                    justify-center">

                            <i class="fas
                                      fa-calendar-check">
                            </i>

                        </div>

                    </div>

                </div>


                <!-- CHỜ XÁC NHẬN -->

                <div class="bg-white
                            rounded-2xl
                            border
                            shadow-sm
                            p-5">

                    <div class="flex
                                justify-between
                                items-start">

                        <div>

                            <p class="text-gray-500
                                      text-sm">

                                Chờ xác nhận

                            </p>

                            <p class="text-3xl
                                      font-extrabold
                                      text-yellow-600
                                      mt-2">

                                @ViewBag.PendingBookings

                            </p>

                        </div>

                        <div class="w-12
                                    h-12
                                    bg-yellow-100
                                    text-yellow-600
                                    rounded-2xl
                                    flex
                                    items-center
                                    justify-center">

                            <i class="fas fa-clock"></i>

                        </div>

                    </div>

                </div>


                <!-- KHÁCH ĐANG Ở -->

                <a href="@Url.Action(
                            "CurrentGuests",
                            "Admin"
                         )"
                   class="bg-white
                          rounded-2xl
                          border
                          shadow-sm
                          p-5
                          hover:shadow-md
                          transition">

                    <div class="flex
                                justify-between
                                items-start">

                        <div>

                            <p class="text-gray-500
                                      text-sm">

                                Khách đang ở

                            </p>

                            <p class="text-3xl
                                      font-extrabold
                                      text-indigo-600
                                      mt-2">

                                @ViewBag.CurrentGuests

                            </p>

                        </div>

                        <div class="w-12
                                    h-12
                                    bg-indigo-100
                                    text-indigo-600
                                    rounded-2xl
                                    flex
                                    items-center
                                    justify-center">

                            <i class="fas
                                      fa-person-shelter">
                            </i>

                        </div>

                    </div>

                </a>


                <!-- ĐƠN MÓN -->

                <a href="@Url.Action(
                            "AdminOrders",
                            "Restaurant"
                         )"
                   class="bg-white
                          rounded-2xl
                          border
                          shadow-sm
                          p-5
                          hover:shadow-md
                          transition">

                    <div class="flex
                                justify-between
                                items-start">

                        <div>

                            <p class="text-gray-500
                                      text-sm">

                                Đơn món đang xử lý

                            </p>

                            <p class="text-3xl
                                      font-extrabold
                                      text-orange-600
                                      mt-2">

                                @ViewBag.PendingFoodOrders

                            </p>

                        </div>

                        <div class="w-12
                                    h-12
                                    bg-orange-100
                                    text-orange-600
                                    rounded-2xl
                                    flex
                                    items-center
                                    justify-center">

                            <i class="fas
                                      fa-utensils">
                            </i>

                        </div>

                    </div>

                </a>


                <!-- DOANH THU HÔM NAY -->

                <div class="bg-white
                            rounded-2xl
                            border
                            shadow-sm
                            p-5">

                    <div class="flex
                                justify-between
                                items-start">

                        <div>

                            <p class="text-gray-500
                                      text-sm">

                                Doanh thu hôm nay

                            </p>

                            <p class="text-xl
                                      font-extrabold
                                      text-green-600
                                      mt-2
                                      whitespace-nowrap">

                                @todayRevenue.ToString("N0")đ

                            </p>

                        </div>

                        <div class="w-12
                                    h-12
                                    bg-green-100
                                    text-green-600
                                    rounded-2xl
                                    flex
                                    items-center
                                    justify-center">

                            <i class="fas
                                      fa-money-bill-wave">
                            </i>

                        </div>

                    </div>

                </div>


                <!-- DOANH THU THÁNG -->

                <a href="@Url.Action(
                            "Revenue",
                            "Admin"
                         )"
                   class="bg-white
                          rounded-2xl
                          border
                          shadow-sm
                          p-5
                          hover:shadow-md
                          transition">

                    <div class="flex
                                justify-between
                                items-start">

                        <div>

                            <p class="text-gray-500
                                      text-sm">

                                Doanh thu tháng

                            </p>

                            <p class="text-xl
                                      font-extrabold
                                      text-purple-600
                                      mt-2
                                      whitespace-nowrap">

                                @monthRevenue.ToString("N0")đ

                            </p>

                        </div>

                        <div class="w-12
                                    h-12
                                    bg-purple-100
                                    text-purple-600
                                    rounded-2xl
                                    flex
                                    items-center
                                    justify-center">

                            <i class="fas
                                      fa-chart-line">
                            </i>

                        </div>

                    </div>

                </a>

            </section>



            <!-- ============================================== -->
            <!-- DOANH THU HÔM NAY CHI TIẾT -->
            <!-- ============================================== -->

            <section class="grid
                            grid-cols-1
                            lg:grid-cols-3
                            gap-5
                            mb-8">

                <div class="lg:col-span-2
                            bg-white
                            rounded-2xl
                            border
                            shadow-sm
                            p-6">

                    <div class="flex
                                items-center
                                justify-between
                                mb-6">

                        <div>

                            <h2 class="text-xl
                                       font-extrabold">

                                Doanh thu 7 ngày gần nhất

                            </h2>

                            <p class="text-sm
                                      text-gray-500
                                      mt-1">

                                Bao gồm doanh thu phòng và nhà hàng đã thanh toán.

                            </p>

                        </div>

                        <a href="@Url.Action(
                                    "Revenue",
                                    "Admin"
                                 )"
                           class="text-indigo-600
                                  font-bold
                                  hover:text-indigo-800">

                            Xem chi tiết →

                        </a>

                    </div>


                    <div style="height:330px;">

                        <canvas id="revenueChart">
                        </canvas>

                    </div>

                </div>


                <div class="bg-white
                            rounded-2xl
                            border
                            shadow-sm
                            p-6">

                    <h2 class="text-xl
                               font-extrabold
                               mb-5">

                        Doanh thu hôm nay

                    </h2>


                    <div class="space-y-4">

                        <div class="bg-blue-50
                                    border
                                    border-blue-100
                                    rounded-2xl
                                    p-4">

                            <div class="flex
                                        justify-between
                                        items-center">

                                <div>

                                    <p class="text-sm
                                              text-gray-500">

                                        Phòng

                                    </p>

                                    <p class="text-xl
                                              font-extrabold
                                              text-blue-700
                                              mt-1">

                                        @todayRoomRevenue.ToString("N0")đ

                                    </p>

                                </div>

                                <i class="fas
                                          fa-bed
                                          text-blue-500
                                          text-2xl">
                                </i>

                            </div>

                        </div>


                        <div class="bg-orange-50
                                    border
                                    border-orange-100
                                    rounded-2xl
                                    p-4">

                            <div class="flex
                                        justify-between
                                        items-center">

                                <div>

                                    <p class="text-sm
                                              text-gray-500">

                                        Nhà hàng

                                    </p>

                                    <p class="text-xl
                                              font-extrabold
                                              text-orange-700
                                              mt-1">

                                        @todayFoodRevenue.ToString("N0")đ

                                    </p>

                                </div>

                                <i class="fas
                                          fa-utensils
                                          text-orange-500
                                          text-2xl">
                                </i>

                            </div>

                        </div>


                        <div class="bg-green-50
                                    border
                                    border-green-100
                                    rounded-2xl
                                    p-4">

                            <p class="text-sm
                                      text-gray-500">

                                Tổng cộng

                            </p>

                            <p class="text-2xl
                                      font-extrabold
                                      text-green-700
                                      mt-1">

                                @todayRevenue.ToString("N0")đ

                            </p>

                        </div>

                    </div>

                </div>

            </section>



            <!-- ============================================== -->
            <!-- QUẢN LÝ BOOKING -->
            <!-- ============================================== -->

            <section id="bookings"
                     class="scroll-mt-28">


                <!-- FILTER -->

                <div class="bg-white
                            rounded-2xl
                            border
                            shadow-sm
                            p-6
                            mb-6">

                    <div class="flex
                                flex-col
                                lg:flex-row
                                lg:items-center
                                lg:justify-between
                                gap-4
                                mb-5">

                        <div>

                            <h2 class="text-2xl
                                       font-extrabold">

                                Quản lý đặt phòng

                            </h2>

                            <p class="text-gray-500
                                      text-sm
                                      mt-1">

                                Tìm kiếm, xác nhận, thanh toán,
                                nhận phòng và trả phòng.

                            </p>

                        </div>


                        <span class="bg-indigo-50
                                     text-indigo-700
                                     px-4
                                     py-2
                                     rounded-xl
                                     font-bold">

                            @ViewBag.TotalBookings đơn

                        </span>

                    </div>


                    <form method="get"
                          action="@Url.Action(
                                      "Index",
                                      "Admin"
                                  )">


                        <div class="grid
                                    grid-cols-1
                                    md:grid-cols-2
                                    xl:grid-cols-4
                                    gap-4">


                            <div>

                                <label class="block
                                              font-bold
                                              text-sm
                                              mb-2">

                                    Khách hàng

                                </label>

                                <input type="text"
                                       name="keyword"
                                       value="@ViewBag.Keyword"
                                       placeholder="Tên, SĐT hoặc email..."
                                       class="w-full
                                              border
                                              rounded-xl
                                              px-4
                                              py-3
                                              outline-none
                                              focus:ring-2
                                              focus:ring-indigo-200" />

                            </div>


                            <div>

                                <label class="block
                                              font-bold
                                              text-sm
                                              mb-2">

                                    Trạng thái

                                </label>

                                <select name="status"
                                        class="w-full
                                               border
                                               rounded-xl
                                               px-4
                                               py-3">

                                    <option value="">
                                        -- Tất cả --
                                    </option>

                                    <option value="Chờ xác nhận"
                                            @(ViewBag.Status == "Chờ xác nhận" ? "selected" : "")>

                                        Chờ xác nhận

                                    </option>

                                    <option value="Đã xác nhận"
                                            @(ViewBag.Status == "Đã xác nhận" ? "selected" : "")>

                                        Đã xác nhận

                                    </option>

                                    <option value="Đang ở"
                                            @(ViewBag.Status == "Đang ở" ? "selected" : "")>

                                        Đang ở

                                    </option>

                                    <option value="Đã trả phòng"
                                            @(ViewBag.Status == "Đã trả phòng" ? "selected" : "")>

                                        Đã trả phòng

                                    </option>

                                    <option value="Đã hủy"
                                            @(ViewBag.Status == "Đã hủy" ? "selected" : "")>

                                        Đã hủy

                                    </option>

                                </select>

                            </div>


                            <div>

                                <label class="block
                                              font-bold
                                              text-sm
                                              mb-2">

                                    Từ ngày

                                </label>

                                <input type="date"
                                       name="fromDate"
                                       value="@ViewBag.FromDate"
                                       class="w-full
                                              border
                                              rounded-xl
                                              px-4
                                              py-3" />

                            </div>


                            <div>

                                <label class="block
                                              font-bold
                                              text-sm
                                              mb-2">

                                    Đến ngày

                                </label>

                                <input type="date"
                                       name="toDate"
                                       value="@ViewBag.ToDate"
                                       class="w-full
                                              border
                                              rounded-xl
                                              px-4
                                              py-3" />

                            </div>

                        </div>


                        <div class="flex
                                    gap-3
                                    mt-5
                                    flex-wrap">

                            <button type="submit"
                                    class="bg-indigo-600
                                           hover:bg-indigo-700
                                           text-white
                                           font-bold
                                           px-5
                                           py-3
                                           rounded-xl">

                                <i class="fas
                                          fa-search
                                          mr-1">
                                </i>

                                Tìm kiếm

                            </button>


                            <a href="@Url.Action(
                                        "Index",
                                        "Admin"
                                     )#bookings"
                               class="bg-gray-200
                                      hover:bg-gray-300
                                      text-gray-700
                                      font-bold
                                      px-5
                                      py-3
                                      rounded-xl">

                                Xóa bộ lọc

                            </a>

                        </div>

                    </form>

                </div>



                <!-- TABLE -->

                <div class="bg-white
                            rounded-2xl
                            border
                            shadow-sm
                            overflow-hidden">

                    <div class="overflow-x-auto">

                        <table class="w-full
                                      min-w-[1450px]">

                            <thead class="bg-[#111827]
                                          text-white">

                                <tr>

                                    <th class="p-4 text-left">
                                        Mã
                                    </th>

                                    <th class="p-4 text-left">
                                        Khách hàng
                                    </th>

                                    <th class="p-4 text-left">
                                        Phòng
                                    </th>

                                    <th class="p-4 text-left">
                                        Nhận / trả
                                    </th>

                                    <th class="p-4 text-right">
                                        Tổng tiền
                                    </th>

                                    <th class="p-4 text-center">
                                        Đặt phòng
                                    </th>

                                    <th class="p-4 text-center">
                                        Thanh toán
                                    </th>

                                    <th class="p-4 text-center">
                                        Thao tác
                                    </th>

                                </tr>

                            </thead>


                            <tbody>

                                @if (
                                    Model != null
                                    &&
                                    Model.Any()
                                )
                                {
                                    foreach (
                                        var booking
                                        in Model
                                    )
                                    {
                                        var payment =
                                            booking.ThanhToans != null
                                            ? booking.ThanhToans
                                                .OrderByDescending(
                                                    x => x.NgayThanhToan
                                                )
                                                .FirstOrDefault()
                                            : null;


                                        string paymentStatus = QLKhachSan.Models.HotelOperations.PaymentStatus(booking);


                                        bool paid =
                                            paymentStatus ==
                                            "Đã thanh toán";


                                        <tr class="border-b
                                                   hover:bg-gray-50">


                                            <td class="p-4
                                                       font-extrabold">

                                                #@booking.BookingId

                                            </td>


                                            <td class="p-4">

                                                <p class="font-bold">
                                                    @booking.CustomerName
                                                </p>

                                                <p class="text-sm
                                                          text-gray-500">
                                                    @booking.CustomerPhone
                                                </p>

                                                <p class="text-sm
                                                          text-gray-400">
                                                    @booking.CustomerEmail
                                                </p>

                                            </td>


                                            <td class="p-4">

                                                @if (
                                                    booking.Room != null
                                                )
                                                {
                                                    <p class="font-bold">

                                                        @booking.Room.RoomName

                                                    </p>

                                                    <p class="text-sm
                                                              text-gray-500">

                                                        @booking.RoomCount phòng

                                                    </p>
                                                }

                                            </td>


                                            <td class="p-4">

                                                <p>

                                                    <i class="fas
                                                              fa-arrow-right-to-bracket
                                                              text-green-500
                                                              mr-1">
                                                    </i>

                                                    @booking.CheckInDate.ToString(
                                                        "dd/MM/yyyy"
                                                    )

                                                </p>

                                                <p class="mt-1">

                                                    <i class="fas
                                                              fa-arrow-right-from-bracket
                                                              text-red-500
                                                              mr-1">
                                                    </i>

                                                    @booking.CheckOutDate.ToString(
                                                        "dd/MM/yyyy"
                                                    )

                                                </p>

                                            </td>


                                            <td class="p-4
                                                       text-right
                                                       font-extrabold
                                                       text-yellow-700">

                                                @booking.TotalAmount.ToString(
                                                    "N0"
                                                )đ

                                            </td>


                                            <!-- BOOKING STATUS -->

                                            <td class="p-4
                                                       text-center">

                                                @if (
                                                    booking.Status ==
                                                    "Chờ xác nhận"
                                                )
                                                {
                                                    <span class="bg-yellow-100
                                                                 text-yellow-700
                                                                 px-3
                                                                 py-1
                                                                 rounded-full
                                                                 font-bold
                                                                 text-sm
                                                                 whitespace-nowrap">

                                                        Chờ xác nhận

                                                    </span>
                                                }
                                                else if (
                                                    booking.Status ==
                                                    "Đã xác nhận"
                                                )
                                                {
                                                    <span class="bg-green-100
                                                                 text-green-700
                                                                 px-3
                                                                 py-1
                                                                 rounded-full
                                                                 font-bold
                                                                 text-sm
                                                                 whitespace-nowrap">

                                                        Đã xác nhận

                                                    </span>
                                                }
                                                else if (
                                                    booking.Status ==
                                                    "Đang ở"
                                                )
                                                {
                                                    <span class="bg-blue-100
                                                                 text-blue-700
                                                                 px-3
                                                                 py-1
                                                                 rounded-full
                                                                 font-bold
                                                                 text-sm
                                                                 whitespace-nowrap">

                                                        Đang ở

                                                    </span>
                                                }
                                                else if (
                                                    booking.Status ==
                                                    "Đã trả phòng"
                                                )
                                                {
                                                    <span class="bg-purple-100
                                                                 text-purple-700
                                                                 px-3
                                                                 py-1
                                                                 rounded-full
                                                                 font-bold
                                                                 text-sm
                                                                 whitespace-nowrap">

                                                        Đã trả phòng

                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="bg-red-100
                                                                 text-red-700
                                                                 px-3
                                                                 py-1
                                                                 rounded-full
                                                                 font-bold
                                                                 text-sm
                                                                 whitespace-nowrap">

                                                        @booking.Status

                                                    </span>
                                                }

                                            </td>


                                            <!-- PAYMENT -->

                                            <td class="p-4
                                                       text-center">

                                                @if (paid)
                                                {
                                                    <span class="bg-green-100
                                                                 text-green-700
                                                                 px-3
                                                                 py-1
                                                                 rounded-full
                                                                 font-bold
                                                                 text-sm
                                                                 whitespace-nowrap">

                                                        Đã thanh toán

                                                    </span>
                                                }
                                                else if (
                                                    paymentStatus ==
                                                    "Đã hủy"
                                                )
                                                {
                                                    <span class="bg-red-100
                                                                 text-red-700
                                                                 px-3
                                                                 py-1
                                                                 rounded-full
                                                                 font-bold
                                                                 text-sm
                                                                 whitespace-nowrap">

                                                        Đã hủy

                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="bg-orange-100
                                                                 text-orange-700
                                                                 px-3
                                                                 py-1
                                                                 rounded-full
                                                                 font-bold
                                                                 text-sm
                                                                 whitespace-nowrap">

                                                        @paymentStatus

                                                    </span>
                                                }

                                            </td>


                                            <!-- ACTION -->

                                            <td class="p-4 min-w-[190px]">
                                                <div class="flex flex-col gap-2">
                                                    <a href="@Url.Action("BookingDetails", "Admin", new { id = booking.BookingId })" class="w-full bg-blue-50 text-blue-600 hover:bg-blue-100 font-bold px-3 py-2 rounded-lg text-xs text-center inline-flex items-center justify-center gap-1">
                                                        <i class="fas fa-eye"></i> Xem chi tiết
                                                    </a>
                                                </div>
                                            </td>

                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>

                                        <td colspan="8"
                                            class="p-12
                                                   text-center
                                                   text-gray-400">

                                            <i class="fas
                                                      fa-inbox
                                                      text-5xl
                                                      mb-4">
                                            </i>

                                            <p>
                                                Không có đơn phù hợp.
                                            </p>

                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>

                </div>

            </section>

        </main>

    </div>



    <!-- ====================================================== -->
    <!-- CHART -->
    <!-- ====================================================== -->

    <script>

        const revenueLabels =
            @Html.Raw(
                System.Web.Helpers.Json.Encode(
                    ViewBag.RevenueLabels
                )
            );

        const roomRevenueData =
            @Html.Raw(
                System.Web.Helpers.Json.Encode(
                    ViewBag.RoomRevenue7Days
                )
            );

        const foodRevenueData =
            @Html.Raw(
                System.Web.Helpers.Json.Encode(
                    ViewBag.FoodRevenue7Days
                )
            );


        const revenueCanvas =
            document.getElementById(
                'revenueChart'
            );


        if (revenueCanvas) {

            new Chart(
                revenueCanvas,
                {
                    type: 'bar',

                    data: {
                        labels: revenueLabels,

                        datasets: [
                            {
                                label: 'Doanh thu phòng',
                                data: roomRevenueData,
                                borderWidth: 1,
                                borderRadius: 8,
                                backgroundColor: 'rgba(79, 70, 229, 0.8)',
                                borderColor: 'rgba(79, 70, 229, 1)'
                            },
                            {
                                label: 'Doanh thu nhà hàng',
                                data: foodRevenueData,
                                borderWidth: 1,
                                borderRadius: 8,
                                backgroundColor: 'rgba(245, 158, 11, 0.8)',
                                borderColor: 'rgba(245, 158, 11, 1)'
                            }
                        ]
                    },

                    options: {

                        responsive:
                            true,

                        maintainAspectRatio:
                            false,

                        plugins: {

                            legend: {
                                display: true,
                                position: 'top'
                            },

                            tooltip: {

                                callbacks: {

                                    label:
                                        function (
                                            context
                                        ) {
                                            let label = context.dataset.label || '';
                                            let val = context.raw || 0;
                                            return label + ': ' + Number(
                                                val
                                            ).toLocaleString(
                                                'vi-VN'
                                            )
                                            + 'đ';
                                        }
                                }
                            }
                        },

                        scales: {

                            y: {

                                beginAtZero:
                                    true,

                                ticks: {

                                    callback:
                                        function (
                                            value
                                        ) {

                                            return Number(
                                                value
                                            ).toLocaleString(
                                                'vi-VN'
                                            )
                                            + 'đ';
                                        }
                                }
                            }
                        }
                    }
                }
            );
        }

    </script>

    @Html.AntiForgeryToken()
    @Html.Partial("~/Views/Shared/_LuxuryModal.cshtml")

    <script>
        function performAdminBookingAction(bookingId, actionName, actionTitle, confirmMessage) {
            if (typeof showLuxuryConfirm !== 'function') {
                if (!confirm(confirmMessage)) return;
                executeAjaxAction(bookingId, actionName);
                return;
            }

            showLuxuryConfirm(confirmMessage, actionTitle, function () {
                executeAjaxAction(bookingId, actionName);
            });
        }

        function executeAjaxAction(bookingId, actionName) {
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
            const formData = new FormData();
            formData.append('id', bookingId);
            formData.append('__RequestVerificationToken', token);

            let url = '@Url.Action("Confirm", "Admin")';
            if (actionName === 'cancel') url = '@Url.Action("Cancel", "Admin")';
            else if (actionName === 'checkin') url = '@Url.Action("CheckIn", "Admin")';
            else if (actionName === 'checkout') url = '@Url.Action("CheckOut", "Admin")';
            else if (actionName === 'payment') url = '@Url.Action("ConfirmPayment", "Admin")';

            fetch(url, {
                method: 'POST',
                body: formData,
                headers: {
                    'X-Requested-With': 'XMLHttpRequest'
                }
            })
            .then(response => response.json())
            .then(res => {
                if (res && res.success) {
                    if (typeof showLuxuryAlert === 'function') {
                        showLuxuryAlert(res.message, 'Thành công', 'success');
                    }
                    setTimeout(() => location.reload(), 1000);
                } else {
                    if (typeof showLuxuryAlert === 'function') {
                        showLuxuryAlert(res ? res.message : 'Có lỗi xảy ra', 'Thất bại', 'warning');
                    }
                }
            })
            .catch(err => {
                if (typeof showLuxuryAlert === 'function') {
                    showLuxuryAlert('Không thể kết nối máy chủ. Vui lòng thử lại!', 'Lỗi', 'error');
                }
            });
        }
        function toggleAdminMobileSidebar() {
            const sidebar = document.getElementById('adminMobileSidebar');
            if (!sidebar) return;
            sidebar.classList.toggle('hidden');
        }
    </script>

    @Html.Partial("~/Views/Shared/_AIChat.cshtml")
</body>

</html>
