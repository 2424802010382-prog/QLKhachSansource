@model QLKhachSan.Models.AdminRefundManagementViewModel

@{
    Layout = null;
    ViewBag.AdminPage = "RefundManagement";
    string currentKeyword = ViewBag.Keyword as string ?? "";
    string currentStatus = ViewBag.Status as string ?? "";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Quản Lý Hoàn Tiền - Luxury Hotel Admin</title>

    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400..900;1,400..900&family=Plus+Jakarta+Sans:ital,wght@0,300..800;1,300..800&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Plus Jakarta Sans', Arial, sans-serif; }
        .font-serif { font-family: 'Playfair Display', Georgia, serif !important; }
    </style>
</head>

<body class="bg-[#0f172a] text-slate-100 min-h-screen flex">
    @Html.Partial("~/Views/Shared/_SecurityClient.cshtml")

    <!-- SIDEBAR -->
    @Html.Partial("~/Views/Admin/_AdminSidebar.cshtml")

    <!-- MAIN CONTENT -->
    <div class="flex-1 lg:ml-72 flex flex-col min-w-0">
        <!-- TOP NAV -->
        <header class="bg-[#1e293b] border-b border-slate-700/60 sticky top-0 z-40 px-6 py-4 flex items-center justify-between">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-amber-500 to-yellow-300 text-slate-900 flex items-center justify-center font-bold text-lg shadow-md">
                    <i class="fas fa-hand-holding-dollar"></i>
                </div>
                <div>
                    <h1 class="text-xl font-bold text-slate-100">QUẢN LÝ HOÀN TIỀN NGÂN HÀNG</h1>
                    <p class="text-xs text-slate-400">Xác nhận chuyển khoản VietinBank &amp; Quản lý yêu cầu hoàn tiền</p>
                </div>
            </div>

            <div class="flex items-center gap-3">
                <a href="@Url.Action("Index", "Admin")" class="px-3.5 py-2 bg-slate-700 hover:bg-slate-600 text-slate-200 rounded-xl text-xs font-semibold transition">
                    <i class="fas fa-arrow-left mr-1.5"></i> Dashboard
                </a>
            </div>
        </header>

        <main class="p-6 md:p-8 space-y-6 max-w-7xl mx-auto w-full">

            <!-- THÔNG BÁO -->
            @if (TempData["AdminSuccess"] != null)
            {
                <div class="bg-emerald-950/80 border border-emerald-500/50 text-emerald-200 p-4 rounded-2xl flex items-center gap-3 shadow-lg">
                    <i class="fas fa-circle-check text-emerald-400 text-xl"></i>
                    <div class="text-sm font-semibold">@TempData["AdminSuccess"]</div>
                </div>
            }

            @if (TempData["AdminError"] != null)
            {
                <div class="bg-rose-950/80 border border-rose-500/50 text-rose-200 p-4 rounded-2xl flex items-center gap-3 shadow-lg">
                    <i class="fas fa-circle-exclamation text-rose-400 text-xl"></i>
                    <div class="text-sm font-semibold">@TempData["AdminError"]</div>
                </div>
            }

            <!-- STATS CARDS -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4">
                <div class="bg-[#1e293b] p-5 rounded-2xl border border-slate-700/60 shadow-sm flex flex-col justify-between">
                    <div class="flex items-center justify-between text-slate-400 text-xs font-bold uppercase tracking-wider">
                        <span>Tổng tiền đã hoàn</span>
                        <i class="fas fa-sack-dollar text-emerald-400 text-lg"></i>
                    </div>
                    <div class="text-2xl font-black text-emerald-400 mt-2">@Model.TotalRefundedAmount.ToString("N0")đ</div>
                </div>

                <div class="bg-[#1e293b] p-5 rounded-2xl border border-slate-700/60 shadow-sm flex flex-col justify-between">
                    <div class="flex items-center justify-between text-slate-400 text-xs font-bold uppercase tracking-wider">
                        <span>NV đã duyệt (Chờ hoàn)</span>
                        <i class="fas fa-[#d4af37] fa-user-check text-amber-400 text-lg"></i>
                    </div>
                    <div class="text-2xl font-black text-amber-400 mt-2">@Model.StaffApprovedCount</div>
                </div>

                <div class="bg-[#1e293b] p-5 rounded-2xl border border-slate-700/60 shadow-sm flex flex-col justify-between">
                    <div class="flex items-center justify-between text-slate-400 text-xs font-bold uppercase tracking-wider">
                        <span>Chờ NV kiểm tra</span>
                        <i class="fas fa-clock text-blue-400 text-lg"></i>
                    </div>
                    <div class="text-2xl font-black text-blue-400 mt-2">@Model.PendingCount</div>
                </div>

                <div class="bg-[#1e293b] p-5 rounded-2xl border border-slate-700/60 shadow-sm flex flex-col justify-between">
                    <div class="flex items-center justify-between text-slate-400 text-xs font-bold uppercase tracking-wider">
                        <span>Đã hoàn tiền</span>
                        <i class="fas fa-circle-check text-emerald-400 text-lg"></i>
                    </div>
                    <div class="text-2xl font-black text-emerald-400 mt-2">@Model.CompletedCount</div>
                </div>

                <div class="bg-[#1e293b] p-5 rounded-2xl border border-slate-700/60 shadow-sm flex flex-col justify-between">
                    <div class="flex items-center justify-between text-slate-400 text-xs font-bold uppercase tracking-wider">
                        <span>Đã từ chối</span>
                        <i class="fas fa-circle-xmark text-rose-400 text-lg"></i>
                    </div>
                    <div class="text-2xl font-black text-rose-400 mt-2">@Model.RejectedCount</div>
                </div>
            </div>

            <!-- BỘ LỌC TÌM KIẾM -->
            <div class="bg-[#1e293b] p-5 rounded-2xl border border-slate-700/60 shadow-sm">
                <form method="get" action="@Url.Action("RefundManagement", "Admin")" class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                    <div>
                        <label class="block text-xs font-bold uppercase tracking-wider text-slate-400 mb-2">Tìm kiếm</label>
                        <div class="relative">
                            <i class="fas fa-search absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-500"></i>
                            <input type="text" name="keyword" value="@currentKeyword" placeholder="Mã đơn, Tên, SĐT, STK ngân hàng..." class="w-full bg-slate-800 border border-slate-700 rounded-xl pl-10 pr-3 py-2.5 text-sm text-slate-100 focus:ring-2 focus:ring-amber-500 focus:outline-none" />
                        </div>
                    </div>

                    <div>
                        <label class="block text-xs font-bold uppercase tracking-wider text-slate-400 mb-2">Trạng thái</label>
                        <select name="status" class="w-full bg-slate-800 border border-slate-700 rounded-xl px-3 py-2.5 text-sm text-slate-100 focus:ring-2 focus:ring-amber-500 focus:outline-none">
                            <option value="">-- Tất cả trạng thái --</option>
                            <option value="NhanVienDaDuyet" @(currentStatus == "NhanVienDaDuyet" ? "selected" : "")>NV đã xác nhận (Chờ Admin hoàn)</option>
                            <option value="ChoDuyet" @(currentStatus == "ChoDuyet" ? "selected" : "")>Chờ nhân viên kiểm tra</option>
                            <option value="DaHoanTien" @(currentStatus == "DaHoanTien" ? "selected" : "")>Đã hoàn tiền thành công</option>
                            <option value="TuChoi" @(currentStatus == "TuChoi" ? "selected" : "")>Đã từ chối</option>
                        </select>
                    </div>

                    <div class="flex items-end gap-2">
                        <button type="submit" class="bg-amber-500 hover:bg-amber-600 text-slate-950 font-bold px-5 py-2.5 rounded-xl transition flex-1 text-sm shadow-md">
                            <i class="fas fa-filter mr-1.5"></i> Lọc danh sách
                        </button>
                        <a href="@Url.Action("RefundManagement", "Admin")" class="border border-slate-700 text-slate-300 font-bold px-4 py-2.5 rounded-xl hover:bg-slate-800 transition text-sm">
                            Đặt lại
                        </a>
                    </div>
                </form>
            </div>

            <!-- DANH SÁCH BẢNG -->
            <div class="bg-[#1e293b] rounded-2xl border border-slate-700/60 shadow-sm overflow-hidden">
                <div class="p-5 border-b border-slate-700/60 bg-slate-800/50 flex justify-between items-center">
                    <h2 class="font-bold text-slate-100 text-lg">
                        <i class="fas fa-receipt text-amber-400 mr-2"></i> Danh sách Yêu cầu Hoàn tiền (@(Model.Requests != null ? Model.Requests.Count() : 0))
                    </h2>
                </div>

                @if (Model.Requests == null || !Model.Requests.Any())
                {
                    <div class="p-12 text-center text-slate-500">
                        <i class="fas fa-inbox text-5xl mb-3 text-slate-600"></i>
                        <p class="font-semibold">Không tìm thấy yêu cầu hoàn tiền nào phù hợp.</p>
                    </div>
                }
                else
                {
                    <div class="overflow-x-auto">
                        <table class="w-full text-left text-sm text-slate-200">
                            <thead class="bg-slate-900 text-amber-400 uppercase text-xs font-bold">
                                <tr>
                                    <th class="p-4">Mã Đơn</th>
                                    <th class="p-4">Khách hàng</th>
                                    <th class="p-4">Số tiền Hoàn</th>
                                    <th class="p-4">Ngân hàng &amp; STK Nhận</th>
                                    <th class="p-4">Trạng thái</th>
                                    <th class="p-4 text-center">Thao tác Admin</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-800">
                                @foreach (var item in Model.Requests)
                                {
                                    <tr class="hover:bg-slate-800/60 transition">
                                        <td class="p-4 align-top">
                                            <div class="font-bold text-slate-100">#@item.BookingId</div>
                                            <div class="text-xs text-slate-400">@item.RoomName</div>
                                            <div class="text-xs text-slate-500 mt-1">@item.RequestedAt.ToString("dd/MM/yyyy HH:mm")</div>
                                        </td>
                                        <td class="p-4 align-top">
                                            <div class="font-bold text-slate-100">@item.CustomerName</div>
                                            <div class="text-xs text-slate-400"><i class="fas fa-phone mr-1"></i>@item.CustomerPhone</div>
                                            <div class="text-xs text-slate-400"><i class="fas fa-envelope mr-1"></i>@item.CustomerEmail</div>
                                        </td>
                                        <td class="p-4 align-top">
                                            <div class="text-xs text-slate-400">Đã TT: @item.PaidAmount.ToString("N0")đ</div>
                                            <div class="text-xs text-amber-400 font-bold">Mức hoàn: @item.RefundRate%</div>
                                            <div class="text-base font-black text-rose-400 mt-0.5">Cần hoàn: @item.RefundAmount.ToString("N0")đ</div>
                                        </td>
                                        <td class="p-4 align-top">
                                            <div class="font-bold text-amber-300">@item.BankName</div>
                                            <div class="text-sm font-mono font-bold text-blue-300 tracking-wider">@item.AccountNumber</div>
                                            <div class="text-xs font-semibold text-slate-300 uppercase">@item.AccountHolder</div>
                                            <div class="text-xs text-slate-400 mt-1 italic" title="@item.Reason">Lý do: "@item.Reason"</div>
                                        </td>
                                        <td class="p-4 align-top">
                                            @if (item.Status == "ChoDuyet")
                                            {
                                                <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-bold bg-amber-950/80 text-amber-300 border border-amber-500/40">
                                                    <i class="fas fa-clock mr-1"></i> Chờ NV kiểm tra
                                                </span>
                                            }
                                            else if (item.Status == "NhanVienDaDuyet")
                                            {
                                                <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-bold bg-blue-950/80 text-blue-300 border border-blue-500/40 animate-pulse">
                                                    <i class="fas fa-user-check mr-1"></i> NV đã xác nhận (Chờ Admin)
                                                </span>
                                            }
                                            else if (item.Status == "DaHoanTien")
                                            {
                                                <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-bold bg-emerald-950/80 text-emerald-300 border border-emerald-500/40">
                                                    <i class="fas fa-circle-check mr-1"></i> Đã hoàn tiền thành công
                                                </span>
                                            }
                                            else if (item.Status == "TuChoi")
                                            {
                                                <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-bold bg-rose-950/80 text-rose-300 border border-rose-500/40" title="@item.RejectedReason">
                                                    <i class="fas fa-circle-xmark mr-1"></i> Đã từ chối
                                                </span>
                                                if (!string.IsNullOrWhiteSpace(item.RejectedReason))
                                                {
                                                    <div class="text-xs text-rose-400 mt-1">Lý do: @item.RejectedReason</div>
                                                }
                                            }
                                        </td>
                                        <td class="p-4 align-top text-center">
                                            @if (item.Status != "DaHoanTien")
                                            {
                                                <div class="flex flex-col gap-2 justify-center">
                                                    <button type="button"
                                                            onclick="openConfirmModal(@item.RefundRequestId, @item.BookingId, '@Html.Encode(item.BankName)', '@item.AccountNumber', '@Html.Encode(item.AccountHolder)', @item.RefundAmount)"
                                                            class="bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-500 hover:to-teal-500 text-white font-bold px-3 py-2 rounded-xl text-xs transition shadow-md flex items-center justify-center gap-1.5">
                                                        <i class="fas fa-money-bill-transfer"></i> Chuyển khoản &amp; Xác nhận
                                                    </button>
                                                    <button type="button"
                                                            onclick="openAdminRejectModal(@item.RefundRequestId, @item.BookingId)"
                                                            class="bg-rose-900/60 hover:bg-rose-800 text-rose-200 border border-rose-700/50 font-semibold px-3 py-1.5 rounded-xl text-xs transition">
                                                        <i class="fas fa-xmark mr-1"></i> Từ chối
                                                    </button>
                                                </div>
                                            }
                                            else
                                            {
                                                <span class="text-xs text-emerald-400 font-bold flex items-center justify-center gap-1">
                                                    <i class="fas fa-check-double"></i> Đã hoàn tất
                                                </span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </main>
    </div>

    <!-- MODAL XÁC NHẬN CHUYỂN KHOẢN HOÀN TIỀN (ADMIN) -->
    <div id="confirmRefundModal" class="fixed inset-0 bg-black/80 hidden justify-center items-center p-4 z-50">
        <div class="bg-[#1e293b] rounded-2xl max-w-lg w-full p-6 md:p-8 shadow-2xl border border-slate-700 relative text-slate-100">
            <button type="button" onclick="closeConfirmModal()" class="absolute top-4 right-4 text-slate-400 hover:text-slate-200">
                <i class="fas fa-times text-xl"></i>
            </button>

            <div class="text-center mb-6">
                <div class="w-14 h-14 mx-auto rounded-full bg-emerald-950 text-emerald-400 border border-emerald-500/30 flex items-center justify-center text-2xl mb-2">
                    <i class="fas fa-building-columns"></i>
                </div>
                <h3 class="text-xl font-bold text-slate-100">Xác Nhận Hoàn Tiền Thủ Công</h3>
                <p class="text-xs text-slate-400 mt-1">Đơn đặt phòng <span id="confirmBookingId" class="font-bold text-amber-400">#0</span></p>
            </div>

            <!-- THÔNG TIN NGÂN HÀNG CẦN CHUYỂN KHOẢN -->
            <div class="bg-slate-900/90 border border-amber-500/40 rounded-xl p-4 mb-5 text-sm space-y-2">
                <div class="text-xs font-bold uppercase text-amber-400 tracking-wider mb-1 flex items-center gap-1.5">
                    <i class="fas fa-info-circle"></i> Thông tin chuyển khoản cho khách hàng:
                </div>
                <div class="flex justify-between items-center"><span class="text-slate-400">Ngân hàng:</span><strong id="confirmBankName" class="text-amber-300 font-bold">---</strong></div>
                <div class="flex justify-between items-center"><span class="text-slate-400">Số tài khoản:</span><strong id="confirmAccountNumber" class="text-blue-300 font-mono font-bold text-base tracking-wider">---</strong></div>
                <div class="flex justify-between items-center"><span class="text-slate-400">Chủ tài khoản:</span><strong id="confirmAccountHolder" class="text-slate-100 uppercase font-bold">---</strong></div>
                <div class="flex justify-between items-center pt-2 border-t border-slate-800"><span class="text-slate-200 font-bold">Số tiền chuyển:</span><strong id="confirmRefundAmount" class="text-emerald-400 text-lg font-black">0đ</strong></div>
            </div>

            <div class="bg-blue-950/60 border border-blue-500/30 rounded-xl p-3 mb-5 text-xs text-blue-200 flex items-start gap-2">
                <i class="fas fa-mobile-screen text-blue-400 text-base mt-0.5"></i>
                <div>
                    <strong>Hướng dẫn:</strong> Admin vui lòng mở ứng dụng <strong>VietinBank iPay</strong> hoặc App ngân hàng để thực hiện chuyển khoản cho khách hàng theo đúng thông tin trên trước khi nhập mã giao dịch xác nhận.
                </div>
            </div>

            <form action="@Url.Action("ConfirmRefundTransaction", "Admin")" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" id="inputRefundRequestId" name="refundRequestId" value="0" />

                <div class="mb-4">
                    <label class="block text-xs font-bold uppercase text-slate-300 mb-1">Mã giao dịch VietinBank / Mã tham chiếu <span class="text-rose-400">*</span></label>
                    <input type="text" name="transactionCode" required placeholder="Ví dụ: FT26039182390123" class="w-full bg-slate-900 border border-slate-700 rounded-xl px-3 py-2.5 text-sm text-slate-100 focus:ring-2 focus:ring-amber-500 focus:outline-none" />
                </div>

                <div class="mb-4">
                    <label class="block text-xs font-bold uppercase text-slate-300 mb-1">Ảnh biên lai chuyển khoản (Không bắt buộc)</label>
                    <input type="file" name="receiptFile" accept="image/*" class="w-full bg-slate-900 border border-slate-700 rounded-xl p-2 text-xs text-slate-300 file:mr-3 file:py-1.5 file:px-3 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-amber-500 file:text-slate-950 hover:file:bg-amber-600" />
                </div>

                <div class="mb-6">
                    <label class="block text-xs font-bold uppercase text-slate-300 mb-1">Ghi chú giao dịch</label>
                    <textarea name="notes" rows="2" placeholder="Ghi chú thêm về giao dịch chuyển khoản hoàn tiền..." class="w-full bg-slate-900 border border-slate-700 rounded-xl p-3 text-xs text-slate-100 focus:ring-2 focus:ring-amber-500 focus:outline-none"></textarea>
                </div>

                <div class="flex gap-3 justify-end">
                    <button type="button" onclick="closeConfirmModal()" class="px-4 py-2.5 border border-slate-700 rounded-xl text-xs font-bold text-slate-300 hover:bg-slate-800">Hủy</button>
                    <button type="submit" class="px-5 py-2.5 bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-500 hover:to-teal-500 text-white rounded-xl text-xs font-bold shadow-lg flex items-center gap-1.5">
                        <i class="fas fa-check-double"></i> Xác Nhận Đã Hoàn Tiền
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- MODAL TỪ CHỐI ADMIN -->
    <div id="adminRejectModal" class="fixed inset-0 bg-black/80 hidden justify-center items-center p-4 z-50">
        <div class="bg-[#1e293b] rounded-2xl max-w-md w-full p-6 shadow-2xl border border-slate-700 relative text-slate-100">
            <h3 class="text-lg font-bold text-slate-100 mb-2">Từ chối Yêu cầu Hoàn tiền</h3>
            <p class="text-xs text-slate-400 mb-4">Đơn đặt phòng <span id="rejectBookingText" class="font-bold text-amber-400">#0</span></p>

            <form action="@Url.Action("AdminRejectRefundRequest", "Admin")" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" id="adminRejectId" name="id" value="0" />
                <div class="mb-5">
                    <label class="block text-xs font-bold uppercase text-slate-300 mb-1">Lý do từ chối <span class="text-rose-400">*</span></label>
                    <textarea name="reason" rows="3" required placeholder="Ví dụ: Không đúng chính sách hoàn tiền..." class="w-full bg-slate-900 border border-slate-700 rounded-xl p-3 text-xs text-slate-100 focus:ring-2 focus:ring-rose-500 focus:outline-none"></textarea>
                </div>
                <div class="flex gap-3 justify-end">
                    <button type="button" onclick="closeAdminRejectModal()" class="px-4 py-2 border border-slate-700 rounded-xl text-xs font-bold text-slate-300 hover:bg-slate-800">Hủy</button>
                    <button type="submit" class="px-4 py-2 bg-rose-600 hover:bg-rose-700 text-white rounded-xl text-xs font-bold shadow-md">Xác nhận Từ chối</button>
                </div>
            </form>
        </div>
    </div>

    <script>
        function openConfirmModal(requestId, bookingId, bankName, accountNumber, accountHolder, amount) {
            document.getElementById('inputRefundRequestId').value = requestId;
            document.getElementById('confirmBookingId').innerText = '#' + bookingId;
            document.getElementById('confirmBankName').innerText = bankName;
            document.getElementById('confirmAccountNumber').innerText = accountNumber;
            document.getElementById('confirmAccountHolder').innerText = accountHolder;
            document.getElementById('confirmRefundAmount').innerText = Number(amount).toLocaleString('vi-VN') + 'đ';

            const modal = document.getElementById('confirmRefundModal');
            modal.classList.remove('hidden');
            modal.classList.add('flex');
        }

        function closeConfirmModal() {
            const modal = document.getElementById('confirmRefundModal');
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        }

        function openAdminRejectModal(id, bookingId) {
            document.getElementById('adminRejectId').value = id;
            document.getElementById('rejectBookingText').innerText = '#' + bookingId;

            const modal = document.getElementById('adminRejectModal');
            modal.classList.remove('hidden');
            modal.classList.add('flex');
        }

        function closeAdminRejectModal() {
            const modal = document.getElementById('adminRejectModal');
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        }
    </script>
</body>
</html>
