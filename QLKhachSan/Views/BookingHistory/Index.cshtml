@model IEnumerable<QLKhachSan.Models.BookingHistoryViewModel>

@using System.Linq

@{
    Layout = null;
}

<!DOCTYPE html>

<html lang="vi">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        Lịch sử đặt phòng - Luxury Hotel
    </title>


    <!-- TAILWIND -->
    <script src="https://cdn.tailwindcss.com"></script>


    <!-- FONT AWESOME -->
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />


    <style>

        body {
            font-family: Arial, "Segoe UI", sans-serif;
            background: linear-gradient( 180deg, #f7f4ed 0%, #ffffff 45%, #f5f5f5 100% );
        }


        .history-header {
            background: linear-gradient( 135deg, #090704 0%, #171006 55%, #2b1d08 100% );
        }


        .gold-text {
            color: #d4af37;
        }


        .booking-card {
            background: white;
            border: 1px solid #ece6d8;
            box-shadow: 0 10px 35px rgba(0, 0, 0, 0.07);
            transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
        }


            .booking-card:hover {
                transform: translateY(-4px);
                border-color: #d4af37;
                box-shadow: 0 18px 45px rgba(0, 0, 0, 0.12);
            }


        .room-image {
            width: 100%;
            height: 240px;
            object-fit: cover;
        }


        .info-box {
            background: #faf9f6;
            border: 1px solid #eee8db;
        }


        .status-badge {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 7px 14px;
            border-radius: 999px;
            font-size: 13px;
            font-weight: 700;
            white-space: nowrap;
        }


        .status-waiting {
            color: #92400e;
            background: #fef3c7;
            border: 1px solid #fde68a;
        }


        .status-confirmed {
            color: #1e40af;
            background: #dbeafe;
            border: 1px solid #bfdbfe;
        }


        .status-checkin {
            color: #075985;
            background: #e0f2fe;
            border: 1px solid #bae6fd;
        }


        .status-completed {
            color: #166534;
            background: #dcfce7;
            border: 1px solid #bbf7d0;
        }


        .status-cancelled {
            color: #991b1b;
            background: #fee2e2;
            border: 1px solid #fecaca;
        }


        .status-default {
            color: #374151;
            background: #f3f4f6;
            border: 1px solid #e5e7eb;
        }


        .back-button {
            border: 1px solid rgba(212, 175, 55, 0.8);
            color: #f5d76e;
            transition: all 0.2s ease;
        }


            .back-button:hover {
                background: #d4af37;
                color: #111;
            }


        .gold-button {
            background: linear-gradient( 135deg, #b68a22, #e5c357 );
            color: #171006;
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }


            .gold-button:hover {
                transform: translateY(-2px);
                box-shadow: 0 8px 24px rgba(180, 138, 34, 0.3);
            }


        @@media (max-width: 768px) {

            .room-image {
                height: 210px;
            }
        }
    </style>

</head>


<body class="min-h-screen text-gray-800">
    @Html.Partial("~/Views/Shared/_SecurityClient.cshtml")


    <!-- ========================================================= -->
    <!-- HEADER -->
    <!-- ========================================================= -->

    <header class="history-header text-white">

        <div class="max-w-7xl mx-auto
                    px-4 sm:px-6 lg:px-8
                    py-5">

            <div class="flex flex-col
                        md:flex-row
                        md:items-center
                        md:justify-between
                        gap-4">


                <!-- LOGO -->

                <a href="@Url.Action(
                            "Index",
                            "Home"
                         )"
                   class="flex items-center gap-3">

                    <div class="w-11 h-11
                                rounded-full
                                border border-yellow-500
                                flex items-center
                                justify-center
                                text-yellow-400">

                        <i class="fas fa-crown text-xl"></i>

                    </div>


                    <div>

                        <div class="font-bold
                                    text-xl
                                    tracking-wide">

                            LUXURY HOTEL

                        </div>

                        <div class="text-yellow-300
                                    text-xs
                                    tracking-[3px]">

                            LUXURY &amp; COMFORT

                        </div>

                    </div>

                </a>


                <!-- QUAY LẠI -->

                <a href="@Url.Action(
                            "Index",
                            "Home"
                         )"
                   class="back-button
                          px-5 py-2.5
                          rounded-lg
                          font-semibold
                          text-sm">

                    <i class="fas fa-arrow-left mr-2"></i>

                    Về trang chủ

                </a>

            </div>

        </div>


        <!-- TIÊU ĐỀ -->

        <div class="max-w-7xl mx-auto
                    px-4 sm:px-6 lg:px-8
                    pt-10 pb-16
                    text-center">

            <div class="gold-text text-sm
                        font-bold
                        tracking-[4px]
                        mb-4">

                LUXURY HOTEL

            </div>


            <h1 class="text-4xl md:text-5xl
                       font-bold
                       mb-4"
                style="font-family:
                       'Times New Roman',
                       Times,
                       serif;">

                Lịch Sử Đặt Phòng

            </h1>


            <p class="text-gray-300
                      max-w-2xl
                      mx-auto
                      leading-relaxed">

                Theo dõi tất cả các kỳ nghỉ
                và thông tin đặt phòng của bạn
                tại Luxury Hotel.

            </p>

        </div>

    </header>



    <!-- ========================================================= -->
    <!-- NỘI DUNG -->
    <!-- ========================================================= -->

    <main class="max-w-7xl mx-auto
                 px-4 sm:px-6 lg:px-8
                 py-12">

        @if (TempData["RefundSuccess"] != null)
        {
            <div class="mb-6 bg-green-50 border border-green-200 text-green-800 rounded-xl p-4 flex items-center gap-3">
                <i class="fas fa-circle-check text-green-600 text-xl"></i>
                <div>@Html.Raw(TempData["RefundSuccess"])</div>
            </div>
        }

        @if (TempData["RefundError"] != null)
        {
            <div class="mb-6 bg-red-50 border border-red-200 text-red-800 rounded-xl p-4 flex items-center gap-3">
                <i class="fas fa-circle-exclamation text-red-600 text-xl"></i>
                <div>@TempData["RefundError"]</div>
            </div>
        }


        @if (
            Model == null ||
            !Model.Any()
        )
        {

            <!-- ================================================= -->
            <!-- CHƯA CÓ BOOKING -->
            <!-- ================================================= -->

            <div class="bg-white
                        rounded-2xl
                        shadow-lg
                        border border-gray-200
                        px-6 py-16
                        text-center
                        max-w-2xl
                        mx-auto">


                <div class="w-20 h-20
                            mx-auto
                            rounded-full
                            bg-yellow-50
                            flex items-center
                            justify-center
                            text-yellow-600
                            mb-6">

                    <i class="fas fa-suitcase-rolling
                              text-4xl"></i>

                </div>


                <h2 class="text-2xl
                           font-bold
                           text-gray-900
                           mb-3">

                    Bạn chưa có đặt phòng nào

                </h2>


                <p class="text-gray-500
                          leading-relaxed
                          mb-8">

                    Sau khi bạn đặt phòng bằng tài khoản này,
                    thông tin đặt phòng sẽ xuất hiện tại đây.

                </p>


                <a href="@Url.Action(
                            "Index",
                            "Home",
                            new
                            {
                                page = "rooms"
                            }
                         )"
                   class="gold-button
                          inline-flex
                          items-center
                          justify-center
                          px-7 py-3.5
                          rounded-xl
                          font-bold">

                    <i class="fas fa-bed mr-2"></i>

                    Khám phá phòng

                </a>

            </div>

        }
        else
        {

            <!-- ================================================= -->
            <!-- THỐNG KÊ -->
            <!-- ================================================= -->

            <div class="flex flex-col
                        md:flex-row
                        md:items-end
                        md:justify-between
                        gap-4
                        mb-8">


                <div>

                    <p class="text-sm
                              uppercase
                              tracking-[3px]
                              text-yellow-700
                              font-bold
                              mb-2">

                        Các kỳ nghỉ của bạn

                    </p>


                    <h2 class="text-3xl
                               font-bold
                               text-gray-900">

                        Danh sách đặt phòng

                    </h2>

                </div>


                <div class="bg-white
                            border border-gray-200
                            shadow-sm
                            rounded-xl
                            px-5 py-3">

                    <span class="text-gray-500">

                        Tổng số:

                    </span>

                    <strong class="text-yellow-700
                                   text-xl
                                   ml-2">

                        @Model.Count()

                    </strong>

                    <span class="text-gray-500">

                        đơn đặt phòng

                    </span>

                </div>

            </div>



            <!-- ================================================= -->
            <!-- DANH SÁCH BOOKING -->
            <!-- ================================================= -->

            <div class="space-y-8">


                @foreach (
                    var booking
                    in Model
                )
                {

                    var status =
                        (
                            booking.Status ??
                            ""
                        ).Trim();


                    var statusClass =
                        "status-default";


                    var statusIcon =
                        "fa-circle-info";


                    if (
                        status ==
                        "Chờ xác nhận"
                    )
                    {
                        statusClass =
                            "status-waiting";

                        statusIcon =
                            "fa-clock";
                    }
                    else if (
                        status ==
                        "Đã xác nhận"
                    )
                    {
                        statusClass =
                            "status-confirmed";

                        statusIcon =
                            "fa-circle-check";
                    }
                    else if (
                        status ==
                        "Đã nhận phòng"
                    )
                    {
                        statusClass =
                            "status-checkin";

                        statusIcon =
                            "fa-key";
                    }
                    else if (
                        status ==
                        "Hoàn tất"
                    )
                    {
                        statusClass =
                            "status-completed";

                        statusIcon =
                            "fa-circle-check";
                    }
                    else if (
                        status ==
                        "Đã hủy"
                    )
                    {
                        statusClass =
                            "status-cancelled";

                        statusIcon =
                            "fa-circle-xmark";
                    }


                    var nights =
                        (
                            booking.CheckOutDate.Date -
                            booking.CheckInDate.Date
                        ).Days;


                    if (nights < 1)
                    {
                        nights = 1;
                    }


                    <article class="booking-card
                                    rounded-2xl
                                    overflow-hidden">


                        <div class="grid
                                    grid-cols-1
                                    lg:grid-cols-[340px_1fr]">


                            <!-- ================================= -->
                            <!-- ẢNH PHÒNG -->
                            <!-- ================================= -->

                            <div class="relative">


                                @if (
                                    !string.IsNullOrWhiteSpace(
                                        booking.ImageUrl
                                    )
                                )
                                {

                                    <img src="@booking.ImageUrl"
                                         alt="@booking.RoomName"
                                         class="room-image
                                                lg:h-full" />

                                }
                                else
                                {

                                    <div class="room-image
                                                lg:h-full
                                                bg-gray-200
                                                flex items-center
                                                justify-center
                                                text-gray-400">

                                        <i class="fas fa-image
                                                  text-5xl"></i>

                                    </div>

                                }


                                <div class="absolute
                                            top-4 left-4
                                            bg-black/70
                                            text-white
                                            px-4 py-2
                                            rounded-lg
                                            text-sm
                                            font-bold">

                                    #@booking.BookingId

                                </div>

                            </div>



                            <!-- ================================= -->
                            <!-- THÔNG TIN -->
                            <!-- ================================= -->

                            <div class="p-6 md:p-8">


                                <!-- TÊN + TRẠNG THÁI -->

                                <div class="flex
                                            flex-col
                                            sm:flex-row
                                            sm:items-start
                                            sm:justify-between
                                            gap-4
                                            mb-6">


                                    <div>

                                        <p class="text-yellow-700
                                                  text-xs
                                                  tracking-[2px]
                                                  uppercase
                                                  font-bold
                                                  mb-2">

                                            @booking.RoomType

                                        </p>


                                        <h3 class="text-2xl
                                                   md:text-3xl
                                                   font-bold
                                                   text-gray-900">

                                            @booking.RoomName

                                        </h3>


                                        <p class="text-gray-400
                                                  text-sm
                                                  mt-2">

                                            Đặt ngày:

                                            @booking.CreatedAt.ToString(
                                                "dd/MM/yyyy HH:mm"
                                            )

                                        </p>

                                    </div>


                                    <span class="status-badge
                                                 @statusClass">

                                        <i class="fas
                                                  @statusIcon
                                                  mr-2"></i>

                                        @(string.IsNullOrWhiteSpace(status)
                                            ? "Chưa cập nhật"
                                            : status)

                                    </span>

                                </div>



                                <!-- ================================= -->
                                <!-- THÔNG TIN NGÀY -->
                                <!-- ================================= -->

                                <div class="grid
                                            grid-cols-1
                                            sm:grid-cols-3
                                            gap-4
                                            mb-5">


                                    <div class="info-box
                                                rounded-xl
                                                p-4">

                                        <p class="text-gray-500
                                                  text-xs
                                                  uppercase
                                                  tracking-wide
                                                  mb-1">

                                            Nhận phòng

                                        </p>

                                        <p class="font-bold
                                                  text-gray-900">

                                            <i class="fas
                                                      fa-calendar-check
                                                      text-yellow-600
                                                      mr-2"></i>

                                            @booking.CheckInDate.ToString(
                                                "dd/MM/yyyy"
                                            )

                                        </p>

                                    </div>



                                    <div class="info-box
                                                rounded-xl
                                                p-4">

                                        <p class="text-gray-500
                                                  text-xs
                                                  uppercase
                                                  tracking-wide
                                                  mb-1">

                                            Trả phòng

                                        </p>

                                        <p class="font-bold
                                                  text-gray-900">

                                            <i class="fas
                                                      fa-calendar-xmark
                                                      text-yellow-600
                                                      mr-2"></i>

                                            @booking.CheckOutDate.ToString(
                                                "dd/MM/yyyy"
                                            )

                                        </p>

                                    </div>



                                    <div class="info-box
                                                rounded-xl
                                                p-4">

                                        <p class="text-gray-500
                                                  text-xs
                                                  uppercase
                                                  tracking-wide
                                                  mb-1">

                                            Thời gian lưu trú

                                        </p>

                                        <p class="font-bold
                                                  text-gray-900">

                                            <i class="fas
                                                      fa-moon
                                                      text-yellow-600
                                                      mr-2"></i>

                                            @nights đêm

                                        </p>

                                    </div>

                                </div>



                                <!-- ================================= -->
                                <!-- KHÁCH / PHÒNG / THANH TOÁN -->
                                <!-- ================================= -->

                                <div class="grid
                                            grid-cols-1
                                            sm:grid-cols-3
                                            gap-4
                                            mb-6">


                                    <div>

                                        <p class="text-gray-500
                                                  text-sm
                                                  mb-1">

                                            <i class="fas
                                                      fa-users
                                                      mr-2
                                                      text-yellow-600"></i>

                                            Số khách

                                        </p>

                                        <strong class="text-gray-900">

                                            @booking.GuestCount người

                                        </strong>

                                    </div>


                                    <div>

                                        <p class="text-gray-500
                                                  text-sm
                                                  mb-1">

                                            <i class="fas
                                                      fa-door-open
                                                      mr-2
                                                      text-yellow-600"></i>

                                            Số phòng

                                        </p>

                                        <strong class="text-gray-900">

                                            @booking.RoomCount phòng

                                        </strong>

                                    </div>


                                    <div>

                                        <p class="text-gray-500
                                                  text-sm
                                                  mb-1">

                                            <i class="fas
                                                      fa-credit-card
                                                      mr-2
                                                      text-yellow-600"></i>

                                            Thanh toán

                                        </p>

                                        <strong class="text-gray-900">

                                            @(string.IsNullOrWhiteSpace(
                                                booking.PaymentMethod
                                              )
                                                ? "Chưa cập nhật"
                                                : booking.PaymentMethod)

                                        </strong>

                                    </div>

                                </div>



                                <!-- ================================= -->
                                <!-- TỔNG TIỀN -->
                                <!-- ================================= -->

                                <div class="border-t
                                            border-gray-200
                                            pt-5
                                            flex
                                            flex-col
                                            sm:flex-row
                                            sm:items-center
                                            sm:justify-between
                                            gap-3">


                                    <div>

                                        <p class="text-gray-500
                                                  text-sm">

                                            Tổng thanh toán

                                        </p>


                                        <p class="text-2xl
                                                  font-extrabold
                                                  text-yellow-700">

                                            @booking.TotalAmount.ToString(
                                                "N0"
                                            )đ

                                        </p>

                                    </div>


                                    <div class="flex
            flex-wrap
            items-center
            justify-end
            gap-3">


                                        <span class="text-sm
                 text-gray-400">

                                            <i class="fas
                  fa-shield-halved
                  mr-1">
                                            </i>

                                            Mã đặt phòng
                                            #@booking.BookingId

                                        </span>


                                        @if (!string.IsNullOrWhiteSpace(booking.RefundStatus))
                                        {
                                            <span class="inline-flex items-center px-3 py-1.5 rounded-lg text-xs font-bold @(booking.RefundStatus == "DaHoanTien" ? "bg-green-100 text-green-800 border border-green-300" : (booking.RefundStatus == "TuChoi" ? "bg-red-100 text-red-800 border border-red-300" : "bg-amber-100 text-amber-800 border border-amber-300"))">
                                                <i class="fas fa-arrow-rotate-left mr-1.5"></i>
                                                @booking.RefundStatusText
                                            </span>
                                        }
                                        else if (booking.CanRequestRefund)
                                        {
                                            <button type="button"
                                                    onclick="openRefundModal(@booking.BookingId, '@Html.Encode(booking.RoomName)', @booking.TotalAmount, @booking.RefundRate, @booking.EstimatedRefundAmount)"
                                                    class="inline-flex items-center justify-center bg-red-600 hover:bg-red-700 text-white font-bold px-4 py-2.5 rounded-lg transition shadow-sm text-sm">
                                                <i class="fas fa-hand-holding-dollar mr-1.5"></i>
                                                Yêu cầu hoàn tiền (@booking.RefundRate%)
                                            </button>
                                        }

                                        <a href="@Url.Action(
                "Details",
                "BookingHistory",
                new
                {
                    id = booking.BookingId
                }
             )"
                                           class="inline-flex
              items-center
              justify-center
              bg-yellow-500
              hover:bg-yellow-600
              text-gray-900
              font-bold
              px-5
              py-2.5
              rounded-lg
              transition">

                                            <i class="fas
                  fa-eye
                  mr-2">
                                            </i>

                                            Xem chi tiết

                                        </a>

                                    </div>

                                </div>

                            </div>

                        </div>

                    </article>

                }

            </div>

        }

    </main>



    <!-- ========================================================= -->
    <!-- FOOTER -->
    <!-- ========================================================= -->

    <footer class="mt-12
                   bg-[#0d0a05]
                   text-gray-400
                   py-8">

        <div class="max-w-7xl
                    mx-auto
                    px-4
                    text-center
                    text-sm">

            <i class="fas fa-crown
                      text-yellow-500
                      mr-2"></i>

            Luxury Hotel

            <span class="mx-2">•</span>

            Lịch sử đặt phòng của bạn

        </div>

    </footer>

    <!-- ========================================================= -->
    <!-- MODAL YÊU CẦU HOÀN TIỀN -->
    <!-- ========================================================= -->
    <div id="refundModal" class="fixed inset-0 bg-black/70 hidden justify-center items-center p-4 z-50 transition-opacity duration-300 opacity-0">
        <div class="bg-white rounded-2xl max-w-lg w-full p-6 md:p-8 shadow-2xl relative transform scale-95 transition-transform duration-300">
            <button type="button" onclick="closeRefundModal()" class="absolute top-4 right-4 text-gray-400 hover:text-gray-600">
                <i class="fas fa-times text-xl"></i>
            </button>
            <div class="text-center mb-6">
                <div class="w-16 h-16 mx-auto rounded-full bg-red-100 text-red-600 flex items-center justify-center text-2xl mb-3">
                    <i class="fas fa-hand-holding-dollar"></i>
                </div>
                <h3 class="text-2xl font-bold text-gray-900">Yêu Cầu Hoàn Tiền</h3>
                <p class="text-gray-500 text-sm mt-1">Đơn đặt phòng <span id="modalBookingId" class="font-bold text-gray-800">#0</span> - <span id="modalRoomName"></span></p>
            </div>

            <!-- Thẻ chính sách & Tính toán -->
            <div class="bg-amber-50 border border-amber-200 rounded-xl p-4 mb-5 text-sm">
                <div class="flex justify-between items-center mb-2">
                    <span class="text-gray-600">Đã thanh toán:</span>
                    <strong id="modalPaidAmount" class="text-gray-900 font-bold">0đ</strong>
                </div>
                <div class="flex justify-between items-center mb-2">
                    <span class="text-gray-600">Tỷ lệ hoàn (Chính sách):</span>
                    <strong id="modalRefundRate" class="text-amber-700 font-bold">0%</strong>
                </div>
                <div class="flex justify-between items-center pt-2 border-t border-amber-200">
                    <span class="text-gray-900 font-bold">Số tiền hoàn dự kiến:</span>
                    <strong id="modalRefundAmount" class="text-red-600 text-lg font-black">0đ</strong>
                </div>
            </div>

            <form action="@Url.Action("RequestRefund", "BookingHistory")" method="post" onsubmit="return confirmRefundSubmit(event);">
                @Html.AntiForgeryToken()
                <input type="hidden" id="inputBookingId" name="BookingId" value="0" />

                <div class="mb-4">
                    <label class="block text-sm font-semibold text-gray-700 mb-1">Ngân hàng nhận tiền <span class="text-red-500">*</span></label>
                    <select name="BankName" required class="w-full border border-gray-300 rounded-lg px-3 py-2.5 text-sm focus:ring-2 focus:ring-yellow-500 focus:outline-none">
                        <option value="">-- Chọn Ngân hàng --</option>
                        <option value="VietinBank">VietinBank (Ngân hàng Công Thương)</option>
                        <option value="Vietcombank">Vietcombank (Ngân hàng Ngoại Thương)</option>
                        <option value="BIDV">BIDV (Ngân hàng Đầu tư và Phát triển)</option>
                        <option value="Agribank">Agribank (Ngân hàng Nông nghiệp)</option>
                        <option value="MBBank">MBBank (Ngân hàng Quân Đội)</option>
                        <option value="Techcombank">Techcombank (Kỹ Thương)</option>
                        <option value="VPBank">VPBank (Thịnh Vượng)</option>
                        <option value="ACB">ACB (Á Châu)</option>
                        <option value="TPBank">TPBank (Tiên Phong)</option>
                        <option value="Sacombank">Sacombank (Sài Gòn Thương Tín)</option>
                        <option value="VIB">VIB (Quốc Tế)</option>
                        <option value="SHB">SHB (Sài Gòn - Hà Nội)</option>
                    </select>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-4">
                    <div>
                        <label class="block text-sm font-semibold text-gray-700 mb-1">Số tài khoản <span class="text-red-500">*</span></label>
                        <input type="text" name="AccountNumber" required placeholder="Ví dụ: 108620022211" class="w-full border border-gray-300 rounded-lg px-3 py-2.5 text-sm focus:ring-2 focus:ring-yellow-500 focus:outline-none" />
                    </div>
                    <div>
                        <label class="block text-sm font-semibold text-gray-700 mb-1">Tên chủ tài khoản <span class="text-red-500">*</span></label>
                        <input type="text" name="AccountHolder" required placeholder="HOANG VAN A" class="w-full border border-gray-300 rounded-lg px-3 py-2.5 text-sm uppercase focus:ring-2 focus:ring-yellow-500 focus:outline-none" />
                    </div>
                </div>

                <div class="mb-6">
                    <label class="block text-sm font-semibold text-gray-700 mb-1">Lý do yêu cầu hoàn tiền <span class="text-red-500">*</span></label>
                    <textarea name="Reason" rows="3" required placeholder="Vui lòng nêu rõ lý do hủy phòng và yêu cầu hoàn tiền..." class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-yellow-500 focus:outline-none"></textarea>
                </div>

                <div class="flex gap-3">
                    <button type="button" onclick="closeRefundModal()" class="w-1/2 border border-gray-300 text-gray-700 font-bold py-3 rounded-xl hover:bg-gray-50 transition">Hủy bỏ</button>
                    <button type="submit" class="w-1/2 bg-red-600 hover:bg-red-700 text-white font-bold py-3 rounded-xl transition shadow-md">Gửi Yêu Cầu</button>
                </div>
            </form>
        </div>
    </div>

    <!-- ========================================================= -->
    <!-- MODAL XÁC NHẬN GỬI YÊU CẦU HOÀN TIỀN (THEO MÀU DỰ ÁN) -->
    <!-- ========================================================= -->
    <div id="customConfirmModal" class="fixed inset-0 bg-black/70 hidden justify-center items-center p-4 z-[60] transition-opacity duration-300 opacity-0">
        <div class="bg-white rounded-2xl max-w-sm w-full p-6 shadow-2xl text-center relative transform scale-95 transition-transform duration-300">
            <div class="w-14 h-14 mx-auto rounded-full bg-amber-100 text-amber-700 flex items-center justify-center text-xl mb-4">
                <i class="fas fa-triangle-exclamation"></i>
            </div>
            <h4 class="text-xl font-bold text-gray-900 mb-2">Xác Nhận Gửi Yêu Cầu</h4>
            <p class="text-gray-600 text-sm mb-6 leading-relaxed">Bạn có chắc chắn muốn gửi yêu cầu hoàn tiền cho đơn đặt phòng này không?</p>
            <div class="flex gap-3">
                <button type="button" onclick="closeCustomConfirmModal()" class="w-1/2 border border-gray-300 text-gray-700 font-bold py-2.5 rounded-xl hover:bg-gray-50 transition text-sm">Hủy</button>
                <button type="button" onclick="executeRefundSubmit()" class="w-1/2 bg-[#171006] hover:bg-black text-[#f5d77a] font-bold py-2.5 rounded-xl transition shadow-md text-sm">Xác Nhận</button>
            </div>
        </div>
    </div>

    <script>
        let refundFormToSubmit = null;

        function confirmRefundSubmit(event) {
            event.preventDefault();
            refundFormToSubmit = event.target;
            const modal = document.getElementById('customConfirmModal');
            modal.classList.remove('hidden');
            modal.classList.add('flex');
            setTimeout(() => {
                modal.classList.remove('opacity-0');
                modal.children[0].classList.remove('scale-95');
                modal.children[0].classList.add('scale-100');
            }, 10);
            return false;
        }

        function closeCustomConfirmModal() {
            const modal = document.getElementById('customConfirmModal');
            modal.classList.add('opacity-0');
            modal.children[0].classList.remove('scale-100');
            modal.children[0].classList.add('scale-95');
            setTimeout(() => {
                modal.classList.add('hidden');
                modal.classList.remove('flex');
            }, 300);
        }

        function executeRefundSubmit() {
            if (refundFormToSubmit) {
                const form = refundFormToSubmit;
                refundFormToSubmit = null;
                form.submit();
            }
        }

        function openRefundModal(bookingId, roomName, paidAmount, refundRate, refundAmount) {
            document.getElementById('modalBookingId').innerText = '#' + bookingId;
            document.getElementById('modalRoomName').innerText = roomName;
            document.getElementById('modalPaidAmount').innerText = Number(paidAmount).toLocaleString('vi-VN') + 'đ';
            document.getElementById('modalRefundRate').innerText = refundRate + '%';
            document.getElementById('modalRefundAmount').innerText = Number(refundAmount).toLocaleString('vi-VN') + 'đ';
            document.getElementById('inputBookingId').value = bookingId;

            const modal = document.getElementById('refundModal');
            modal.classList.remove('hidden');
            modal.classList.add('flex');
            setTimeout(() => {
                modal.classList.remove('opacity-0');
                modal.children[0].classList.remove('scale-95');
                modal.children[0].classList.add('scale-100');
            }, 10);
        }

        function closeRefundModal() {
            const modal = document.getElementById('refundModal');
            modal.classList.add('opacity-0');
            modal.children[0].classList.remove('scale-100');
            modal.children[0].classList.add('scale-95');
            setTimeout(() => {
                modal.classList.add('hidden');
                modal.classList.remove('flex');
            }, 300);
        }
    </script>


</body>

</html>