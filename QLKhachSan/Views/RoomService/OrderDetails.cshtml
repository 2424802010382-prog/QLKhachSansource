@model QLKhachSan.Models.RoomServiceOrder
@using QLKhachSan.Models
@using QLKhachSan.Services
@{
    Layout = null;
    ViewBag.Title = "Chi tiết đơn dịch vụ #" + Model.OrderId + " - Luxury Hotel";
    var events = ViewBag.Events as IEnumerable<RoomServiceEvent> ?? Enumerable.Empty<RoomServiceEvent>();
    var bank = ViewBag.Bank as BankPaymentSettings ?? BankPaymentSettings.Load();
    bool canPay = Model.Total > 0 && Model.PaymentStatus != "Đã thanh toán" && Model.Status != "Từ chối";
    bool pending = Model.PaymentStatus == "Chờ xác minh thanh toán";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400..900;1,400..900&family=Plus+Jakarta+Sans:ital,wght@0,300..800;1,300..800&display=swap" rel="stylesheet">
    <style>
        body {
            background: #f7f2e8;
            color: #2b2117;
            font-family: 'Plus Jakarta Sans', Arial, sans-serif;
            margin: 0;
        }

        .font-serif {
            font-family: 'Playfair Display', Georgia, serif !important;
        }

        .luxury-navbar {
            background: rgba(25, 18, 12, 0.94) !important;
            box-shadow: 0 5px 25px rgba(0, 0, 0, 0.28) !important;
            border-bottom: 1px solid rgba(212, 175, 55, 0.55);
            backdrop-filter: blur(12px);
        }

        .luxury-logo {
            color: #f5d77a !important;
            letter-spacing: 2px;
        }

        .luxury-crown-logo {
            width: 50px;
            height: 50px;
            border: 2px solid #d4af37;
            color: #f5d77a;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 22px;
            border-radius: 12px;
            background: rgba(212, 175, 55, 0.1);
        }

        .luxury-menu-link {
            color: #f8f3e8 !important;
            transition: all 0.2s ease;
        }

        .luxury-menu-link:hover, .luxury-menu-link.active {
            color: #f5d77a !important;
            background: rgba(212, 175, 55, 0.15) !important;
        }

        .luxury-outline-button {
            color: #f5d77a !important;
            border: 1px solid #d4af37;
            background: transparent;
            transition: all 0.25s ease;
        }

        .luxury-outline-button:hover {
            background: #d4af37;
            color: #21170f !important;
        }

        .luxury-gold-button {
            background: linear-gradient(135deg, #d4af37, #f0c85b) !important;
            color: #24180e !important;
            border: 1px solid #e0bd4f;
            box-shadow: 0 5px 15px rgba(180, 135, 20, 0.25);
            transition: all 0.25s ease;
        }

        .luxury-gold-button:hover {
            background: linear-gradient(135deg, #b99224, #e0b53f) !important;
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(180, 135, 20, 0.35);
        }

        .luxury-footer {
            background-image: linear-gradient(rgba(20, 13, 8, 0.94), rgba(20, 13, 8, 0.97)), url('/images/luxury-hotel-hero.png');
            background-size: cover;
            background-position: center;
            border-top: 2px solid #d4af37;
            color: white;
        }

        .footer-link {
            color: #d1d5db;
            transition: color 0.2s;
        }

        .footer-link:hover {
            color: #f5d77a;
        }
    </style>
</head>

<body class="min-h-screen flex flex-col justify-between">
    @Html.Partial("~/Views/Shared/_SecurityClient.cshtml")

    <!-- HEADER NAVBAR -->
    <nav class="luxury-navbar text-white px-4 py-4 sticky top-0 z-50">
        <div class="container mx-auto flex justify-between items-center">
            <a href="@Url.Action("Index", "Home")" class="flex items-center gap-3">
                <div class="luxury-crown-logo"><i class="fas fa-crown"></i></div>
                <div>
                    <h1 class="luxury-logo text-xl md:text-2xl font-extrabold">LUXURY HOTEL</h1>
                    <p class="text-yellow-300 text-[10px] tracking-[3px]">LUXURY &amp; COMFORT</p>
                </div>
            </a>

            <!-- Desktop Navigation Menu -->
            <div class="hidden xl:flex items-center gap-2">
                <a href="@Url.Action("Index", "Home")" class="luxury-menu-link px-3.5 py-2 rounded-lg text-sm font-semibold flex items-center gap-1.5"><i class="fas fa-house text-yellow-400"></i> Trang chủ</a>
                @if (ViewBag.Manage != true)
                {
                    <a href="@Url.Action("Index", "RoomService")" class="luxury-menu-link active px-3.5 py-2 rounded-lg text-sm font-semibold flex items-center gap-1.5"><i class="fas fa-concierge-bell text-yellow-400"></i> Dịch vụ phòng</a>
                }

                @if (Session["UserId"] == null)
                {
                    <div class="flex items-center gap-2 pl-3">
                        <a href="@Url.Action("Login", "Account")" class="luxury-outline-button px-4 py-2 rounded-lg text-sm font-bold"><i class="fas fa-right-to-bracket mr-1"></i> Đăng nhập</a>
                        <a href="@Url.Action("Register", "Account")" class="luxury-gold-button px-4 py-2 rounded-lg text-sm font-bold"><i class="fas fa-user-plus mr-1"></i> Đăng ký</a>
                    </div>
                }
                else
                {
                    <div class="flex items-center gap-3 bg-black/40 p-1.5 rounded-full px-4 border border-yellow-500/40 ml-2">
                        @if (Session["Role"] != null && Session["Role"].ToString() == "Admin")
                        {
                            <a href="@Url.Action("Index", "Admin")" class="text-yellow-200 hover:text-yellow-400 text-xs font-semibold whitespace-nowrap flex items-center gap-1"><i class="fas fa-hotel"></i> Quản lý khách sạn</a>
                            <span class="text-yellow-500">|</span>
                        }
                        @if (Session["Role"] != null && Session["Role"].ToString() == "Staff")
                        {
                            <a href="@Url.Action("Index", "Staff")" class="text-yellow-200 hover:text-yellow-400 text-xs font-semibold whitespace-nowrap flex items-center gap-1"><i class="fas fa-gauge-high"></i> Dashboard</a>
                            <span class="text-yellow-500">|</span>
                        }
                        @if (Session["Role"] == null || (Session["Role"].ToString() != "Admin" && Session["Role"].ToString() != "Staff"))
                        {
                            <a href="@Url.Action("Index", "BookingHistory")" class="text-yellow-200 hover:text-yellow-400 text-xs font-semibold whitespace-nowrap"><i class="fas fa-clock-rotate-left mr-1"></i> Lịch sử</a>
                            <span class="text-yellow-500">|</span>
                        }
                        <a href="@Url.Action("Profile", "Account")" class="text-yellow-200 hover:text-yellow-400 text-xs font-semibold whitespace-nowrap"><i class="fas fa-user-gear mr-1"></i> Tài khoản</a>
                        <span class="text-yellow-500">|</span>
                        <span class="font-semibold text-white text-xs"><i class="fas fa-user-circle text-yellow-300 text-base mr-1"></i>@(Session["FullName"] ?? Session["Username"])</span>
                        <a href="#" onclick="openLuxuryLogoutModal(event); return false;" title="Đăng xuất" class="bg-red-500 hover:bg-red-600 text-white text-xs px-2.5 py-1 rounded-full"><i class="fas fa-sign-out-alt"></i></a>
                    </div>
                }
            </div>

            <!-- Mobile Menu Toggle Button -->
            <button type="button" onclick="toggleMobileMenu()" class="xl:hidden text-yellow-300 text-2xl p-2 focus:outline-none">
                <i class="fas fa-bars" id="mobileMenuIcon"></i>
            </button>
        </div>

        <!-- Mobile Menu Dropdown -->
        <div id="mobileMenu" class="hidden absolute top-full left-0 w-full bg-[#241c17]/95 backdrop-blur-md border-b border-[#d4af37]/40 shadow-2xl p-5 flex flex-col gap-3 xl:hidden z-50 text-white max-h-[85vh] overflow-y-auto">
            <a href="@Url.Action("Index", "Home")" class="py-2.5 px-3 rounded hover:bg-white/10 font-semibold text-sm flex items-center gap-2"><i class="fas fa-house text-yellow-400"></i> Trang chủ</a>
            <a href="@Url.Action("Index", "RoomService")" class="py-2.5 px-3 rounded bg-white/10 text-yellow-300 font-semibold text-sm flex items-center gap-2"><i class="fas fa-concierge-bell text-yellow-400"></i> Dịch vụ phòng</a>
            <a href="@Url.Action("Index", "RoomService")" class="py-2.5 px-3 rounded bg-white/10 text-yellow-300 font-semibold text-sm flex items-center gap-2"><i class="fas fa-concierge-bell text-yellow-400"></i> Dịch vụ phòng</a>
            <a href="@Url.Action("Index", "Restaurant")" class="py-2.5 px-3 rounded hover:bg-white/10 font-semibold text-sm flex items-center gap-2"><i class="fas fa-utensils text-yellow-400"></i> Đặt món ăn</a>

            <div class="border-t border-white/10 pt-3 mt-1 flex flex-col gap-2">
                @if (Session["UserId"] == null)
                {
                    <a href="@Url.Action("Login", "Account")" class="w-full text-center py-2.5 bg-transparent border border-yellow-500 text-yellow-300 font-semibold rounded-lg text-sm"><i class="fas fa-right-to-bracket mr-1"></i> Đăng nhập</a>
                    <a href="@Url.Action("Register", "Account")" class="w-full text-center py-2.5 bg-gradient-to-r from-[#d4af37] to-[#f5d77a] text-[#21170f] font-bold rounded-lg text-sm"><i class="fas fa-user-plus mr-1"></i> Đăng ký</a>
                }
                else
                {
                    <div class="text-yellow-300 text-sm font-semibold py-1"><i class="fas fa-user-circle mr-1"></i> Xin chào, @(Session["FullName"] ?? Session["Username"])</div>
                    if (Session["Role"] != null && Session["Role"].ToString() == "Admin")
                    {
                        <a href="@Url.Action("Index", "Admin")" class="py-2 px-3 rounded hover:bg-white/10 text-yellow-200 text-sm font-semibold flex items-center gap-2"><i class="fas fa-hotel"></i> Quản lý khách sạn</a>
                    }
                    if (Session["Role"] == null || (Session["Role"].ToString() != "Admin" && Session["Role"].ToString() != "Staff"))
                    {
                        <a href="@Url.Action("Index", "BookingHistory")" class="py-2 px-3 rounded hover:bg-white/10 text-yellow-200 text-sm font-semibold flex items-center gap-2"><i class="fas fa-clock-rotate-left"></i> Lịch sử đặt phòng</a>
                    }
                    <a href="@Url.Action("Profile", "Account")" class="py-2 px-3 rounded hover:bg-white/10 text-yellow-200 text-sm font-semibold flex items-center gap-2"><i class="fas fa-user-gear"></i> Tài khoản</a>
                    <a href="#" onclick="openLuxuryLogoutModal(event); return false;" class="py-2.5 px-3 rounded bg-red-600 text-white text-center font-bold text-sm"><i class="fas fa-right-from-bracket mr-1"></i> Đăng xuất</a>
                }
            </div>
        </div>
    </nav>

    <!-- BREADCRUMB & BACK HEADER -->
    <div class="bg-[#153044] text-white py-6 border-b border-yellow-500/30">
        <div class="container mx-auto px-4 flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
            <div class="flex items-center gap-2 text-xs md:text-sm text-gray-300 flex-wrap">
                <a href="@Url.Action("Index", "Home")" class="hover:text-yellow-300 transition">Trang chủ</a>
                <i class="fas fa-chevron-right text-[10px] text-yellow-500"></i>
                @if (Session["Role"] != null && Session["Role"].ToString() == "Staff")
                {
                    <a href="@Url.Action("Index", "Staff")" class="hover:text-yellow-300 transition">Trang nhân viên</a>
                    <i class="fas fa-chevron-right text-[10px] text-yellow-500"></i>
                }
                else if (Session["Role"] != null && Session["Role"].ToString() == "Admin")
                {
                    <a href="@Url.Action("Index", "Admin")" class="hover:text-yellow-300 transition">Quản trị</a>
                    <i class="fas fa-chevron-right text-[10px] text-yellow-500"></i>
                }
                else
                {
                    <a href="@Url.Action("Index", "RoomService")" class="hover:text-yellow-300 transition">Dịch vụ phòng</a>
                    <i class="fas fa-chevron-right text-[10px] text-yellow-500"></i>
                }
                <a href="@Url.Action("Orders")" class="hover:text-yellow-300 transition">Danh sách yêu cầu</a>
                <i class="fas fa-chevron-right text-[10px] text-yellow-500"></i>
                <span class="text-yellow-400 font-bold">Đơn dịch vụ #@Model.OrderId</span>
            </div>

            <a href="@Url.Action("Orders")" class="inline-flex items-center gap-2 text-xs font-bold text-yellow-300 bg-white/10 hover:bg-white/20 border border-yellow-500/40 px-4 py-2 rounded-xl transition">
                <i class="fas fa-arrow-left"></i> Quay lại danh sách yêu cầu
            </a>
        </div>
    </div>

    <!-- MAIN CONTENT CONTAINER -->
    <main class="container mx-auto px-4 py-10 flex-grow">
        <div class="max-w-4xl mx-auto space-y-8">

            <!-- ORDER HEADER BANNER -->
            <div class="bg-gradient-to-r from-[#153044] to-[#1b3a4e] text-white rounded-3xl p-8 shadow-xl border border-yellow-500/30 flex flex-col md:flex-row justify-between items-start md:items-center gap-6">
                <div>
                    <p class="text-xs font-bold uppercase tracking-[3px] text-[#dfc48d] mb-1">LUXURY HOTEL &bull; SERVICE ORDER</p>
                    <h1 class="font-serif font-bold text-3xl text-white mb-2">Đơn dịch vụ #@Model.OrderId</h1>
                    <p class="text-gray-200 text-base font-semibold">@Model.ServiceName</p>
                </div>

                <div class="flex flex-wrap gap-2.5">
                    <span class="bg-white/15 backdrop-blur-md text-white px-4 py-2 rounded-full text-xs font-bold border border-white/20">
                        Trạng thái: @Model.Status
                    </span>
                    <span id="paymentStatus" class="px-4 py-2 rounded-full text-xs font-bold text-white shadow-md @(Model.PaymentStatus == "Đã thanh toán" ? "bg-emerald-600/90" : "bg-amber-600/90")">
                        Thanh toán: @Model.PaymentStatus
                    </span>
                </div>
            </div>

            <!-- DETAILED INFORMATION CARD -->
            <div class="bg-white border border-[#e8ded0] rounded-3xl p-8 shadow-md">
                <h2 class="font-serif font-bold text-xl text-[#153044] mb-6 pb-4 border-b border-gray-100 flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-yellow-500/10 flex items-center justify-center text-[#b48316]">
                        <i class="fas fa-receipt"></i>
                    </div>
                    Thông Tin Chi Tiết Đơn Dịch Vụ
                </h2>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-sm text-gray-700">
                    <div class="space-y-3 bg-[#fcf9f2] p-5 rounded-2xl border border-[#e8ded0]/60">
                        <p class="flex justify-between"><span class="text-gray-500 font-medium">Khách hàng:</span> <strong class="text-gray-900">@Model.CustomerName</strong></p>
                        <p class="flex justify-between"><span class="text-gray-500 font-medium">Phòng số:</span> <strong class="text-gray-900">@Model.RoomNumber (Booking #@Model.BookingId)</strong></p>
                        <p class="flex justify-between"><span class="text-gray-500 font-medium">Thời gian tạo:</span> <strong class="text-gray-900">@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</strong></p>
                    </div>

                    <div class="space-y-3 bg-[#fcf9f2] p-5 rounded-2xl border border-[#e8ded0]/60">
                        <p class="flex justify-between"><span class="text-gray-500 font-medium">Giờ phục vụ:</span> <strong class="text-gray-900">@Model.UseAt.ToString("dd/MM/yyyy HH:mm")</strong></p>
                        <p class="flex justify-between"><span class="text-gray-500 font-medium">Số lượng:</span> <strong class="text-gray-900">@Model.Quantity @Model.Unit &times; @Model.UnitPrice.ToString("N0") đ</strong></p>
                        <p class="flex justify-between items-center pt-1 border-t border-yellow-500/20"><span class="text-gray-500 font-medium">Tổng tiền:</span> <strong class="text-lg text-emerald-700 font-extrabold">@Model.Total.ToString("N0") đ</strong></p>
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.Note))
                {
                    <div class="mt-6 p-4 bg-gray-50 rounded-2xl border border-gray-100 text-sm text-gray-600">
                        <strong class="text-gray-800 font-bold block mb-1"><i class="fas fa-comment-dots text-amber-600 mr-1.5"></i> Ghi chú yêu cầu:</strong>
                        @Model.Note
                    </div>
                }
            </div>

            <!-- PAYMENT QR SECTION -->
            @if (canPay)
            {
                <div class="bg-white border border-[#e8ded0] rounded-3xl p-8 shadow-md" data-transfer-instructions>
                    <h2 class="font-serif font-bold text-xl text-[#153044] mb-4 flex items-center gap-3">
                        <div class="w-10 h-10 rounded-xl bg-yellow-500/10 flex items-center justify-center text-[#b48316]">
                            <i class="fas fa-qrcode"></i>
                        </div>
                        Thanh Toán Trực Tuyến Qua QR (SePay / VietQR)
                    </h2>

                    <p class="text-sm text-gray-600 mb-6 bg-amber-50 border border-amber-200 p-4 rounded-xl text-amber-900">
                        <i class="fas fa-qrcode mr-2 text-amber-600"></i> Quét mã QR bằng ứng dụng ngân hàng. Số tiền và nội dung chuyển khoản sẽ được điền tự động.
                    </p>

                    @if (ViewBag.QrUrl != null)
                    {
                        <div class="text-center my-6 bg-[#fcf9f2] p-6 rounded-2xl border border-[#e8ded0] max-w-sm mx-auto shadow-inner">
                            <img src="@ViewBag.QrUrl" alt="QR thanh toán dịch vụ" class="mx-auto max-w-[260px] rounded-xl shadow-md border border-gray-200" />
                        </div>
                    }
                    else
                    {
                        <div class="p-4 bg-red-50 text-red-700 rounded-xl text-sm mb-6">
                            <i class="fas fa-triangle-exclamation mr-1.5"></i> QR chưa được cấu hình đầy đủ. Vui lòng liên hệ lễ tân để được hướng dẫn.
                        </div>
                    }

                    <div class="bg-gray-50 p-5 rounded-2xl border border-gray-200 space-y-3 text-sm mb-6">
                        <div class="flex justify-between gap-3"><span class="text-gray-500 font-medium">Ngân hàng:</span> <strong class="text-gray-900">@bank.BankName</strong></div>
                        <div class="flex justify-between gap-3 flex-wrap"><span class="text-gray-500 font-medium">Số tài khoản:</span> <span><strong id="accountNumber" class="text-gray-900">@bank.AccountNumber</strong> <button type="button" onclick="copyPaymentText('accountNumber', this)" class="text-indigo-600 underline ml-2 font-semibold">Sao chép</button></span></div>
                        <div class="flex justify-between gap-3"><span class="text-gray-500 font-medium">Chủ tài khoản:</span> <strong class="text-gray-900">@bank.AccountName</strong></div>
                        <div class="flex justify-between gap-3"><span class="text-gray-500 font-medium">Số tiền:</span> <strong class="text-red-600 font-bold">@Model.Total.ToString("N0") đ</strong></div>
                        <div class="flex justify-between gap-3 flex-wrap"><span class="text-gray-500 font-medium">Nội dung CK:</span> <span><strong id="transferContent" class="text-emerald-700 font-bold">@ViewBag.PaymentContent</strong> <button type="button" onclick="copyPaymentText('transferContent', this)" class="text-indigo-600 underline ml-2 font-semibold">Sao chép</button></span></div>
                    </div>

                    <div class="text-center">
                        <button type="button" id="reviewButton" onclick="requestTransferReview(this)" disabled="@pending" class="text-xs font-bold text-indigo-600 underline hover:text-indigo-800 transition">
                            @(pending ? "Đã gửi yêu cầu kiểm tra đối soát" : "Gửi yêu cầu nhân viên kiểm tra đối soát thủ công")
                        </button>
                    </div>
                </div>
            }

            <!-- AUTOMATIC PAYMENT STATUS POLLING PANEL -->
            <div id="automaticPayment" data-status-url="@Url.Action("CheckPaymentStatus", "RoomService", new { id = Model.OrderId })"
                 data-success-url="@(canPay ? Url.Action("Success", "RoomService", new { id = Model.OrderId }) : "")"
                 data-amount="@Model.Total.ToString(System.Globalization.CultureInfo.InvariantCulture)" data-enabled="@bank.Ready.ToString().ToLowerInvariant()"
                 class="bg-white border border-[#e8ded0] rounded-3xl p-6 shadow-md text-center">
                <p id="automaticPaymentMessage" role="status" aria-live="polite" class="font-bold text-sm text-emerald-700">Đang kiểm tra trạng thái thanh toán tự động...</p>
            </div>

            <!-- ADMIN/STAFF PAYMENT CONFIRMATION -->
            @if (ViewBag.CanPay == true && canPay)
            {
                <div class="bg-white border border-[#e8ded0] rounded-3xl p-8 shadow-md">
                    @using (Html.BeginForm("ConfirmPayment", "RoomService", FormMethod.Post, new { @class = "space-y-4" }))
                    {
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.OrderId" />
                        <h2 class="font-serif font-bold text-xl text-[#153044] mb-4 flex items-center gap-3">
                            <div class="w-10 h-10 rounded-xl bg-emerald-500/10 flex items-center justify-center text-emerald-600">
                                <i class="fas fa-check-circle"></i>
                            </div>
                            Đối Soát Thanh Toán (Dành cho Nhân viên)
                        </h2>

                        <div>
                            <label class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-2">Mã giao dịch ngân hàng đã kiểm tra <span class="text-red-500">*</span></label>
                            <input name="evidence" minlength="3" maxlength="200" required placeholder="Nhập mã GD ngân hàng..." class="w-full px-4 py-3 bg-white border border-[#cbd5e1] rounded-xl text-sm focus:outline-none focus:border-[#d4af37]" />
                        </div>

                        <div>
                            <label class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-2">Số tiền thực nhận <span class="text-red-500">*</span></label>
                            <input name="amount" type="number" min="1" required value="@Model.Total" class="w-full px-4 py-3 bg-white border border-[#cbd5e1] rounded-xl text-sm focus:outline-none focus:border-[#d4af37]" />
                        </div>

                        <label class="flex items-center gap-3 pt-2 text-sm font-semibold text-gray-800 cursor-pointer">
                            <input type="checkbox" name="verified" value="true" required class="w-5 h-5 text-[#153044] rounded border-gray-300" />
                            Tôi đã kiểm tra giao dịch thực tế đúng tài khoản, nội dung và số tiền của đơn này.
                        </label>

                        <button type="submit" class="bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-sm px-6 py-3.5 rounded-xl shadow-md transition flex items-center gap-2 mt-4">
                            <i class="fas fa-check"></i> Xác Nhận Đã Nhận Tiền
                        </button>
                    }
                </div>
            }

            <!-- STAFF STATUS TRANSITION -->
            @if (ViewBag.CanProcess == true)
            {
                var nextStatuses = new[] { "Đã xác nhận", "Đang thực hiện", "Hoàn thành", "Từ chối" }.Where(x => RoomServiceRules.CanTransition(Model.Status, x)).ToList();
                if (nextStatuses.Any())
                {
                    <div class="bg-[#faf8f3] border border-[#e8ded0] rounded-3xl p-8 shadow-md">
                        <h2 class="font-serif font-bold text-xl text-[#153044] mb-4 flex items-center gap-3">
                            <div class="w-10 h-10 rounded-xl bg-amber-500/10 flex items-center justify-center text-amber-600">
                                <i class="fas fa-tasks"></i>
                            </div>
                            Cập Nhật Trạng Thái Xử Lý Đơn
                        </h2>

                        <div class="flex flex-wrap gap-4 mt-4">
                            @foreach (var next in nextStatuses)
                            {
                                using (Html.BeginForm("Transition", "RoomService", FormMethod.Post, new { @class = "bg-white p-4 rounded-2xl border border-gray-200 shadow-sm flex flex-col gap-3" }))
                                {
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@Model.OrderId" />
                                    <input type="hidden" name="status" value="@next" />

                                    if (next == "Từ chối")
                                    {
                                        <div>
                                            <label class="block text-xs font-bold text-gray-700 mb-1">Lý do từ chối <span class="text-red-500">*</span></label>
                                            <input name="reason" maxlength="800" required placeholder="Nhập lý do..." class="px-3 py-2 border border-gray-300 rounded-lg text-xs" />
                                        </div>
                                    }

                                    <button type="submit" class="font-bold text-xs px-5 py-2.5 rounded-xl text-white shadow transition @(next == "Từ chối" ? "bg-red-600 hover:bg-red-700" : next == "Hoàn thành" ? "bg-emerald-600 hover:bg-emerald-700" : "bg-[#153044] hover:bg-[#1f425b]")">
                                        Chuyển sang: @next
                                    </button>
                                }
                            }
                        </div>
                    </div>
                }
            }

            <!-- HISTORY & EVENTS TIMELINE -->
            <div class="bg-white border border-[#e8ded0] rounded-3xl p-8 shadow-md">
                <h2 class="font-serif font-bold text-xl text-[#153044] mb-6 pb-4 border-b border-gray-100 flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-yellow-500/10 flex items-center justify-center text-[#b48316]">
                        <i class="fas fa-history"></i>
                    </div>
                    Lịch Sử Xử Lý & Thông Báo
                </h2>

                <ul class="space-y-4 pl-2">
                    @foreach (var e in events)
                    {
                        <li class="relative pl-6 border-l-2 border-[#d4af37]">
                            <span class="text-xs text-gray-400 font-medium block mb-1">
                                <i class="far fa-clock mr-1"></i> @e.CreatedAt.ToString("dd/MM/yyyy HH:mm:ss") &bull; Tài khoản #@e.ActorId
                            </span>
                            <p class="text-sm text-gray-800 font-semibold">@e.Message</p>
                        </li>
                    }
                </ul>
            </div>

        </div>
    </main>

    <div class="rs hidden"><p class="rs-live" data-url="@Url.Action("Updates")" role="status"></p></div>

    <!-- FOOTER -->
    <footer class="luxury-footer text-gray-200 py-12 px-4 mt-auto">
        <div class="container mx-auto grid grid-cols-1 md:grid-cols-4 gap-10">
            <div class="col-span-1 md:col-span-2">
                <div class="flex items-center gap-3 mb-5">
                    <div class="luxury-crown-logo small"><i class="fas fa-crown"></i></div>
                    <div>
                        <h1 class="text-2xl font-serif font-bold text-white">LUXURY HOTEL</h1>
                        <p class="text-yellow-300 text-xs tracking-[3px]">LUXURY &amp; COMFORT</p>
                    </div>
                </div>
                <p class="text-sm leading-7 max-w-xl text-gray-300">Mang lại trải nghiệm kỳ nghỉ đẳng cấp quốc tế với dịch vụ 5 sao hoàn hảo. Sự hài lòng của quý khách là ưu tiên hàng đầu của chúng tôi.</p>
            </div>
            <div>
                <h5 class="font-serif font-bold text-white text-xl mb-4">Liên kết</h5>
                <ul class="space-y-3 text-sm">
                    <li><a href="@Url.Action("Index", "Home")" class="footer-link">Trang chủ</a></li>
                    <li><a href="@Url.Action("Index", "Room")" class="footer-link">Phòng</a></li>
                    <li><a href="@Url.Action("Index", "Room")" class="footer-link">Đặt phòng</a></li>
                    <li><a href="@Url.Action("Index", "RoomService")" class="footer-link">Dịch vụ</a></li>
                </ul>
            </div>
            <div>
                <h5 class="font-serif font-bold text-white text-xl mb-4">Liên hệ</h5>
                <p class="text-sm mb-3"><i class="fas fa-map-marker-alt mr-2 text-yellow-400"></i>123 Đường ABC, Quận 1, TP.HCM</p>
                <p class="text-sm mb-3"><i class="fas fa-phone-alt mr-2 text-yellow-400"></i>Hotline: 1900 1234</p>
                <p class="text-sm"><i class="fas fa-envelope mr-2 text-yellow-400"></i>info@luxuryhotel.com</p>
            </div>
        </div>
        <div class="container mx-auto border-t border-yellow-500/30 mt-10 pt-6 text-center text-xs text-gray-500">&copy; 2026 Luxury Hotel. All rights reserved.</div>
    </footer>

    <!-- LOGOUT MODAL -->
    <div id="luxuryLogoutModal" class="fixed inset-0 bg-black/75 hidden justify-center items-center p-4 z-50">
        <div class="bg-[#241c17] text-white border border-[#d4af37]/60 rounded-2xl max-w-md w-full p-6 text-center shadow-2xl">
            <div class="w-16 h-16 mx-auto rounded-full bg-red-500/20 text-red-400 flex items-center justify-center text-2xl mb-4 border border-red-500/40">
                <i class="fas fa-sign-out-alt"></i>
            </div>
            <h3 class="font-serif font-bold text-2xl text-yellow-300 mb-2">Xác nhận đăng xuất</h3>
            <p class="text-gray-300 text-sm mb-6">Bạn có chắc chắn muốn đăng xuất khỏi hệ thống Luxury Hotel?</p>
            <div class="flex gap-3 justify-center">
                <button type="button" onclick="closeLuxuryLogoutModal()" class="px-5 py-2.5 rounded-xl border border-gray-500 text-gray-300 font-bold text-xs hover:bg-white/10">Hủy bỏ</button>
                <a href="@Url.Action("Logout", "Account")" class="px-5 py-2.5 rounded-xl bg-red-600 hover:bg-red-700 text-white font-bold text-xs shadow-lg">Đăng xuất</a>
            </div>
        </div>
    </div>

    <script>
        async function copyPaymentText(id, button) {
            try {
                await navigator.clipboard.writeText(document.getElementById(id).textContent);
                button.textContent = 'Đã sao chép';
                setTimeout(() => button.textContent = 'Sao chép', 2000);
            } catch (error) {
                alert('Không thể sao chép tự động.');
            }
        }
        async function requestTransferReview(button) {
            if (button.disabled) return;
            button.disabled = true;
            try {
                const response = await fetch('@Url.Action("RequestBankTransferReview", "RoomService", new { id = Model.OrderId })', { method: 'POST', credentials: 'same-origin' });
                if (!response.ok) throw new Error('Không thể gửi yêu cầu.');
                const result = await response.json();
                if (!result.success) throw new Error(result.message);
                button.textContent = 'Đã gửi yêu cầu xác minh';
                alert(result.message);
            } catch (error) {
                alert(error.message || 'Không thể kết nối máy chủ.');
                button.disabled = false;
            }
        }
        function toggleMobileMenu() {
            var menu = document.getElementById('mobileMenu');
            menu.classList.toggle('hidden');
        }
        function openLuxuryLogoutModal(e) {
            if (e) e.preventDefault();
            var modal = document.getElementById('luxuryLogoutModal');
            modal.classList.remove('hidden');
            modal.classList.add('flex');
        }
        function closeLuxuryLogoutModal() {
            var modal = document.getElementById('luxuryLogoutModal');
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        }
    </script>
    <script src="@Url.Content("~/Scripts/payment-status.js")"></script>
</body>
</html>
