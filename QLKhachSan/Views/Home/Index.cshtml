    <!-- MODAL ĐĂNG KÝ -->
    <!-- ========================================================= -->
    <!-- ========================================================= -->
    <!-- MODAL ĐĂNG KÝ -->
    <!-- ========================================================= -->


    <div id="registerModal"
         class="fixed inset-0 bg-black/70 hidden
            justify-center items-center
            p-3 sm:p-4 z-50
            overflow-y-auto
            transition-opacity duration-300 opacity-0">

        <div class="bg-white rounded-2xl
                w-full max-w-2xl
                p-5 sm:p-8 md:p-10
                shadow-2xl relative
                transform scale-90
                transition-transform duration-300
                overflow-y-auto overflow-x-hidden
                mx-auto">



            <!-- ================================================= -->
            <!-- NÚT ĐÓNG -->
            <!-- ================================================= -->

            <button type="button"
                    onclick="closeRegisterModal()"
                    class="absolute top-5 right-5
                           text-gray-400
                           hover:text-gray-600">

                <i class="fas fa-times text-xl"></i>

            </button>


            <!-- ================================================= -->
            <!-- TIÊU ĐỀ -->
            <!-- ================================================= -->

            <div class="text-center mb-8">

                <i class="fas fa-user-plus
                          text-6xl
                          text-blue-600
                          mb-4">
                </i>


                <h2 class="text-3xl md:text-4xl
                           font-extrabold
                           text-gray-900">

                    ĐĂNG KÝ TÀI KHOẢN

                </h2>


                <p class="text-gray-500 mt-2">

                    Trở thành thành viên để nhận
                    nhiều ưu đãi đặc biệt!

                </p>

            </div>


            <!-- ================================================= -->
            <!-- THÔNG BÁO LỖI ĐĂNG KÝ -->
            <!-- ================================================= -->

            @if (TempData["RegisterError"] != null)
            {
                <div class="mb-5
                            rounded-lg
                            border border-red-200
                            bg-red-50
                            px-4 py-3
                            text-sm
                            text-red-700">

                    <i class="fas
                              fa-circle-exclamation
                              mr-2">
                    </i>

                    @TempData["RegisterError"]

                </div>
            }


            <!-- ================================================= -->
            <!-- FORM ĐĂNG KÝ -->
            <!-- ================================================= -->

            <form action="@Url.Action("Register", "Account")"
                  method="post">

                @Html.AntiForgeryToken()


                <!-- ============================================= -->
                <!-- HỌ VÀ TÊN -->
                <!-- ============================================= -->

                <div class="mb-5">

                    <label class="block
                                  text-sm
                                  font-semibold
                                  mb-2
                                  text-gray-700">

                        Họ và tên

                        <span class="text-red-500">
                            *
                        </span>

                    </label>


                    <input type="text"
                           id="regFullName"
                           name="fullName"
                           required
                           maxlength="100"
                           class="w-full
                                  border border-gray-300
                                  rounded-lg
                                  px-4 py-3
                                  text-sm
                                  focus:ring-2
                                  focus:ring-blue-500
                                  focus:outline-none
                                  transition"
                           placeholder="Ví dụ: Nguyễn Văn A">

                </div>


                <!-- ============================================= -->
                <!-- EMAIL -->
                <!-- ============================================= -->

                <div class="mb-5">

                    <label class="block
                                  text-sm
                                  font-semibold
                                  mb-2
                                  text-gray-700">

                        Email

                        <span class="text-red-500">
                            *
                        </span>

                    </label>


                    <input type="email"
                           id="regEmail"
                           name="email"
                           required
                           autocomplete="email"
                           class="w-full
                                  border border-gray-300
                                  rounded-lg
                                  px-4 py-3
                                  text-sm
                                  focus:ring-2
                                  focus:ring-blue-500
                                  focus:outline-none
                                  transition"
                           placeholder="abc@gmail.com">

                </div>


                <!-- ============================================= -->
                <!-- MẬT KHẨU -->
                <!-- ============================================= -->

                <div class="grid
                            grid-cols-1
                            md:grid-cols-2
                            gap-6
                            mb-6">


                    <!-- MẬT KHẨU -->

                    <div>

                        <label class="block
                                      text-sm
                                      font-semibold
                                      mb-2
                                      text-gray-700">

                            Mật khẩu

                            <span class="text-red-500">
                                *
                            </span>

                        </label>


                        <input type="password"
                               id="regPassword"
                               name="password"
                               required
                               minlength="6"
                               autocomplete="new-password"
                               class="w-full
                                      border border-gray-300
                                      rounded-lg
                                      px-4 py-3
                                      text-sm
                                      focus:ring-2
                                      focus:ring-blue-500
                                      focus:outline-none
                                      transition"
                               placeholder="Ít nhất 6 ký tự">

                    </div>


                    <!-- XÁC NHẬN MẬT KHẨU -->

                    <div>

                        <label class="block
                                      text-sm
                                      font-semibold
                                      mb-2
                                      text-gray-700">

                            Xác nhận mật khẩu

                            <span class="text-red-500">
                                *
                            </span>

                        </label>


                        <input type="password"
                               id="regConfirmPassword"
                               name="confirmPassword"
                               required
                               minlength="6"
                               autocomplete="new-password"
                               class="w-full
                                      border border-gray-300
                                      rounded-lg
                                      px-4 py-3
                                      text-sm
                                      focus:ring-2
                                      focus:ring-blue-500
                                      focus:outline-none
                                      transition"
                               placeholder="Nhập lại mật khẩu">


                        <p id="passwordError"
                           class="hidden
                                  text-red-500
                                  text-xs
                                  mt-1">

                            Mật khẩu xác nhận
                            không trùng khớp.

                        </p>

                    </div>

                </div>


                <!-- ============================================= -->
                <!-- ĐIỀU KHOẢN -->
                <!-- ============================================= -->

                <div class="mb-7">

                    <label class="flex
                                  items-start
                                  text-sm
                                  text-gray-600
                                  cursor-pointer">

                        <input type="checkbox"
                               id="agreeTerms"
                               required
                               class="h-5 w-5
                                      mt-0.5
                                      text-blue-600
                                      border-gray-300
                                      rounded
                                      mr-2">


                        <span>

                            Tôi đồng ý với

                            <a href="#"
                               onclick="return false;"
                               class="text-blue-600
                                      hover:underline">

                                Điều khoản &amp; Điều kiện

                            </a>

                            của khách sạn.

                        </span>

                    </label>

                </div>


                <!-- ============================================= -->
                <!-- NÚT ĐĂNG KÝ -->
                <!-- ============================================= -->

                <button type="submit"
                        class="w-full
                               bg-blue-600
                               text-white
                               font-bold
                               py-4
                               rounded-lg
                               hover:bg-blue-700
                               transition
                               shadow-lg">

                    <i class="fas
                              fa-user-plus
                              mr-2">
                    </i>

                    ĐĂNG KÝ NGAY

                </button>

            </form>


            <!-- ================================================= -->
            <!-- CHUYỂN SANG ĐĂNG NHẬP -->
            <!-- ================================================= -->

            <div class="text-center
                        mt-7
                        text-sm
                        border-t
                        pt-5">

                <p class="text-gray-600">

                    Đã có tài khoản?

                    <a href="#"
                       onclick="
                           closeRegisterModal();
                           openLoginModal();
                           return false;
                       "
                       class="text-blue-600
                              font-semibold
                              hover:underline">

                        Đăng nhập

                    </a>

                </p>

            </div>

        </div>

    </div>

    <!-- ========================================================= -->
    <!-- MODAL QUÊN MẬT KHẨU -->
    <!-- ========================================================= -->

    <div id="forgotPasswordModal"
