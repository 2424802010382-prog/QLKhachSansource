    ======================================================= */
    let savedProfilesList = [];

    async function loadSavedCustomerProfiles() {
        const container = document.getElementById('savedProfilesContainer');
        const select = document.getElementById('savedProfileSelect');
        if (!container || !select) return;

        const isLoggedIn = @(Session["UserId"] != null ? "true" : "false");
        if (!isLoggedIn) {
            container.classList.add('hidden');
            return;
        }

        try {
            const response = await fetch('@Url.Action("GetSavedCustomerProfiles", "Booking")');
            const data = await response.json();

            if (data && data.success && Array.isArray(data.profiles) && data.profiles.length > 0) {
                savedProfilesList = data.profiles;

                let html = '<option value="">-- Nhập thông tin người khác / mới --</option>';
                data.profiles.forEach((p, idx) => {
                    const labelText = typeof hotelEscapeHtml === 'function' ? hotelEscapeHtml(p.label) : p.label;
                    html += `<option value="${idx}">${labelText}</option>`;
                });
                select.innerHTML = html;
                container.classList.remove('hidden');

                // Mặc định chọn hồ sơ đầu tiên
                select.value = '0';
                applySavedProfile(data.profiles[0]);
            } else {
                container.classList.add('hidden');
            }
        } catch (err) {
            console.error('Lỗi khi tải thông tin khách hàng đã lưu:', err);
        }
    }

    function applySavedProfile(profile) {
        if (!profile) return;
        const nameInput = document.getElementById('customerName');
        const phoneInput = document.getElementById('customerPhone');
