        function formatDateForInput(date) {

            const year =
                date.getFullYear();

            const month =
                String(
                    date.getMonth() + 1
                ).padStart(2, '0');

            const day =
                String(
                    date.getDate()
                ).padStart(2, '0');


            return year
                + '-'
                + month
                + '-'
                + day;
        }


        // =======================================================
        // KHỞI TẠO NGÀY TỐI THIỂU
        // =======================================================

        function initializeBookingDates() {

            const checkInInput =
                document.getElementById(
                    'checkInDate'
                );

            const checkOutInput =
                document.getElementById(
                    'checkOutDate'
                );


            if (!checkInInput || !checkOutInput) {
                return;
            }


            // Hôm nay
            const today =
                new Date();

            today.setHours(
                0,
                0,
                0,
                0
            );


            // Ngày mai
            const tomorrow =
                new Date(today);

            tomorrow.setDate(
                tomorrow.getDate() + 1
            );


            // Ngày nhận sớm nhất = hôm nay
            checkInInput.min =
                formatDateForInput(today);


            // Ngày trả sớm nhất = ngày mai
            checkOutInput.min =
                formatDateForInput(tomorrow);
        }


        // =======================================================
        // KHI THAY ĐỔI NGÀY NHẬN PHÒNG
        // =======================================================

        function handleCheckInChange() {

            const checkInInput =
                document.getElementById(
                    'checkInDate'
                );

            const checkOutInput =
                document.getElementById(
                    'checkOutDate'
                );


            const checkIn =
                checkInInput.value;


            // Nếu chưa chọn ngày nhận
            if (!checkIn) {

                initializeBookingDates();

                updateBookingSummary();

                checkRoomAvailability();

                return;
            }


            // Chuyển ngày nhận thành Date
            const checkInDate =
                new Date(
                    checkIn + 'T00:00:00'
                );


            // Ngày trả tối thiểu
            // phải là ngày sau ngày nhận
            const minimumCheckOut =
                new Date(checkInDate);

            minimumCheckOut.setDate(
                minimumCheckOut.getDate() + 1
            );


            // Gán min cho ngày trả
            checkOutInput.min =
                formatDateForInput(
                    minimumCheckOut
                );


            // Nếu ngày trả đang nhỏ hơn
            // hoặc bằng ngày nhận
            // thì xóa ngày trả cũ
            if (
                checkOutInput.value &&
                checkOutInput.value <= checkIn
            ) {

                checkOutInput.value = '';

            }


            // Tính lại tiền
            updateBookingSummary();


            // Kiểm tra phòng trống
            checkRoomAvailability();
        }


