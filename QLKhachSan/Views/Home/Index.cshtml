                        <p class="luxury-section-description">Chúng tôi cam kết mang lại không gian sang trọng, tiện nghi bậc nhất và dịch vụ tận tâm, giúp kỳ nghỉ của bạn trở nên khó quên.</p>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                        <div onclick="window.location.href='@Url.Action("Index", "Room", new { isLuxury = true })'" class="feature-card luxury-feature-card group text-center cursor-pointer">
                            <div class="feature-image luxury-feature-image luxury-feature-image-1"><div class="feature-icon luxury-feature-icon"><i class="fas fa-star"></i></div></div>
                            <div class="feature-content"><h4 class="font-serif font-bold text-2xl mb-3">Phòng LUXURY</h4><p class="text-sm leading-6">Bộ sưu tập các phòng cao cấp Deluxe, Premium, Balcony, Suite & Tổng Thống sang trọng.</p><p class="feature-link mt-5">Xem danh sách phòng Luxury <i class="fas fa-arrow-right ml-1"></i></p></div>
                        </div>
                        <div onclick="openSupport24Modal()"
                             class="feature-card
                                luxury-feature-card
                                group
                                text-center
                                cursor-pointer">
                            <div class="feature-image luxury-feature-image luxury-feature-image-2"><div class="feature-icon luxury-feature-icon"><i class="fas fa-concierge-bell"></i></div></div>
                            <div class="feature-content"><h4 class="font-serif font-bold text-2xl mb-3">Phục vụ 24/7</h4><p class="text-sm leading-6">Đội ngũ nhân viên chuyên nghiệp, thân thiện luôn sẵn sàng hỗ trợ mọi yêu cầu.</p><p class="feature-link mt-5">Tìm hiểu thêm <i class="fas fa-arrow-right ml-1"></i></p></div>
                        </div>
                        <div class="feature-card luxury-feature-card group text-center cursor-pointer"
                             onclick="window.location.href='@Url.Action("Index", "Restaurant")'">
                            <div class="feature-image luxury-feature-image luxury-feature-image-3"><div class="feature-icon luxury-feature-icon"><i class="fas fa-utensils"></i></div></div>
                            <div class="feature-content"><h4 class="font-serif font-bold text-2xl mb-3">Ẩm thực thượng hạng</h4><p class="text-sm leading-6">Thưởng thức hương vị Á - Âu tinh tế từ các đầu bếp hàng đầu quốc tế.</p><p class="feature-link mt-5">Khám phá ẩm thực <i class="fas fa-arrow-right ml-1"></i></p></div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- KHÁM PHÁ CÁC LOẠI PHÒNG (8 LOẠI PHÒNG - SLIDER ẢNH & CHI TIẾT - CHỈ HIỆN KHI CHƯA ĐĂNG NHẬP) -->
            @if (Session["UserId"] == null)
            {
                <section class="discover-rooms-section bg-[#f8f5ee] py-16 px-4 border-t border-[#e7dbc1]">
                    <div class="container mx-auto">
                        <div class="text-center mb-12">
                            <p class="section-kicker text-amber-700 font-semibold tracking-widest text-xs uppercase mb-2">DANH MỤC PHÒNG NGHỈ</p>
                            <h3 class="luxury-section-title text-3xl md:text-4xl font-serif font-bold text-[#21170f]">Khám Phá Các Loại Phòng</h3>
                            <p class="luxury-section-description text-gray-600 max-w-2xl mx-auto mt-2 text-sm">
                                Xem bộ sưu tập hình ảnh chân thực của 8 loại phòng sang trọng tại Luxury Hotel trước khi chọn căn phòng ưng ý cho kỳ nghỉ của bạn.
                            </p>
                        </div>

                        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
                            @foreach (var room in Model)
                            {
                                var primaryImg = !string.IsNullOrEmpty(room.ImageUrl) ? room.ImageUrl : "https://images.unsplash.com/photo-1566665797739-1674de7a421a?q=80&w=900";
                                var imageList = new List<string> { primaryImg };
                                string rTypeUpper = (room.RoomType ?? "").ToUpper();

                                if (rTypeUpper.Contains("DELUXE"))
                                {
                                    imageList.Add("https://images.unsplash.com/photo-1591088398332-8a7791972843?q=80&w=900");
                                    imageList.Add("https://images.unsplash.com/photo-1582719478250-c89cae4dc85b?q=80&w=900");
                                }
                                else if (rTypeUpper.Contains("PREMIUM"))
                                {
                                    imageList.Add("https://images.unsplash.com/photo-1578683010236-d716f9a3f461?q=80&w=900");
                                    imageList.Add("https://images.unsplash.com/photo-1590490360182-c33d57733427?q=80&w=900");
                                }
                                else if (rTypeUpper.Contains("SUITE") || rTypeUpper.Contains("BALCONY"))
                                {
                                    imageList.Add("https://images.unsplash.com/photo-1582719478250-c89cae4dc85b?q=80&w=900");
                                    imageList.Add("https://images.unsplash.com/photo-1566665797739-1674de7a421a?q=80&w=900");
                                }
                                else if (rTypeUpper.Contains("PRESIDENT") || rTypeUpper.Contains("TONG THONG"))
                                {
                                    imageList.Add("https://images.unsplash.com/photo-1631049307264-da0ec9d70304?q=80&w=900");
                                    imageList.Add("https://images.unsplash.com/photo-1578683010236-d716f9a3f461?q=80&w=900");
                                }
                                else if (rTypeUpper.Contains("SUPERIOR"))
                                {
                                    imageList.Add("https://images.unsplash.com/photo-1591088398332-8a7791972843?q=80&w=900");
                                }
                                else if (rTypeUpper.Contains("TWIN"))
                                {
                                    imageList.Add("https://images.unsplash.com/photo-1566665797739-1674de7a421a?q=80&w=900");
                                }
                                else if (rTypeUpper.Contains("FAMILY"))
                                {
                                    imageList.Add("https://images.unsplash.com/photo-1611892440504-42a792e24d32?q=80&w=900");
                                }
                                else
                                {
                                    imageList.Add("https://images.unsplash.com/photo-1631049307264-da0ec9d70304?q=80&w=900");
                                }

                                var jsonImages = Newtonsoft.Json.JsonConvert.SerializeObject(imageList);

                                <div class="bg-white rounded-2xl border border-[#e7dbc1] shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col overflow-hidden group">
                                    <!-- SLIDER CONTAINER -->
                                    <div class="relative w-full h-56 bg-gray-900 overflow-hidden"
                                         id="slider-container-@room.RoomId"
                                         data-images='@jsonImages'
                                         data-current-index="0">

                                        <img id="slider-img-@room.RoomId"
                                             src="@primaryImg"
                                             alt="@room.RoomName"
                                             class="w-full h-full object-cover transition-opacity duration-300 group-hover:scale-105" />

                                        <!-- BADGE SỐ THỨ TỰ ẢNH -->
                                        <div class="absolute top-3 right-3 bg-black/60 backdrop-blur-md text-amber-300 text-[11px] font-bold px-2.5 py-1 rounded-full shadow border border-amber-400/30">
                                            <i class="fas fa-camera mr-1"></i><span id="slider-count-@room.RoomId">1/@imageList.Count</span>
                                        </div>

                                        <!-- NÚT CHUYỂN ẢNH MŨI TÊN TRÁI / PHẢI -->
                                        @if (imageList.Count > 1)
                                        {
                                            <button type="button"
                                                    onclick="prevRoomImage(@room.RoomId, event)"
                                                    title="Xem ảnh trước"
                                                    class="absolute left-2 top-1/2 -translate-y-1/2 w-8 h-8 rounded-full bg-black/40 hover:bg-black/80 text-white flex items-center justify-center transition border border-white/20 shadow-md">
                                                <i class="fas fa-chevron-left text-xs"></i>
                                            </button>
                                            <button type="button"
                                                    onclick="nextRoomImage(@room.RoomId, event)"
                                                    title="Xem ảnh tiếp theo"
                                                    class="absolute right-2 top-1/2 -translate-y-1/2 w-8 h-8 rounded-full bg-black/40 hover:bg-black/80 text-white flex items-center justify-center transition border border-white/20 shadow-md">
                                                <i class="fas fa-chevron-right text-xs"></i>
                                            </button>
                                        }
                                    </div>

                                    <!-- THÔNG TIN PHÒNG -->
                                    <div class="p-5 flex-grow flex flex-col justify-between">
                                        <div>
                                            <div class="flex justify-between items-center mb-2">
                                                <span class="text-[10px] font-extrabold uppercase tracking-widest px-2.5 py-0.5 rounded bg-amber-100 text-amber-900 border border-amber-300">
                                                    @room.RoomType
                                                </span>
                                                <span class="text-xs text-gray-500 font-semibold">
                                                    <i class="fas fa-users text-amber-600 mr-1"></i> @room.Capacity người
                                                </span>
                                            </div>

                                            <h4 class="text-xl font-bold font-serif text-[#21170f] mb-2 line-clamp-1">
                                                @CleanRoomName(room.RoomName)
                                            </h4>

                                            <p class="text-xs text-gray-600 line-clamp-2 mb-4 leading-relaxed">
                                                @room.Description
                                            </p>
                                        </div>

                                        <div>
                                            <div class="border-t border-gray-100 pt-3 mb-4 flex justify-between items-baseline">
                                                <span class="text-xs text-gray-500 font-medium">Giá chỉ từ</span>
                                                <div>
                                                    <span class="text-lg font-extrabold text-[#d4af37]">@room.Price.ToString("N0")đ</span>
                                                    <span class="text-[11px] text-gray-500">/đêm</span>
                                                </div>
                                            </div>

                                            <!-- NÚT XEM CHI TIẾT PHÒNG -->
                                            <button type="button"
                                                    onclick="viewRoomDetails(@room.RoomId, '@Url.Action("Details", "Room", new { id = room.RoomId })')"
                                                    class="w-full bg-gradient-to-r from-[#241c17] to-[#3a2e26] hover:from-[#d4af37] hover:to-[#f5d77a] text-[#f8f1e7] hover:text-[#21170f] font-bold py-2.5 px-4 rounded-xl text-xs transition-all duration-300 shadow flex items-center justify-center gap-2 group/btn">
                                                <i class="fas fa-eye text-amber-400 group-hover/btn:text-[#21170f] transition"></i>
                                                <span>XEM CHI TIẾT PHÒNG</span>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </section>
            }

        </div>

        <!-- ========================================================= -->
        <!-- TRANG PHÒNG VIEW ĐẸP -->
        <!-- ========================================================= -->
        <div id="page-rooms" class="page-section">
            <div class="luxury-page-banner" style="background-image:url('/images/luxury-hotel-hero.png');">
                <div class="luxury-page-banner-overlay"></div>
                <div class="relative z-10 container mx-auto px-4">
                    <p class="section-kicker text-yellow-300">KHÔNG GIAN NGHỈ DƯỠNG</p>
                    <h2 class="text-5xl md:text-6xl font-bold mb-5"
                        style="font-family:'Times New Roman', Times, serif;
           letter-spacing:0;
           word-spacing:0;
           font-kerning:normal;">
                        Những Căn Phòng Đẳng Cấp
                    </h2>
                    <p class="text-lg text-gray-100 max-w-2xl mx-auto">Từ phòng tiêu chuẩn đến không gian cao cấp, Luxury Hotel mang đến lựa chọn phù hợp cho từng nhu cầu.</p>
                </div>
            </div>
            <div class="container mx-auto py-16 px-4">
                <button onclick="showPage('home')" class="luxury-back-button mb-8"><i class="fas fa-arrow-left mr-2"></i>Quay lại trang chủ</button>
                <div class="text-center mb-12"><p class="section-kicker">LỰA CHỌN PHÒNG</p><h3 class="luxury-section-title">Phòng Nghỉ Dành Cho Mọi Nhu Cầu</h3><p class="luxury-section-description">Có cả phòng thường với mức giá hợp lý và phòng cao cấp dành cho những kỳ nghỉ đặc biệt.</p></div>


                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">

                    @foreach (var room in Model)
                    {
                        <div class="room-card luxury-room-card"
                             data-room-id="@room.RoomId"
                             data-room-type="@room.RoomType"
                             data-room-name="@room.RoomName"
                             data-room-price="@room.Price.ToString(
         System.Globalization.CultureInfo.InvariantCulture
     )"
                             data-room-capacity="@room.Capacity">
                            <div class="room-image-wrapper">
                                <img src="@room.ImageUrl"
                                     alt="@room.RoomName"
                                     class="w-full h-60 object-cover">
                            </div>

                            <div class="p-6">

                                <span class="luxury-room-tag">
                                    @room.RoomType
                                </span>

                                <h4 class="text-2xl
                                   font-bold
                                   text-gray-900
                                   mt-3
                                   mb-3">

                                    @CleanRoomName(room.RoomName)

                                </h4>

                                <p class="text-gray-600 text-sm mb-4">
                                    @room.Description
                                </p>

                                <div class="flex items-center gap-4 text-gray-600 text-sm mb-5">
                                    <span>
                                        <i class="fas fa-users text-yellow-600 mr-1"></i>
                                        @room.Capacity người
                                    </span>
                                </div>

                                <div class="room-card-footer
            flex
            justify-between
            items-end
            gap-4">
                                    <!-- GIÁ PHÒNG -->
                                    <div>

                                        <p class="text-gray-500 text-xs">
                                            Giá phòng
                                        </p>

                                        <p class="room-price luxury-room-price">
                                            @room.Price.ToString("N0")đ
                                        </p>

                                        <p class="text-gray-500 text-xs">
                                            / đêm
                                        </p>

                                    </div>


                                    <!-- CÁC NÚT -->
                                    <div class="flex flex-col gap-2">


                                        <!-- XEM CHI TIẾT -->
                                        <a href="@Url.Action(
                    "Details",
                    "Room",
                    new { id = room.RoomId }
                 )"
                                           class="px-5 py-2.5
                  rounded-lg
                  font-bold
                  text-center
                  border border-yellow-600
                  text-yellow-700
                  hover:bg-yellow-50
                  transition">

                                            <i class="fas fa-eye mr-2"></i>

                                            Xem chi tiết

                                        </a>


                                        <!-- ĐẶT PHÒNG -->
                                        <button type="button"
                                                onclick="bookRoom(
    @room.RoomId,
    '@HttpUtility.JavaScriptStringEncode(room.RoomName ?? "")',
    @room.Price.ToString(
        System.Globalization.CultureInfo.InvariantCulture
    ),
    @room.Capacity
)"
                                                class="luxury-gold-button
                       px-5 py-2.5
                       rounded-lg
                       font-bold">

                                            <i class="fas fa-calendar-check mr-2"></i>

                                            Đặt phòng

                                        </button>

                                    </div>

                                </div>

                            </div>

                        </div>
                    }

                </div>
            </div>
            <div class="luxury-cta-section"><div class="container mx-auto px-4 text-center"><h3 class="text-3xl md:text-4xl font-serif font-bold mb-4">Tìm Căn Phòng Phù Hợp Với Bạn</h3><p class="text-gray-200 mb-6">Hãy lựa chọn căn phòng yêu thích và tận hưởng kỳ nghỉ tuyệt vời.</p><button onclick="showPage('home')" class="luxury-gold-button px-8 py-3 rounded-xl font-bold"><i class="fas fa-home mr-2"></i>Về trang chủ</button></div></div>
        </div>

        <!-- ========================================================= -->
        <!-- TRANG ĐẶT PHÒNG -->
        <!-- ========================================================= -->

        <div id="page-booking" class="page-section">

            <!-- TIÊU ĐỀ -->
            <div class="bg-blue-900 text-white py-16 px-4 text-center">

                <div class="container mx-auto">

                    <h2 class="text-4xl font-extrabold mb-4">

                        Đặt Phòng Khách Sạn

                    </h2>

                    <p class="text-gray-200">

                        Vui lòng điền đầy đủ thông tin để hoàn tất đặt phòng.

                    </p>

                </div>

            </div>

            <!-- FORM ĐẶT PHÒNG -->

            <div class="container mx-auto py-12 px-4">

                <div class="max-w-4xl mx-auto">

                    <button onclick="showPage('rooms')"
                            class="mb-6 bg-gray-200 text-gray-700
                               px-5 py-3 rounded-lg
                               hover:bg-gray-300 transition">

                        <i class="fas fa-arrow-left mr-2"></i>

                        Quay lại chọn phòng

                    </button>

                    <div class="bg-white rounded-2xl shadow-xl
                            border border-gray-100 p-8">

                        <h3 class="text-2xl font-bold text-gray-800 mb-6">

                            <i class="fas fa-calendar-check text-blue-600 mr-2"></i>

                            Thông Tin Đặt Phòng

                        </h3>

                        <form id="bookingForm"
                              onsubmit="submitBooking(event)">

                            <!-- Ô CHỌN THÔNG TIN ĐÃ LƯU (XỔ XUỐNG - NẰM NGAY DƯỚI TIÊU ĐỀ THÔNG TIN ĐẶT PHÒNG) -->
                            <div id="savedProfilesContainer" class="mb-6 hidden bg-gradient-to-r from-blue-50 to-indigo-50 border border-blue-200 p-4 rounded-xl shadow-sm">
                                <label class="block text-blue-900 font-bold mb-2 text-sm flex items-center">
                                    <i class="fas fa-user-check text-blue-600 mr-2 text-base"></i> Chọn thông tin khách hàng đã lưu / đã từng đặt:
                                </label>
                                <select id="savedProfileSelect"
                                        onchange="onSelectSavedProfile(this)"
                                        class="w-full px-4 py-3 border border-blue-300 bg-white rounded-lg font-semibold text-gray-800 focus:ring-2 focus:ring-blue-500 shadow-sm transition cursor-pointer text-sm">
                                    <option value="">-- Nhập thông tin người khác / mới --</option>
                                </select>
                                <p class="text-xs text-gray-500 mt-2">
                                    <i class="fas fa-info-circle text-blue-500 mr-1"></i> Chọn thông tin đã lưu để tự động điền thông tin bên dưới, hoặc chọn "Nhập thông tin người khác / mới" để đặt cho người thân/bạn bè.
                                </p>
                            </div>

                            <!-- TÊN PHÒNG -->

                            <div class="mb-6">

                                <h4 class="text-xl font-bold text-blue-700 mb-4">

                                    Phòng đã chọn

                                </h4>

                                <div class="flex flex-col sm:flex-row gap-3">
                                    <input type="text"
                                           id="selectedRoom"
                                           readonly
                                           placeholder="Chưa chọn số phòng"
                                           class="w-full px-4 py-3
                                              border border-gray-300
                                              rounded-lg bg-gray-100
                                              text-gray-700">
                                    <input type="hidden"
                                           id="selectedRoomId">
                                    <input type="hidden"
                                           id="selectedRoomNumber">
                                    <button type="button"
                                            onclick="openRoomSelectionModal()"
                                            class="bg-gradient-to-r from-[#d4af37] to-[#f5d77a] text-[#21170f] font-bold px-6 py-3 rounded-lg hover:opacity-90 transition whitespace-nowrap shadow-sm">
                                        <i class="fas fa-door-open mr-1"></i> Chọn số phòng
                                    </button>
                                </div>

                            </div>

                            <!-- THÔNG TIN KHÁCH HÀNG -->

                            <h4 class="text-xl font-bold text-blue-700 mb-4">

                                Thông tin khách hàng

                            </h4>

                            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">

                                <!-- HỌ TÊN -->

                                <div>

                                    <label class="block text-gray-700
                                              font-semibold mb-2">

                                        Họ và tên *

                                    </label>

                                    <input type="text"
                                           id="customerName"
                                           value="@(Session["FullName"] ?? "")"
                                           required
                                           placeholder="Nhập họ và tên"
                                           class="w-full px-4 py-3
                                              border border-gray-300
                                              rounded-lg
                                              focus:ring-2
                                              focus:ring-blue-500">

                                </div>

                                <!-- SỐ ĐIỆN THOẠI -->

                                <div>

                                    <label class="block text-gray-700
                                              font-semibold mb-2">

                                        Số điện thoại *

                                    </label>

                                    <input type="tel"
                                           id="customerPhone"
                                           required
                                           inputmode="numeric"
                                           minlength="10"
                                           maxlength="11"
                                           pattern="[0-9]{10,11}"
                                           title="Số điện thoại phải gồm 10 đến 11 chữ số"
                                           placeholder="Nhập số điện thoại"
                                           class="w-full px-4 py-3
              border border-gray-300
              rounded-lg
              focus:ring-2
              focus:ring-blue-500">

                                </div>

                                <!-- EMAIL -->

                                <div>

                                    <label class="block text-gray-700
                                              font-semibold mb-2">

                                        Email *

                                    </label>

                                    <input type="email"
                                           id="customerEmail"
                                           value="@(Session["Email"] ?? "")"
                                           required
                                           placeholder="example@gmail.com"
                                           class="w-full px-4 py-3
                                              border border-gray-300
                                              rounded-lg
                                              focus:ring-2
                                              focus:ring-blue-500">

                                </div>

                                <!-- CCCD -->

                                <div>

                                    <label class="block text-gray-700
                                              font-semibold mb-2">

                                        Số CCCD

                                    </label>

                                    <input type="text"
                                           id="customerCCCD"
                                           inputmode="numeric"
                                           maxlength="12"
                                           pattern="[0-9]{12}"
                                           title="CCCD phải gồm đúng 12 chữ số"
                                           placeholder="Nhập 12 số CCCD"
                                           class="w-full px-4 py-3
              border border-gray-300
              rounded-lg
              focus:ring-2
              focus:ring-blue-500">

                                </div>

                            </div>

                            <!-- THÔNG TIN NHẬN PHÒNG -->

                            <h4 class="text-xl font-bold text-blue-700
                                   mt-8 mb-4">

                                Thông tin nhận và trả phòng

                            </h4>

                            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">

                                <!-- NGÀY NHẬN -->

                                <div>

                                    <label class="block text-gray-700
                                              font-semibold mb-2">

                                        Ngày nhận phòng *

                                    </label>

                                    <input type="date"
                                           id="checkInDate"
                                           onchange="handleCheckInChange();"
                                           required
                                           class="w-full px-4 py-3
              border border-gray-300
              rounded-lg">

                                </div>

                                <!-- NGÀY TRẢ -->

                                <div>

                                    <label class="block text-gray-700
                                              font-semibold mb-2">

                                        Ngày trả phòng *

                                    </label>

                                    <input type="date"
                                           id="checkOutDate"
                                           onchange="updateBookingSummary(); checkRoomAvailability();"
                                           required
