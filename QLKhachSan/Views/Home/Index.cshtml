                                </p>

                                <div id="serviceList"
                                     class="grid grid-cols-1 md:grid-cols-2 gap-4">

                                    <div class="text-gray-500">
                                        Đang tải dịch vụ...
                                    </div>

                                </div>

                            </div>


                            <!-- ===================================================== -->
                            <!-- PHƯƠNG THỨC THANH TOÁN -->
                            <!-- ===================================================== -->

                            <div class="mt-8">

                                <h4 class="text-xl font-bold text-blue-700 mb-4">

                                    <i class="fas fa-credit-card mr-2"></i>

                                    Phương thức thanh toán

                                </h4>

                                <div class="relative">
                                    <select id="paymentMethod"
                                            class="w-full px-4 py-3 border border-gray-300 rounded-lg bg-white focus:ring-2 focus:ring-blue-500">
                                        <option value="Thanh toán tại khách sạn">Thanh toán tại khách sạn</option>
                                        <option value="Chuyển khoản">Chuyển khoản</option>
                                    </select>
                                </div>

                            </div>


                            <!-- ===================================================== -->
                            <!-- MÃ KHUYẾN MÃI -->
                            <!-- ===================================================== -->

                            <div class="mt-8">

                                <h4 class="text-xl font-bold text-blue-700 mb-4">

                                    <i class="fas fa-tags mr-2"></i>

                                    Mã khuyến mãi

                                </h4>

                                <div class="flex flex-col md:flex-row gap-3">

                                    <div class="flex-1 min-w-0">
                                        <div class="relative mb-2">
                                            <select id="promotionSelect" aria-label="Chọn voucher phù hợp"
                                                    onchange="selectPromotion(this.value)" onfocus="loadPromotionOptions()"
                                                    class="w-full px-4 py-3 border border-gray-300 rounded-lg bg-white"
                                                    style="appearance: none; padding-right: 2.75rem;">
                                                <option value="">Chọn voucher phù hợp</option>
                                            </select>
                                            <i class="fas fa-chevron-down absolute right-4 top-1/2 transform -translate-y-1/2 pointer-events-none text-yellow-600" aria-hidden="true"></i>
                                        </div>
                                    <input type="text"
                                           id="promotionCode"
                                           oninput="resetPromotion()"
                                           placeholder="Ví dụ: WELCOME10"
                                           class="w-full px-4 py-3
                          border border-gray-300
                          rounded-lg
                          uppercase">
                                    </div>

                                    <button type="button"
                                            onclick="checkPromotion()"
                                            class="bg-yellow-500
                           hover:bg-yellow-600
                           text-gray-900
                           font-bold
                           px-6 py-3
                           rounded-lg">

                                        <i class="fas fa-check mr-2"></i>

                                        Áp dụng

                                    </button>

                                </div>

                                <p id="promotionMessage"
                                   class="mt-2 text-sm font-semibold">
                                </p>

                            </div>
                            <!-- ===================================================== -->
                            <!-- TẠM TÍNH CHI PHÍ -->
                            <!-- ===================================================== -->

                            <div class="mt-8 bg-yellow-50
                            border border-yellow-200
                            rounded-xl p-5">

                                <h4 class="text-xl font-bold text-gray-800 mb-4">
                                    <i class="fas fa-receipt text-yellow-600 mr-2"></i>
                                    Tạm tính chi phí
                                </h4>

                                <div class="space-y-3">

                                    <div class="flex justify-between">
                                        <span>Tiền phòng</span>
                                        <span id="roomSubtotal"
                                              class="font-semibold">
                                            0đ
                                        </span>
                                    </div>

                                    <div class="flex justify-between">
                                        <span>Dịch vụ</span>
                                        <span id="serviceSubtotal"
                                              class="font-semibold">
                                            0đ
                                        </span>
                                    </div>

                                    <div class="flex justify-between text-green-700">
                                        <span>Khuyến mãi</span>
                                        <span id="discountAmount"
                                              class="font-semibold">
                                            -0đ
                                        </span>
                                    </div>

                                    <hr>

                                    <div class="flex justify-between
                    text-xl font-bold">

                                        <span>Tổng thanh toán</span>

                                        <span id="bookingTotal"
                                              class="text-red-600">
                                            0đ
                                        </span>

                                    </div>

                                </div>

                            </div>
                            <!-- NÚT XÁC NHẬN -->

                            <div class="mt-8 flex flex-col md:flex-row gap-4">

                                <button type="submit"
                                        id="submitBookingButton"
                                        class="flex-1 bg-blue-600 text-white
               font-bold px-6 py-4 rounded-xl
               hover:bg-blue-700 transition
               disabled:opacity-60
               disabled:cursor-not-allowed">

                                    <i id="submitBookingIcon"
                                       class="fas fa-check-circle mr-2"></i>

                                    <span id="submitBookingText">
                                        Xác nhận đặt phòng
                                    </span>

                                </button>

                                <button type="button"
                                        onclick="showPage('rooms')"
                                        class="bg-gray-200 text-gray-700
                                           font-bold px-6 py-4 rounded-xl
                                           hover:bg-gray-300 transition">

                                    Hủy

                                </button>

                            </div>

                        </form>

                    </div>

                </div>

            </div>

        </div>
    </main>

    <!-- FOOTER -->
