                document.getElementById(
                    'support24Modal'
                );


            modal.classList.add(
                'hidden'
            );


            modal.classList.remove(
                'flex'
            );

        }


        function openAIFromSupport() {

            closeSupport24Modal();


            const chatBox =
                document.getElementById(
                    'aiChatBox'
                );


            // Nếu chatbot đang đóng thì mở
            if (
                chatBox &&
                (
                    chatBox.style.display === 'none' ||
                    chatBox.style.display === ''
                )
            ) {

                toggleAIChat();

            }


