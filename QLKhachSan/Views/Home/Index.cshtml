let appliedPromotion = null;
let promotionOptions = null;
let promotionOptionsLoading = false;

async function loadPromotionOptions() {
    if (promotionOptionsLoading || promotionOptions !== null) return;
    promotionOptionsLoading = true;
    const select = document.getElementById('promotionSelect');
    select.options[0].textContent = 'Đang tải voucher...';
    try {
        const response = await fetch('@Url.Action("GetAvailablePromotions", "Booking")');
        if (!response.ok) throw new Error('Cannot load promotions');
        const result = await response.json();
        if (!Array.isArray(result)) throw new Error('Invalid promotions');
        promotionOptions = result;
        renderPromotionOptions();
    } catch (error) {
        select.options[0].textContent = 'Chưa tải được voucher — bạn có thể nhập mã bên dưới';
    } finally {
        promotionOptionsLoading = false;
    }
}

function renderPromotionOptions() {
    if (promotionOptions === null) return;
    const select = document.getElementById('promotionSelect');
    const subtotal = calculateBookingTotals().roomSubtotal;
    const code = document.getElementById('promotionCode').value.trim().toUpperCase();
    const eligible = promotionOptions.filter(p => subtotal > 0 && subtotal >= Number(p.minAmount));
    select.replaceChildren(new Option(subtotal <= 0
        ? 'Chọn phòng và ngày lưu trú trước'
        : eligible.length ? 'Chọn voucher phù hợp' : 'Chưa có voucher phù hợp', ''));
    promotionOptions.forEach(p => {
        const money = value => Number(value).toLocaleString('vi-VN') + 'đ';
        const discount = p.type === 'PhanTram' ? p.value + '%' : money(p.value);
        const label = p.code + ' — ' + p.name + ' — Giảm ' + discount
            + (p.maxDiscount ? ' (tối đa ' + money(p.maxDiscount) + ')' : '')
            + ' — Tiền phòng từ ' + money(p.minAmount);
        const option = new Option(label, p.code);
        option.disabled = subtotal <= 0 || subtotal < Number(p.minAmount);
        option.selected = !option.disabled && p.code.toUpperCase() === code;
        select.add(option);
    });
}

function selectPromotion(code) {
    document.getElementById('promotionCode').value = code;
    resetPromotion();
    if (code) checkPromotion();
}

let selectedRoomPrice = 0;
        let selectedRoomCapacity = 0;
function resetPromotion() {

    appliedPromotion = null;

    const message =
        document.getElementById(
            'promotionMessage'
        );

    if (message) {
        message.innerText = '';
    }

    updateBookingSummary();
}


async function checkPromotion() {

    const code =
        document
            .getElementById('promotionCode')
            .value
            .trim();

    const message =
        document.getElementById(
            'promotionMessage'
        );


    if (!code) {

        appliedPromotion = null;

        message.innerText =
            'Vui lòng nhập mã khuyến mãi.';

        message.className =
            'mt-2 text-sm font-semibold text-red-600';

        updateBookingSummary();

        return;
    }
    // =======================================================
    // PHẢI CÓ TIỀN PHÒNG TRƯỚC KHI ÁP KHUYẾN MÃI
    // =======================================================

    const currentTotals =
        calculateBookingTotals();


    if (currentTotals.roomSubtotal <= 0) {

        appliedPromotion = null;

        message.innerText =
            'Vui lòng chọn phòng, ngày nhận và ngày trả trước khi áp mã.';

        message.className =
            'mt-2 text-sm font-semibold text-red-600';

        updateBookingSummary();

        return;
    }


    try {

        const response =
            await fetch(
                '@Url.Action("CheckPromotion", "Booking")'
                + '?code='
                + encodeURIComponent(code)
            );


        const result =
            await response.json();


        if (!result.success) {

            appliedPromotion = null;

            message.innerText =
                result.message;

            message.className =
                'mt-2 text-sm font-semibold text-red-600';

            updateBookingSummary();

            return;
        }

        // =======================================================
        // KIỂM TRA TIỀN PHÒNG CÓ ĐỦ MỨC TỐI THIỂU KHÔNG
        // =======================================================

        const minAmount =
            Number(
                result.minAmount || 0
            );


        if (
            currentTotals.roomSubtotal <
            minAmount
        ) {

            appliedPromotion = null;


            message.innerText =
                'Tiền phòng hiện tại chưa đạt mức tối thiểu '
                + minAmount.toLocaleString('vi-VN')
                + 'đ để sử dụng mã này.';


            message.className =
                'mt-2 text-sm font-semibold text-red-600';


            updateBookingSummary();

            return;
        }
        appliedPromotion = result;


        message.innerText =
            '✓ ' + result.message;

        message.className =
            'mt-2 text-sm font-semibold text-green-600';


        updateBookingSummary();

    }
    catch (error) {

        console.error(error);

        appliedPromotion = null;

        message.innerText =
            'Không thể kiểm tra mã khuyến mãi.';

        message.className =
            'mt-2 text-sm font-semibold text-red-600';

        updateBookingSummary();
    }
}


function calculateBookingTotals() {

    const roomPrice =
        selectedRoomPrice;


    const checkIn =
        document.getElementById(
            'checkInDate'
        ).value;


    const checkOut =
        document.getElementById(
            'checkOutDate'
        ).value;


    const roomCount =
        parseInt(
            document.getElementById(
                'roomCount'
            ).value
        ) || 1;


    let nights = 0;


    if (checkIn && checkOut) {

        const start =
            new Date(checkIn);

        const end =
            new Date(checkOut);


        nights =
            Math.ceil(
                (end - start) /
                (1000 * 60 * 60 * 24)
            );


        if (nights < 0) {
            nights = 0;
        }
    }


    const roomSubtotal =
        roomPrice *
        nights *
        roomCount;


    let serviceSubtotal = 0;


    document
        .querySelectorAll(
            '.service-checkbox:checked'
        )
        .forEach(function (checkbox) {

            const card =
                checkbox.closest(
                    '.service-card'
                );


            const price =
                Number(
                    checkbox.dataset.price
                ) || 0;


            const quantity =
                parseInt(
                    card.querySelector(
                        '.service-quantity'
                    ).value
                ) || 1;


            serviceSubtotal +=
                price * quantity;
        });


    let discount = 0;


    if (appliedPromotion) {

        if (
            roomSubtotal >=
            Number(
                appliedPromotion.minAmount || 0
            )
        ) {

            if (
                appliedPromotion.type ===
                'PhanTram'
            ) {

                discount =
                    roomSubtotal *
                    Number(
                        appliedPromotion.value
                    ) /
                    100;


                if (
                    appliedPromotion.maxDiscount
                    !== null &&
                    appliedPromotion.maxDiscount
                    !== undefined
                ) {

                    discount =
                        Math.min(
                            discount,
                            Number(
                                appliedPromotion.maxDiscount
                            )
                        );
                }

            }
            else if (
                appliedPromotion.type ===
                'SoTien'
            ) {

                discount =
                    Number(
                        appliedPromotion.value
                    );
            }
        }
    }


    if (discount > roomSubtotal) {
        discount = roomSubtotal;
    }


    return {

        roomSubtotal:
            roomSubtotal,

        serviceSubtotal:
            serviceSubtotal,

        discount:
            discount,

        total:
            Math.max(
                roomSubtotal +
                serviceSubtotal -
                discount,
                0
            )
    };
}


function updateBookingSummary() {
    if (promotionOptions === null) loadPromotionOptions();
    else renderPromotionOptions();

    const totals =
        calculateBookingTotals();
    // =======================================================
    // KIỂM TRA LẠI ĐIỀU KIỆN KHUYẾN MÃI
    // KHI KHÁCH ĐỔI NGÀY / SỐ PHÒNG
    // =======================================================

    if (appliedPromotion) {

        const minAmount =
            Number(
                appliedPromotion.minAmount || 0
            );


        if (
            totals.roomSubtotal <
            minAmount
        ) {

            // Gỡ mã đã áp dụng
            appliedPromotion = null;


            const promotionMessage =
                document.getElementById(
                    'promotionMessage'
                );


            if (promotionMessage) {

                promotionMessage.innerText =
                    'Mã khuyến mãi đã được gỡ vì tiền phòng hiện tại '
                    + 'không còn đạt mức tối thiểu '
                    + minAmount.toLocaleString('vi-VN')
                    + 'đ.';

                promotionMessage.className =
                    'mt-2 text-sm font-semibold text-red-600';
            }
        }
    }

    document.getElementById(
        'roomSubtotal'
    ).innerText =
        totals.roomSubtotal
            .toLocaleString('vi-VN')
        + 'đ';


    document.getElementById(
        'serviceSubtotal'
    ).innerText =
        totals.serviceSubtotal
            .toLocaleString('vi-VN')
        + 'đ';


    document.getElementById(
        'discountAmount'
    ).innerText =
        '-'
        + totals.discount
            .toLocaleString('vi-VN')
        + 'đ';


    document.getElementById(
        'bookingTotal'
    ).innerText =
        totals.total
            .toLocaleString('vi-VN')
        + 'đ';


    // Nếu đang mở QR thì cập nhật lại số tiền QR
    const paymentMethodElem =
        document.getElementById(
            'paymentMethod'
        );


    if (paymentMethodElem && paymentMethodElem.value === 'Chuyển khoản') {
        generateQRCode();
    }
        }
