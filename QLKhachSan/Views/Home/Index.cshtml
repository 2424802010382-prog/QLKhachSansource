        }

        .luxury-page-banner {
            position: relative;
            padding: 120px 20px;
            background-size: cover;
            background-position: center;
            color: white;
            text-align: center
        }

        .luxury-page-banner-overlay {
            position: absolute;
            inset: 0;
            background: linear-gradient(135deg,rgba(20,13,8,.84),rgba(30,18,8,.58))
        }

