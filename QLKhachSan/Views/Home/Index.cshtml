function nextRoomImage(roomId, event) {
    if (event) {
        event.stopPropagation();
        event.preventDefault();
    }
    const container = document.getElementById('slider-container-' + roomId);
    if (!container) return;
    let images = [];
    try {
        images = JSON.parse(container.getAttribute('data-images') || '[]');
    } catch(e) { }

    if (!images || images.length <= 1) return;

    let currentIndex = parseInt(container.getAttribute('data-current-index') || '0', 10);
    currentIndex = (currentIndex + 1) % images.length;

    container.setAttribute('data-current-index', currentIndex);
    const imgEl = document.getElementById('slider-img-' + roomId);
    const countEl = document.getElementById('slider-count-' + roomId);

    if (imgEl) {
        imgEl.style.opacity = '0.3';
        setTimeout(function() {
            imgEl.src = images[currentIndex];
            imgEl.style.opacity = '1';
        }, 120);
    }
    if (countEl) {
        countEl.textContent = (currentIndex + 1) + '/' + images.length;
    }
}

function prevRoomImage(roomId, event) {
    if (event) {
        event.stopPropagation();
        event.preventDefault();
    }
    const container = document.getElementById('slider-container-' + roomId);
    if (!container) return;
    let images = [];
    try {
        images = JSON.parse(container.getAttribute('data-images') || '[]');
    } catch(e) { }

    if (!images || images.length <= 1) return;

    let currentIndex = parseInt(container.getAttribute('data-current-index') || '0', 10);
    currentIndex = (currentIndex - 1 + images.length) % images.length;

    container.setAttribute('data-current-index', currentIndex);
    const imgEl = document.getElementById('slider-img-' + roomId);
    const countEl = document.getElementById('slider-count-' + roomId);

    if (imgEl) {
        imgEl.style.opacity = '0.3';
        setTimeout(function() {
            imgEl.src = images[currentIndex];
            imgEl.style.opacity = '1';
        }, 120);
    }
    if (countEl) {
        countEl.textContent = (currentIndex + 1) + '/' + images.length;
    }
}

function viewRoomDetails(roomId, detailUrl) {
    const isUserLoggedIn = @(Session["UserId"] != null ? "true" : "false");
    const targetUrl = detailUrl || ('@Url.Action("Details", "Room")' + '?id=' + roomId);

    if (isUserLoggedIn) {
        window.location.href = targetUrl;
    } else {
        const returnInput = document.getElementById('loginReturnUrl');
        if (returnInput) {
            returnInput.value = targetUrl;
        }

        const noticeEl = document.getElementById('loginNotice');
        if (noticeEl) {
            noticeEl.classList.remove('hidden');
        }

        openLoginModal();
    }
}

function goToRestaurant(event) {
    if (event) event.preventDefault();
    const isUserLoggedIn = @(Session["UserId"] != null ? "true" : "false");
    const targetUrl = '@Url.Action("Index", "Restaurant")';

    if (isUserLoggedIn) {
        window.location.href = targetUrl;
