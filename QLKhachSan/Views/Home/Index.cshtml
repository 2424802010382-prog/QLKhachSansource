            }
        }

        openLoginModal();
    }
}

document.addEventListener('DOMContentLoaded', function() {
    const urlParams = new URLSearchParams(window.location.search);
    const loginRequired = urlParams.get('loginRequired');
    const returnUrl = urlParams.get('returnUrl');

    if (returnUrl) {
        const returnInput = document.getElementById('loginReturnUrl');
        if (returnInput) returnInput.value = returnUrl;
    }

    if (loginRequired === '1') {
        const noticeEl = document.getElementById('loginNotice');
        if (noticeEl && returnUrl) {
            noticeEl.classList.remove('hidden');
        }
        openLoginModal();
    }

    const isLoggedIn = @(Session["UserId"] != null ? "true" : "false");
    if (isLoggedIn) {
        loadSavedCustomerProfiles();
    }
});

function toggleMobileMenu() {
    const menu = document.getElementById('mobileMenu');
    const icon = document.getElementById('mobileMenuIcon');
    if (!menu) return;
    if (menu.classList.contains('hidden')) {
        menu.classList.remove('hidden');
        if (icon) { icon.classList.remove('fa-bars'); icon.classList.add('fa-times'); }
    } else {
        menu.classList.add('hidden');
        if (icon) { icon.classList.remove('fa-times'); icon.classList.add('fa-bars'); }
    }
}

    /* =======================================================
