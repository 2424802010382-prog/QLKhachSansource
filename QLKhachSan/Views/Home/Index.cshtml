@model IEnumerable<QLKhachSan.Models.Room>
@functions {
    public static string CleanRoomName(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "";
        string cleaned = name.Normalize(System.Text.NormalizationForm.FormC);
        return cleaned.Replace("Thố ́ng", "Thống")
                      .Replace("Thố\u0301ng", "Thống")
                      .Replace("Thố\u0300ng", "Thống")
                      .Replace("Thố  ng", "Thống");
    }
}

<!DOCTYPE html>
@{
    Layout = null;
}

<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Luxury Hotel - Trang Chủ</title>

    <script src="https://cdn.tailwindcss.com"></script>

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400..900;1,400..900&family=Plus+Jakarta+Sans:ital,wght@0,300..800;1,300..800&display=swap" rel="stylesheet">

    <style>

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: 'Plus Jakarta Sans', 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: #f8fafc;
            color: #1e293b;
        }

        .font-serif {
            font-family: 'Playfair Display', Georgia, serif !important;
        }

        .page-section {
            display: none;
        }

            .page-section.active {
                display: block;
                animation: fadeIn 0.5s ease-in-out;
            }

        @@keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(15px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .luxury-navbar {
            background: linear-gradient( 135deg, #0f172a, #1e3a8a, #1d4ed8 );
            box-shadow: 0 5px 25px rgba(15, 23, 42, 0.25);
        }

        .luxury-logo {
            letter-spacing: 2px;
            text-shadow: 0 3px 8px rgba(0, 0, 0, 0.25);
        }
        /* ========================================================= */
        /* MENU PHÒNG - DROPDOWN */
        /* ========================================================= */

        .room-dropdown {
            position: relative;
        }

        .room-dropdown-button {
            position: relative;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            cursor: pointer;
        }

        .room-dropdown-menu {
            position: absolute;
            top: calc(100% + 10px);
            left: 0;
            width: 260px;
            background: #303030;
            border-radius: 0;
            box-shadow: 0 10px 30px rgba(0,0,0,0.35);
            overflow: hidden;
            opacity: 0;
            visibility: hidden;
            transform: translateY(-8px);
            transition: all 0.25s ease;
            z-index: 100;
        }

        .room-dropdown:hover .room-dropdown-menu {
            opacity: 1;
            visibility: visible;
            transform: translateY(0);
        }

        .room-dropdown-item {
            display: block;
            width: 100%;
            padding: 13px 18px;
            color: #f5f5f5;
            background: #303030;
            border-bottom: 1px solid #424242;
            font-size: 14px;
            font-weight: 500;
            text-align: left;
            transition: all 0.2s ease;
        }

            .room-dropdown-item:last-child {
                border-bottom: none;
            }

            .room-dropdown-item:hover {
                background: #444444;
                color: #facc15;
                padding-left: 23px;
            }

            .room-dropdown-item i {
                width: 18px;
                margin-right: 6px;
                color: #facc15;
            }

        .luxury-menu-link {
            position: relative;
            transition: all 0.3s ease;
        }

            .luxury-menu-link::after {
                content: "";
                position: absolute;
                left: 50%;
                bottom: 0;
                width: 0;
                height: 3px;
                background: #facc15;
                transform: translateX(-50%);
                transition: width 0.3s ease;
                border-radius: 10px;
            }

            .luxury-menu-link:hover::after {
                width: 75%;
            }

        .hero-section {
            min-height: 680px;
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
            overflow: hidden;
        }

            .hero-section::before {
                content: "";
                position: absolute;
                inset: 0;
                background: linear-gradient( 135deg, rgba(15, 23, 42, 0.85), rgba(30, 64, 175, 0.55), rgba(0, 0, 0, 0.45) );
                z-index: 1;
            }

        .hero-content {
            position: relative;
            z-index: 2;
        }

        .hero-title {
            font-size: clamp(2.3rem, 6vw, 5rem);
            line-height: 1.15;
            font-weight: 900;
            letter-spacing: -1px;
            text-shadow: 0 5px 20px rgba(0, 0, 0, 0.45);
        }

        .hero-description {
            font-size: clamp(1rem, 2vw, 1.3rem);
            line-height: 1.8;
        }

        .search-box {
            background: rgba(255, 255, 255, 0.97);
            border-radius: 24px;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.25);
            backdrop-filter: blur(12px);
        }

        .section-title {
            position: relative;
            display: inline-block;
            font-weight: 800;
            color: #0f172a;
        }

            .section-title::after {
                content: "";
                display: block;
                width: 80px;
                height: 5px;
                margin: 15px auto 0;
                border-radius: 20px;
                background: linear-gradient( 90deg, #2563eb, #facc15 );
            }

        .feature-card {
            background: white;
            border-radius: 24px;
            padding: 35px 28px;
            border: 1px solid #e2e8f0;
            box-shadow: 0 8px 25px rgba(15, 23, 42, 0.07);
            transition: all 0.35s ease;
        }

            .feature-card:hover {
                transform: translateY(-10px);
                box-shadow: 0 20px 45px rgba(37, 99, 235, 0.18);
                border-color: #93c5fd;
            }

        .feature-icon {
            width: 75px;
            height: 75px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 25px;
            border-radius: 50%;
            color: #2563eb;
            background: linear-gradient( 135deg, #dbeafe, #eff6ff );
            transition: all 0.35s ease;
        }

        .feature-card:hover .feature-icon {
            color: white;
            background: linear-gradient( 135deg, #2563eb, #1e40af );
            transform: rotate(8deg) scale(1.08);
        }

        .room-card {
            overflow: hidden;
            background: white;
            border-radius: 24px;
            border: 1px solid #e2e8f0;
            box-shadow: 0 10px 30px rgba(15, 23, 42, 0.08);
            transition: all 0.35s ease;
        }

            .room-card:hover {
                transform: translateY(-10px);
                box-shadow: 0 22px 50px rgba(15, 23, 42, 0.18);
            }

            .room-card img {
                transition: transform 0.5s ease;
            }

            .room-card:hover img {
                transform: scale(1.08);
            }

        .room-image-wrapper {
            overflow: hidden;
            position: relative;
            height: 240px;
            flex-shrink: 0;
        }
            .room-image-wrapper img {
                width: 100%;
                height: 100%;
                object-fit: cover;
            }

        .room-price {
            color: #1d4ed8;
            font-size: 1.4rem;
            font-weight: 800;
        }

        .main-button {
            background: linear-gradient( 135deg, #2563eb, #1d4ed8 );
            color: white;
            font-weight: 700;
            border-radius: 12px;
            padding: 13px 22px;
            transition: all 0.3s ease;
            box-shadow: 0 5px 15px rgba(37, 99, 235, 0.25);
        }

            .main-button:hover {
                transform: translateY(-3px);
                background: linear-gradient( 135deg, #1d4ed8, #1e3a8a );
                box-shadow: 0 10px 25px rgba(37, 99, 235, 0.4);
            }

        .yellow-button {
            background: linear-gradient( 135deg, #facc15, #eab308 );
            color: #172554;
            font-weight: 800;
            border-radius: 12px;
            padding: 13px 22px;
            transition: all 0.3s ease;
        }

            .yellow-button:hover {
                transform: translateY(-3px);
                box-shadow: 0 10px 25px rgba(234, 179, 8, 0.35);
            }

        .page-banner {
            position: relative;
            background-size: cover;
            background-position: center;
            padding: 110px 20px;
            color: white;
            text-align: center;
        }

            .page-banner::before {
                content: "";
                position: absolute;
                inset: 0;
                background: linear-gradient( 135deg, rgba(15, 23, 42, 0.88), rgba(30, 64, 175, 0.65) );
            }

        .page-banner-content {
            position: relative;
            z-index: 2;
        }

        .form-card {
            background: white;
            border-radius: 24px;
            border: 1px solid #e2e8f0;
            box-shadow: 0 15px 45px rgba(15, 23, 42, 0.1);
        }

        input,
        select,
        textarea {
            transition: all 0.25s ease;
        }

            input:focus,
            select:focus,
            textarea:focus {
                border-color: #2563eb !important;
                box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.12);
                outline: none;
            }

        .footer-section {
            background: linear-gradient( 135deg, #020617, #0f172a, #172554 );
        }

        .modal-box {
            animation: modalShow 0.3s ease;
        }

        @@keyframes modalShow {
            from {
                opacity: 0;
                transform: scale(0.9) translateY(20px);
            }

            to {
                opacity: 1;
                transform: scale(1) translateY(0);
            }
        }

        #aiChatButton {
            transition: all 0.3s ease;
        }

            #aiChatButton:hover {
                transform: scale(1.12) rotate(5deg);
                box-shadow: 0 12px 35px rgba(37, 99, 235, 0.5) !important;
            }

        #aiChatBox {
            animation: chatShow 0.3s ease;
        }

        @@keyframes chatShow {
            from {
                opacity: 0;
                transform: translateY(20px) scale(0.95);
            }

            to {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
        }

        .line-clamp-2 {
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        @@media (max-width: 768px) {

            .hero-section {
                min-height: 760px;
            }

            .hero-title {
                font-size: 2.5rem;
            }

            .search-box {
                padding: 20px !important;
            }

            .luxury-logo {
                font-size: 1.2rem;
            }

            #aiChatBox {
                right: 15px !important;
                bottom: 100px !important;
                width: calc(100% - 30px) !important;
                height: 480px !important;
            }

            #aiChatButton {
                right: 18px !important;
                bottom: 18px !important;
                width: 58px !important;
                height: 58px !important;
            }
        }

