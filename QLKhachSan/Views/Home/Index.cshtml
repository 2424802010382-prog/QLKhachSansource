    <div id="loginModal"
         class="fixed inset-0 bg-black/70 hidden
                    justify-center items-center p-4 z-50
                    transition-opacity duration-300 opacity-0">

        <div class="bg-white rounded-2xl max-w-sm w-full p-10
                        shadow-2xl relative
                        transform scale-90 transition-transform duration-300">

            <!-- Đóng -->
            <button type="button"
                    onclick="closeLoginModal()"
                    class="absolute top-4 right-4
                               text-gray-400 hover:text-gray-600">

                <i class="fas fa-times text-xl"></i>

            </button>

            <!-- Icon -->
            <div class="text-center mb-8">

                <i class="fas fa-user-circle text-6xl
                              text-blue-600 mb-4 drop-shadow">
                </i>

                <h2 class="text-3xl font-bold text-blue-700">
                    ĐĂNG NHẬP
                </h2>

                <p class="text-gray-500 text-sm mt-1">
                    Chào mừng bạn trở lại!
                </p>

            </div>
            <!-- THÔNG BÁO YÊU CẦU ĐĂNG NHẬP ĐỂ XEM CHI TIẾT PHÒNG -->
            <div id="loginNotice" class="hidden mb-5 p-3.5 bg-amber-50 border border-amber-300 rounded-xl text-xs text-amber-900 font-semibold flex items-center gap-2 shadow-sm">
                <i class="fas fa-circle-info text-amber-600 text-base flex-shrink-0"></i>
                <span id="loginNoticeText">Vui lòng đăng nhập để xem chi tiết phòng.</span>
            </div>

            @if (TempData["LoginError"] != null)
            {
                <div class="mb-5
                rounded-lg
                border border-red-200
                bg-red-50
                px-4 py-3
                text-sm
                text-red-700">

                    <i class="fas fa-circle-exclamation mr-2"></i>

                    @TempData["LoginError"]

                </div>
            }


            @if (TempData["RegisterSuccess"] != null)
            {
                <div class="mb-5
                rounded-lg
                border border-green-200
                bg-green-50
                px-4 py-3
                text-sm
                text-green-700">

                    <i class="fas fa-circle-check mr-2"></i>

                    @TempData["RegisterSuccess"]

                </div>
            }
            @if (TempData["LoginSuccess"] != null)
            {
                <div class="mb-5
                rounded-lg
                border
                border-green-200
                bg-green-50
                px-4
                py-3
                text-sm
                text-green-700
                font-semibold">

                    <i class="fas
                  fa-circle-check
                  mr-2">
                    </i>

                    @TempData["LoginSuccess"]

                </div>
            }
            <form action="@Url.Action("Login", "Account")"
                  method="post">

                @Html.AntiForgeryToken()
                <input type="hidden" name="returnUrl" id="loginReturnUrl" value="" />
                <!-- Email -->
                <div class="mb-5">

                    <label class="block text-sm font-semibold mb-1 text-gray-700">

                        Tên đăng nhập

                    </label>

                    <div class="relative">

                        <i class="fas fa-envelope absolute left-3
                                      top-1/2 -translate-y-1/2 text-gray-400">
                        </i>

                        <input type="text"
                               id="loginUsername"
                               name="username"
                               required
                               autocomplete="username"
                               class="w-full border border-gray-300
              rounded-lg pl-10 pr-3 py-3 text-sm
              focus:ring-2 focus:ring-blue-500
              focus:outline-none transition"
                               placeholder="Nhập tên đăng nhập">

                    </div>

                </div>

                <!-- Mật khẩu -->
                <div class="mb-3">

                    <label class="block text-sm font-semibold mb-1 text-gray-700">

                        Mật khẩu

                    </label>

                    <div class="relative">

                        <i class="fas fa-lock absolute left-3
                                      top-1/2 -translate-y-1/2 text-gray-400">
                        </i>

                        <input type="password"
                               id="loginPassword"
                               name="password"
                               required
                               autocomplete="current-password"
                               class="w-full border border-gray-300
              rounded-lg pl-10 pr-3 py-3 text-sm
              focus:ring-2 focus:ring-blue-500
              focus:outline-none transition"
                               placeholder="Nhập mật khẩu">

                    </div>

                </div>

                <!-- QUÊN MẬT KHẨU -->
                <div class="flex justify-end mb-6">

                    <a href="#"
                       onclick="switchToForgotPassword(); return false;"
                       class="text-sm text-blue-600 hover:underline">

                        Quên mật khẩu?

                    </a>

                </div>

                <!-- Đăng nhập -->
                <button type="submit"
                        class="w-full bg-blue-600 text-white
                                   font-bold py-3 rounded-lg
                                   hover:bg-blue-700 transition
                                   shadow-lg">

                    ĐĂNG NHẬP

                </button>

            </form>

            <!-- Đăng ký -->
            <div class="text-center mt-8 text-sm border-t pt-5">

                <p class="text-gray-600">

                    Chưa có tài khoản?

                    <a href="#"
                       onclick="closeLoginModal(); openRegisterModal(); return false;"
                       class="text-blue-600 font-semibold hover:underline">

                        Đăng ký ngay

                    </a>

                </p>

            </div>

        </div>

    </div>

