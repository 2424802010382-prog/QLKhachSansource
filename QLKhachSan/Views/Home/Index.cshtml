        function validateGuestCapacity() {

            const guestSelect =
                document.getElementById(
                    'guestCount'
                );

            const roomCountSelect =
                document.getElementById(
                    'roomCount'
                );

            const message =
                document.getElementById(
                    'capacityMessage'
                );


            if (
                !guestSelect ||
                !roomCountSelect ||
                !message
            ) {

                return true;
            }


            const guestCount =
                parseInt(
                    guestSelect.value
                );


            const roomCount =
                parseInt(
                    roomCountSelect.value
                ) || 1;


            // Chưa chọn phòng
            if (selectedRoomCapacity <= 0) {

                message.innerText = '';

                return true;
            }


            // Sức chứa tối đa
            const maxGuests =
                selectedRoomCapacity *
                roomCount;


            // Chưa chọn số người
            if (!guestCount) {

                message.innerText =
                    'Tối đa '
                    + maxGuests
                    + ' người cho '
                    + roomCount
                    + ' phòng.';

                message.className =
                    'mt-2 text-sm font-semibold text-gray-500';

                return true;
            }


            // ===================================================
            // VƯỢT QUÁ SỨC CHỨA
            // ===================================================

            if (guestCount > maxGuests) {

                message.innerText =
                    'Số người vượt quá sức chứa. '
                    + roomCount
                    + ' phòng chỉ chứa tối đa '
                    + maxGuests
                    + ' người.';

                message.className =
                    'mt-2 text-sm font-semibold text-red-600';

                return false;
            }


            // ===================================================
            // HỢP LỆ
            // ===================================================

            message.innerText =
                'Phù hợp. Tối đa '
                + maxGuests
                + ' người cho '
                + roomCount
                + ' phòng.';

            message.className =
                'mt-2 text-sm font-semibold text-green-600';


            return true;
        }

        function checkLoginAndBook(event, target) {
            if (event) event.preventDefault();
            const isLoggedIn = @(Session["UserId"] != null ? "true" : "false");
            if (!isLoggedIn) {
                const noticeEl = document.getElementById('loginNotice');
                if (noticeEl) {
                    noticeEl.classList.remove('hidden');
                    const noticeText = document.getElementById('loginNoticeText');
                    if (noticeText) {
                        noticeText.textContent = 'Vui lòng đăng nhập để sử dụng tính năng Đặt phòng.';
                    }
                }
                openLoginModal();
                return;
            }
            showPage(target);
        }

        function bookRoom(
            roomId,
            roomName,
            roomPrice,
            roomCapacity
        ) {
            const isLoggedIn = @(Session["UserId"] != null ? "true" : "false");
            if (!isLoggedIn) {
                const noticeEl = document.getElementById('loginNotice');
                if (noticeEl) {
                    noticeEl.classList.remove('hidden');
                    const noticeText = document.getElementById('loginNoticeText');
                    if (noticeText) {
                        noticeText.textContent = 'Vui lòng đăng nhập để sử dụng tính năng Đặt phòng.';
                    }
                }
                openLoginModal();
                return;
            }

            // =======================================================
            // 1. CHUYỂN SANG TRANG ĐẶT PHÒNG
            // =======================================================

            showPage('booking');
            if (typeof loadSavedCustomerProfiles === 'function') {
                loadSavedCustomerProfiles();
            }


            // =======================================================
            // 2. RESET QR CỦA LƯỢT ĐẶT PHÒNG TRƯỚC
            // =======================================================

            resetPaymentState();


            // =======================================================
            // 3. RESET THÔNG BÁO PHÒNG TRỐNG CŨ
            // =======================================================

            const availabilityMessage =
                document.getElementById(
                    'availabilityMessage'
                );

            if (availabilityMessage) {

                availabilityMessage.innerText = '';

                availabilityMessage.className =
                    'mt-2 text-sm font-semibold text-gray-500';
            }


            // =======================================================
            // 4. RESET Ô SỐ PHÒNG VỀ 1 - 2 - 3
            // =======================================================

            const roomCountSelect =
                document.getElementById(
                    'roomCount'
                );

            if (roomCountSelect) {

                roomCountSelect.disabled = false;

                roomCountSelect.innerHTML = `
            <option value="1">1 phòng</option>
            <option value="2">2 phòng</option>
            <option value="3">3 phòng</option>
        `;

                roomCountSelect.value = '1';
            }


            // =======================================================
            // 5. LƯU ID PHÒNG ĐANG CHỌN
            // =======================================================

            document.getElementById(
                'selectedRoomId'
            ).value = roomId;

            if (typeof resetSelectedRoomNumber === 'function') {
                resetSelectedRoomNumber();
            }


            // =======================================================
            // 6. HIỂN THỊ TÊN PHÒNG
            // =======================================================

            document.getElementById(
                'selectedRoom'
            ).value = roomName;


            // =======================================================
            // 7. LƯU GIÁ PHÒNG TỪ DATABASE
            // =======================================================

            selectedRoomPrice =
                Number(roomPrice) || 0;

            // =======================================================
            // LƯU SỨC CHỨA CỦA 1 PHÒNG
            // =======================================================

            selectedRoomCapacity =
                parseInt(roomCapacity) || 0;
            validateGuestCapacity();


            // =======================================================
            // 8. RESET MÃ KHUYẾN MÃI
            // =======================================================

            document.getElementById(
                'promotionCode'
            ).value = '';


            document.getElementById(
                'promotionMessage'
            ).innerText = '';


            appliedPromotion = null;


            // =======================================================
            // 9. TẢI DỊCH VỤ
            // =======================================================

            loadServices();


            // =======================================================
            // 10. TÍNH LẠI TỔNG TIỀN
            // =======================================================

            updateBookingSummary();


            // =======================================================
            // 11. KIỂM TRA PHÒNG CÒN TRỐNG
            // =======================================================

            checkRoomAvailability();


            // =======================================================
            // 12. CUỘN LÊN ĐẦU FORM
            // =======================================================

            window.scrollTo(0, 0);
        }

            /* =======================s================================
               XÁC NHẬN ĐẶT PHÒNG
            ======================================================= */
        // =======================================================
        // CHỐNG BẤM XÁC NHẬN ĐẶT PHÒNG NHIỀU LẦN
        // =======================================================

        let bookingSubmitting = false;


        function setBookingSubmitting(isSubmitting) {

            bookingSubmitting =
                isSubmitting;


            const button =
                document.getElementById(
                    'submitBookingButton'
                );

            const text =
                document.getElementById(
                    'submitBookingText'
                );

            const icon =
                document.getElementById(
                    'submitBookingIcon'
                );


            if (!button || !text || !icon) {
                return;
            }


            button.disabled =
                isSubmitting;


            if (isSubmitting) {

                text.innerText =
                    'Đang xử lý...';

                icon.className =
                    'fas fa-spinner fa-spin mr-2';

            }
            else {

                text.innerText =
                    'Xác nhận đặt phòng';

                icon.className =
                    'fas fa-check-circle mr-2';

            }
        }
            async function submitBooking(event) {

                event.preventDefault();

                const isLoggedIn = @(Session["UserId"] != null ? "true" : "false");
                if (!isLoggedIn) {
                    const noticeEl = document.getElementById('loginNotice');
                    if (noticeEl) {
                        noticeEl.classList.remove('hidden');
                        const noticeText = document.getElementById('loginNoticeText');
                        if (noticeText) {
                            noticeText.textContent = 'Vui lòng đăng nhập để sử dụng tính năng Đặt phòng.';
                        }
                    }
                    openLoginModal();
                    return;
                }

                // Nếu request trước đang chạy
                // thì không cho gửi thêm
                if (bookingSubmitting) {

                    return;

                }


                const data = {

            RoomId:
                parseInt(
                    document.getElementById('selectedRoomId').value
                ),

            CustomerName:
                document.getElementById('customerName').value.trim(),

            CustomerPhone:
                document.getElementById('customerPhone').value.trim(),

            CustomerEmail:
                document.getElementById('customerEmail').value.trim(),

            CustomerCCCD:
                document.getElementById('customerCCCD').value.trim(),

            CheckInDate:
                document.getElementById('checkInDate').value,

            CheckOutDate:
                document.getElementById('checkOutDate').value,

            GuestCount:
                parseInt(
                    document.getElementById('guestCount').value
                ),

            RoomCount:
                parseInt(
                    document.getElementById('roomCount').value
                ),

            SpecialRequest:
                document.getElementById(
                    'specialRequest'
                ).value.trim(),

            RoomNumbers:
                document.getElementById('selectedRoomNumber').value.split(',').map(n => n.trim()).filter(Boolean),
            RoomNumber:
                document.getElementById('selectedRoomNumber').value.split(',')[0].trim(),

            PaymentMethod:
                document.getElementById('paymentMethod') ? document.getElementById('paymentMethod').value : 'Thanh toán tại khách sạn',

            PromotionCode:
                appliedPromotion
                    ? document.getElementById(
                          'promotionCode'
                      ).value.trim()
                    : '',

            Services:
                getSelectedServices()
        };


        if (!data.RoomId) {

            showLuxuryAlert('Vui lòng chọn phòng trước!', 'Thông báo', 'warning');

            showPage('rooms');

            return;
        }

        const roomNum = document.getElementById('selectedRoomNumber').value.trim();
        if (!roomNum || data.RoomNumbers.length !== data.RoomCount) {
            showLuxuryAlert('Vui lòng chọn số phòng cụ thể trước khi xác nhận đặt phòng!', 'Thông báo', 'warning');
            openRoomSelectionModal();
            return;
        }


        if (data.CheckOutDate <= data.CheckInDate) {

            alert('Ngày trả phòng phải sau ngày nhận phòng!');

            return;
        }

                // =======================================================
                // KIỂM TRA SỨC CHỨA TRƯỚC KHI GỬI ĐẶT PHÒNG
                // =======================================================

                if (!validateGuestCapacity()) {

                    alert(
                        'Số người vượt quá sức chứa của số phòng đã chọn.'
                    );

                    document
                        .getElementById(
                            'guestCount'
                        )
                        .focus();

                    return;
                }
                // =======================================================
                // DỮ LIỆU ĐÃ HỢP LỆ
                // BẮT ĐẦU KHÓA NÚT VÀ GỬI REQUEST
                // =======================================================

                setBookingSubmitting(true);
        try {

            const response = await fetch(
                '@Url.Action("Create", "Booking")',
                {
                    method: 'POST',

                    headers: {
                        'Content-Type': 'application/json'
                    },

                    body: JSON.stringify(data)
                }
            );


            const result = await response.json();


            if (!result.success) {

                // Cho phép khách sửa rồi bấm lại
                setBookingSubmitting(false);

                if (result.requireLogin) {
                    showLuxuryAlert(result.message, 'CẦN ĐĂNG NHẬP', 'warning', function() {
                        openLoginModal();
                    });
                    return;
                }

                showLuxuryAlert(result.message, 'Thông báo', 'warning');


                return;
            }


            const total =
                Number(result.totalAmount)
                    .toLocaleString('vi-VN');
            const discount =
                Number(
                    result.discountAmount || 0
                ).toLocaleString('vi-VN');

            const successHtml =
                '<strong>Mã đặt phòng:</strong> #' + result.bookingId + '<br>' +
                '<strong>Tiền giảm:</strong> ' + discount + 'đ<br>' +
                '<strong>Tổng thanh toán:</strong> ' + total + 'đ<br>' +
                '<strong>Trạng thái:</strong> Chờ xác nhận';

            showLuxuryAlert(successHtml, 'ĐẶT PHÒNG THÀNH CÔNG!', 'success', function() {
                if (result.redirectUrl) { window.location.href = result.redirectUrl; return; }
                document
                    .getElementById('bookingForm')
                    .reset();

                if (typeof loadSavedCustomerProfiles === 'function') {
                    loadSavedCustomerProfiles();
                }


                document
                    .getElementById('selectedRoomId')
                    .value = '';
                resetPaymentState();

                selectedRoomPrice = 0;
                selectedRoomCapacity = 0;

                appliedPromotion = null;
                const capacityMessage =
                    document.getElementById(
                        'capacityMessage'
                    );

                if (capacityMessage) {

                    capacityMessage.innerText = '';

                }

                document.getElementById(
                    'promotionMessage'
                ).innerText = '';

                updateBookingSummary();
                setBookingSubmitting(false);

                // Chuyển hướng sang trang Thanh Toán (Payment)
                if (result.redirectUrl) {
                    window.location.href = result.redirectUrl;
                } else if (result.bookingId) {
                    window.location.href = '/Booking/Payment?id=' + result.bookingId;
                } else {
                    showPage('home');
                }
            });

        }
        catch (error) {

            console.error(error);


            // Có lỗi mạng thì cho phép bấm lại
            setBookingSubmitting(false);


            alert(
                'Không thể kết nối đến máy chủ. Vui lòng thử lại!'
            );
        }
    }
            /* =======================================================
    THANH TOÁN CHUYỂN KHOẢN QR
    ======================================================= */

            // Biến đếm ngược
            let countdownInterval = null;

            // Thời gian 10 phút = 600 giây
            let remainingSeconds = 600;

            // Trạng thái thanh toán
        let paymentExpired = false;

        let currentTransferContent = null;


            // Khi chọn phương thức thanh toán
            function togglePaymentMethod() {
                const paymentMethodElem = document.getElementById("paymentMethod");
                if (!paymentMethodElem) return;
                const paymentMethod = paymentMethodElem.value;

                const qrSection = document.getElementById("qrPaymentSection");
                if (!qrSection) return;

                // Nếu chọn chuyển khoản
                if (paymentMethod === "Chuyển khoản") {

                    qrSection.classList.remove("hidden");

                    // Tạo mã QR
                    generateQRCode();

                    // Bắt đầu đếm ngược
                    startCountdown();

                }

                // Nếu chọn thanh toán tại khách sạn
                else {

                    qrSection.classList.add("hidden");

                    stopCountdown();

                }

            }

            // Tạo mã QR
            function generateQRCode() {
                // Payment references require a saved order ID. QR is shown on Booking/Payment only.
                const qrImage = document.getElementById('qrImage');
                if (qrImage) qrImage.removeAttribute('src');
                const qrContent = document.getElementById('qrContent');
                if (qrContent) qrContent.textContent = 'Xác nhận đặt phòng để nhận mã QR theo đơn.';
            }
            // Bắt đầu đếm ngược 10 phút
            function startCountdown() {

                // Nếu đang đếm thì không tạo thêm
                if (countdownInterval !== null) {

                    return;

                }

                // Nếu lệnh đã hết hạn thì không chạy
                if (paymentExpired) {

                    return;

                }

                remainingSeconds = 600;

                updateCountdownDisplay();

                countdownInterval = setInterval(function () {

                    remainingSeconds--;

                    updateCountdownDisplay();

                    // Khi hết giờ
                    if (remainingSeconds <= 0) {

                        stopCountdown();

                        cancelPayment();

                    }

                }, 1000);

            }

            // Hiển thị thời gian
            function updateCountdownDisplay() {

                const minutes =
                    Math.floor(remainingSeconds / 60);

                const seconds =
                    remainingSeconds % 60;

                const formattedTime =
                    String(minutes).padStart(2, "0") +
                    ":" +
                    String(seconds).padStart(2, "0");

                const timer =
                    document.getElementById("countdownTimer");

                if (timer) {

                    timer.innerText = formattedTime;

                }

            }

            // Dừng đếm ngược
        function stopCountdown() {


                if (countdownInterval !== null) {

                    clearInterval(countdownInterval);

                    countdownInterval = null;

                }

        }
        // =======================================================
        // RESET THANH TOÁN QR CHO LƯỢT ĐẶT PHÒNG MỚI
        // =======================================================

        function resetPaymentState() {

            // Dừng bộ đếm cũ
            stopCountdown();


            // Reset biến
            remainingSeconds = 600;
            paymentExpired = false;

            // Quan trọng:
            // bỏ mã giao dịch của lần đặt trước
            currentTransferContent = null;


            // Reset thời gian về 10 phút
            const timer =
                document.getElementById(
                    "countdownTimer"
                );

            if (timer) {
                timer.innerText = "10:00";
            }


            // Reset trạng thái thanh toán
            const status =
                document.getElementById(
                    "paymentStatus"
                );

            if (status) {

                status.innerText =
                    "Đang chờ thanh toán...";

                status.className =
                    "mt-5 text-center text-sm text-gray-600";
            }


            // Mở lại nút "Tôi đã chuyển khoản"
            const button =
                document.getElementById(
                    "paymentDoneButton"
                );

            if (button) {

                button.disabled = false;

                button.classList.remove(
                    "opacity-50"
                );
            }


            // Xóa QR CŨ
            const qrImage =
                document.getElementById(
                    "qrImage"
                );

            if (qrImage) {
                qrImage.removeAttribute("src");
            }


            // Reset số tiền QR
            const qrAmount =
                document.getElementById(
                    "qrAmount"
                );

            if (qrAmount) {
                qrAmount.innerText = "0đ";
            }


            // Reset nội dung chuyển khoản
            const qrContent =
                document.getElementById(
                    "qrContent"
                );

            if (qrContent) {
                qrContent.innerText = "---";
            }


            // Đưa phương thức thanh toán về mặc định
            const paymentMethod =
                document.getElementById(
                    "paymentMethod"
                );

            if (paymentMethod) {

                paymentMethod.value =
                    "Thanh toán tại khách sạn";
            }


            // Ẩn khu QR ngay lập tức
            const qrSection =
                document.getElementById(
                    "qrPaymentSection"
                );

            if (qrSection) {
                qrSection.classList.add(
                    "hidden"
                );
            }
        }

            // Xác nhận đã chuyển khoản
            function confirmPayment() {

                if (paymentExpired) {

                    alert("Lệnh thanh toán đã hết hạn!");

                    return;

                }

                stopCountdown();

                document.getElementById("paymentStatus").innerText =
                    "Đã ghi nhận yêu cầu xác nhận thanh toán. Vui lòng chờ khách sạn kiểm tra giao dịch.";

                document.getElementById("paymentStatus").className =
                    "mt-5 text-center text-sm text-green-600 font-semibold";

                document.getElementById("paymentDoneButton").disabled =
                    true;

                alert(
                    "Đã ghi nhận yêu cầu thanh toán.\n\n" +
                    "Khách sạn sẽ kiểm tra giao dịch chuyển khoản."
                );

            }

            // Tự động hủy khi hết 10 phút
            function cancelPayment() {

                paymentExpired = true;

                const status =
                    document.getElementById("paymentStatus");

                status.innerText =
                    "Lệnh thanh toán đã hết hạn và tự động hủy.";

                status.className =
                    "mt-5 text-center text-sm text-red-600 font-bold";

                const timer =
                    document.getElementById("countdownTimer");

                timer.innerText = "00:00";

                const button =
                    document.getElementById("paymentDoneButton");

                button.disabled = true;

                button.classList.add("opacity-50");

                alert(
                    "Lệnh thanh toán đã hết hạn!\n\n" +
                    "Đặt phòng chưa được xác nhận."
                );

            }

    </script>
