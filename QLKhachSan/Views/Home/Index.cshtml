                        input.value =
                            'Tôi cần hỗ trợ 24/7';


                        input.focus();

                    }

                },
                150
            );

        }
        // =======================================================
// ẨM THỰC
// =======================================================

function openDiningModal() {

    const modal =
        document.getElementById(
            'diningModal'
        );


    modal.classList.remove(
        'hidden'
    );


    modal.classList.add(
        'flex'
    );


    loadDiningServices();

}


function closeDiningModal() {

    const modal =
        document.getElementById(
            'diningModal'
        );


    modal.classList.add(
        'hidden'
    );


    modal.classList.remove(
        'flex'
    );

}


// =======================================================
// TẢI DỊCH VỤ ẨM THỰC TỪ DATABASE
// =======================================================

function loadDiningServices() {

    const loading =
        document.getElementById(
            'diningLoading'
        );


    const container =
        document.getElementById(
            'diningServices'
        );


    const empty =
        document.getElementById(
            'diningEmpty'
        );


    loading.classList.remove(
        'hidden'
    );


    empty.classList.add(
        'hidden'
    );


    container.innerHTML = '';


    fetch(
        '@Url.Action("GetServices", "Booking")'
    )
        .then(function (response) {

            if (!response.ok) {

                throw new Error(
                    'Không tải được dịch vụ'
                );

            }


            return response.json();

        })
        .then(function (services) {

            loading.classList.add(
                'hidden'
            );


            if (!Array.isArray(services)) {

                empty.classList.remove(
                    'hidden'
                );

                return;

            }


            const diningServices =
                services.filter(
                    function (service) {

                        const name =
                            (
                                service.name || ''
                            )
                            .toLowerCase();


                        return (
                            name.includes('buffet') ||
                            name.includes('ăn') ||
                            name.includes('bữa') ||
                            name.includes('ẩm thực') ||
                            name.includes('food') ||
                            name.includes('breakfast')
                        );

                    }
                );


            if (
                diningServices.length === 0
            ) {

                empty.classList.remove(
                    'hidden'
                );

                return;

            }


            diningServices.forEach(
                function (service) {

                    const card =
                        document.createElement(
                            'div'
                        );


                    card.className =
                        'border border-yellow-200 ' +
                        'bg-yellow-50 rounded-xl p-5';


                    const price =
                        Number(
                            service.price || 0
                        )
                        .toLocaleString(
                            'vi-VN'
                        );


                    card.innerHTML =
                        '<div class="flex items-start gap-4">' +

                            '<div class="' +
                                'w-12 h-12 rounded-full ' +
                                'bg-yellow-500 text-gray-900 ' +
                                'flex items-center justify-center ' +
                                'flex-shrink-0">' +

                                '<i class="fas fa-utensils"></i>' +

                            '</div>' +

                            '<div class="flex-1">' +

                                '<h3 class="' +
                                    'font-bold text-lg text-gray-900">' +

                                    escapeDiningHtml(
                                        service.name || ''
                                    ) +

                                '</h3>' +

                                '<p class="' +
                                    'text-sm text-gray-500 mt-1">' +

                                    escapeDiningHtml(
                                        service.description || ''
                                    ) +

                                '</p>' +

                                '<div class="' +
                                    'mt-4 flex justify-between ' +
                                    'items-end gap-3">' +

                                    '<span class="' +
                                        'font-extrabold text-yellow-700">' +

                                        price +
                                        'đ' +

                                    '</span>' +

                                    '<span class="' +
                                        'text-xs text-gray-500">' +

                                        escapeDiningHtml(
                                            service.unit || ''
                                        ) +

                                    '</span>' +

                                '</div>' +

                            '</div>' +

                        '</div>';

                    const chooseButton =
                        document.createElement(
                            'button'
                        );


                    chooseButton.type =
                        'button';


                    chooseButton.className =
                        'w-full mt-4 ' +
                        'bg-yellow-500 ' +
                        'hover:bg-yellow-600 ' +
                        'text-gray-900 ' +
                        'font-bold ' +
                        'py-2.5 ' +
                        'rounded-lg ' +
                        'transition';


                    chooseButton.innerHTML =
                        '<i class="fas fa-plus-circle mr-2"></i>' +
                        'Chọn dịch vụ này';


                    chooseButton.onclick =
                        function () {

                            chooseDiningService(
                                service.id
                            );

                        };


                    card.appendChild(
                        chooseButton
                    );
                    container.appendChild(
                        card
                    );

                }
            );

        })
        .catch(function () {

            loading.classList.add(
                'hidden'
            );


            empty.classList.remove(
                'hidden'
            );

        });

}


        // =======================================================
        // CHỌN DỊCH VỤ TỪ MODAL ẨM THỰC
        // =======================================================

        function chooseDiningService(
            serviceId
        ) {

            // Ghi nhớ dịch vụ khách vừa chọn
            sessionStorage.setItem(
                'pendingDiningServiceId',
                String(serviceId)
            );


            // Đóng modal ẩm thực
            closeDiningModal();


            // Đưa khách sang danh sách phòng
            showPage(
                'rooms'
            );


            // Thông báo
            setTimeout(
                function () {

                    alert(
                        'Đã ghi nhớ dịch vụ.\\n\\n' +
                        'Hãy chọn phòng bạn muốn đặt.\\n' +
                        'Dịch vụ sẽ tự được chọn trong form đặt phòng.'
                    );

                },
                150
            );

        }
// =======================================================
// CHỐNG CHÈN HTML TỪ DỮ LIỆU
// =======================================================

function escapeDiningHtml(value) {

    const div =
        document.createElement(
            'div'
        );


    div.textContent =
        value || '';


    return div.innerHTML;

}

let tempSelectedRoomNumbers = [];

let roomCache = {};
let roomSelectionVersion = 0;

function openRoomSelectionModal() {
    const requestVersion = ++roomSelectionVersion;
    const roomId = document.getElementById('selectedRoomId').value;
    const checkIn = document.getElementById('checkInDate').value;
    const checkOut = document.getElementById('checkOutDate').value;
    const roomName = document.getElementById('selectedRoom').value.split(' - Phòng')[0];

    if (!roomId) {
        showLuxuryAlert('Vui lòng chọn loại phòng trước khi chọn số phòng!', 'Thông báo', 'warning');
        showPage('rooms');
        return;
    }

    if (!checkIn || !checkOut) {
        showLuxuryAlert('Vui lòng chọn ngày nhận phòng và ngày trả phòng trước!', 'Thông báo', 'warning');
        return;
    }

    if (checkOut <= checkIn) {
        showLuxuryAlert('Ngày trả phòng phải sau ngày nhận phòng!', 'Thông báo', 'warning');
        return;
    }

    const typeNameEl = document.getElementById('modalRoomTypeName');
    const selectedDisplayEl = document.getElementById('modalSelectedRoomDisplay');
    const selectedNumInput = document.getElementById('selectedRoomNumber');

    if (typeNameEl) typeNameEl.innerText = roomName || 'Phòng Luxury';
    tempSelectedRoomNumbers = selectedNumInput && selectedNumInput.value ? selectedNumInput.value.split(',').filter(Boolean) : [];
    if (selectedDisplayEl && selectedNumInput) {
        selectedDisplayEl.innerText = selectedNumInput.value ? 'Phòng ' + selectedNumInput.value : 'Chưa chọn';
    }

    const modal = document.getElementById('roomSelectionModal');
    const grid = document.getElementById('physicalRoomsGrid');

    if (modal) modal.classList.remove('hidden');
    if (grid) grid.innerHTML = '<div class="col-span-full text-center py-8 text-gray-300"><i class="fas fa-spinner fa-spin mr-2"></i> Đang tải danh sách phòng...</div>';

    const cacheKey = roomId + '_' + checkIn + '_' + checkOut;
    // Always reload: another guest may have reserved a room since the last popup.

    const url = '@Url.Action("GetAvailablePhysicalRooms", "Booking")' + '?roomId=' + encodeURIComponent(roomId) + '&checkIn=' + encodeURIComponent(checkIn) + '&checkOut=' + encodeURIComponent(checkOut);

    fetch(url, { cache: 'no-store' })
        .then(response => {
            if (!response.ok) {
                throw new Error('Network response was not ok');
            }
            return response.json();
        })
        .then(res => {
            if (requestVersion !== roomSelectionVersion) return;
            if (res && res.success && res.physicalRooms) {
                roomCache[cacheKey] = res.physicalRooms;
                renderPhysicalRoomsGrid(res.physicalRooms, grid);
            } else {
                if (grid) grid.innerHTML = '<div class="col-span-full text-center py-8 text-rose-400">' + (res.message || 'Không tìm thấy phòng trống trong hệ thống.') + '</div>';
            }
        })
        .catch(error => {
            console.error('Error fetching physical rooms:', error);
            if (grid) grid.innerHTML = '<div class="col-span-full text-center py-8 text-rose-400">Không thể kết nối máy chủ để tải danh sách phòng. Vui lòng thử lại!</div>';
        });
}

function renderPhysicalRoomsGrid(physicalRooms, grid) {
    if (!grid) return;
    let html = '';
    const selectedNumInput = document.getElementById('selectedRoomNumber');
    const currentSelectedNums = tempSelectedRoomNumbers;

    if (!physicalRooms || physicalRooms.length === 0) {
        grid.innerHTML = '<div class="col-span-full text-center py-8 text-gray-400">Chưa có dữ liệu phòng vật lý cho loại phòng này.</div>';
        return;
    }

    for (let i = 0; i < physicalRooms.length; i++) {
        const pr = physicalRooms[i];
        const isBooked = pr.isBooked;
        const isSelected = currentSelectedNums.includes(pr.roomNumber);

        let cardClass = isBooked
            ? 'bg-gray-800 border-gray-700 text-gray-500 cursor-not-allowed opacity-60'
            : 'bg-[#2c2018] border-[#d4af37]/30 text-[#f8f1e7] hover:border-[#d4af37] cursor-pointer room-card-item';

        if (isSelected && !isBooked) {
            cardClass += ' ring-2 ring-yellow-400 bg-[#38281f]';
            // Keep every selected room; one booking may reserve multiple physical rooms.
        }

        html += `
            <div class="border rounded-xl p-4 text-center transition ${cardClass}"
                 data-room-number="${hotelEscapeHtml(pr.roomNumber)}"
                 data-booked="${isBooked}"
                 onclick="selectPhysicalRoom(this)">
                <div class="text-2xl mb-2 ${isBooked ? 'text-gray-600' : 'text-yellow-400'}">
                    <i class="fas fa-${isBooked ? 'lock' : 'bed'}"></i>
                </div>
                <div class="font-bold text-lg">Phòng ${hotelEscapeHtml(pr.roomNumber)}</div>
                <div class="text-xs text-gray-400 mt-1">Tầng ${pr.floor}</div>
                <div class="text-xs mt-2 font-semibold ${isBooked ? 'text-rose-400' : 'text-emerald-400'}">
                    ${isBooked ? 'Đã được đặt' : 'Còn trống'}
                </div>
            </div>
        `;
    }
    grid.innerHTML = html;
}

function closeRoomSelectionModal() {
    roomSelectionVersion++;
    const modal = document.getElementById('roomSelectionModal');
    if (modal) modal.classList.add('hidden');
}

function selectPhysicalRoom(el) {
    if (el.getAttribute('data-booked') === 'true') {
        showLuxuryAlert('Phòng đã được đặt, bảo trì hoặc ngừng hoạt động trong khoảng ngày này.', 'Phòng bận', 'warning');
        return;
    }
    const number = el.getAttribute('data-room-number');
    const count = Number(document.getElementById('roomCount').value || 1);
    if (tempSelectedRoomNumbers.includes(number)) tempSelectedRoomNumbers = tempSelectedRoomNumbers.filter(n => n !== number);
    else {
        if (tempSelectedRoomNumbers.length >= count) {
            showLuxuryAlert('Bạn đã chọn đủ ' + count + ' phòng. Bỏ chọn một phòng trước khi đổi.', 'Chọn số phòng', 'warning');
            return;
        }
        tempSelectedRoomNumbers.push(number);
    }
    document.querySelectorAll('.room-card-item').forEach(card => {
        const selected = tempSelectedRoomNumbers.includes(card.getAttribute('data-room-number'));
        ['ring-2', 'ring-yellow-400', 'bg-[#38281f]'].forEach(c => card.classList.toggle(c, selected));
    });
    const display = document.getElementById('modalSelectedRoomDisplay');
    if (display) display.textContent = tempSelectedRoomNumbers.length ? 'Phòng ' + tempSelectedRoomNumbers.join(', ') : 'Chưa chọn';
}

function confirmRoomSelection() {
    const count = Number(document.getElementById('roomCount').value || 1);
    if (tempSelectedRoomNumbers.length !== count) {
        showLuxuryAlert('Vui lòng chọn đúng ' + count + ' số phòng khác nhau.', 'Chọn số phòng', 'warning');
        return;
    }
    const selectedRoomInput = document.getElementById('selectedRoom');
    const selectedNumInput = document.getElementById('selectedRoomNumber');
    if (selectedRoomInput && selectedNumInput) {
        selectedRoomInput.value = selectedRoomInput.value.split(' - Phòng')[0] + ' - Phòng ' + tempSelectedRoomNumbers.join(', ');
        selectedNumInput.value = tempSelectedRoomNumbers.join(',');
    }
    closeRoomSelectionModal();
}

function resetSelectedRoomNumber() {
    roomSelectionVersion++;
    const selectedNumInput = document.getElementById('selectedRoomNumber');
    const selectedRoomInput = document.getElementById('selectedRoom');

    tempSelectedRoomNumbers = [];
    if (selectedNumInput) selectedNumInput.value = '';
    if (selectedRoomInput) {
        const baseName = selectedRoomInput.value.split(' - Phòng')[0];
        if (baseName) {
            selectedRoomInput.value = baseName;
        }
    }
    roomCache = {};
}

document.addEventListener('DOMContentLoaded', function () {
    ['checkInDate', 'checkOutDate', 'roomCount'].forEach(function (id) {
        const input = document.getElementById(id);
        if (input) input.addEventListener('change', resetSelectedRoomNumber);
    });
});
    </script>

    <!-- MODAL CHỌN SỐ PHÒNG -->
    <div id="roomSelectionModal" class="fixed inset-0 z-[99999] bg-black/70 backdrop-blur-sm hidden flex items-center justify-center p-4">
        <div class="bg-[#241c17] border border-[#d4af37]/40 text-[#f8f1e7] rounded-2xl max-w-2xl w-full p-6 shadow-2xl">
            <div class="flex justify-between items-center mb-4 border-b border-[#d4af37]/20 pb-3">
                <h3 class="text-2xl font-serif font-bold text-[#f5d77a]">
                    <i class="fas fa-door-open mr-2 text-[#d4af37]"></i> CHỌN SỐ PHÒNG
                </h3>
                <button type="button" onclick="closeRoomSelectionModal()" class="text-gray-400 hover:text-white text-xl">
                    <i class="fas fa-times"></i>
                </button>
            </div>

            <div class="mb-4">
                <p class="text-sm text-gray-300">Loại phòng: <strong id="modalRoomTypeName" class="text-yellow-400">---</strong></p>
                <p class="text-xs text-gray-400 mt-1">Chọn đủ số phòng còn trống tương ứng với số lượng đã yêu cầu.</p>
            </div>

            <!-- Lưới phòng vật lý -->
            <div id="physicalRoomsGrid" class="grid grid-cols-2 sm:grid-cols-3 gap-4 mb-6 max-h-[350px] overflow-y-auto p-2">
                <!-- Render qua JS -->
            </div>

            <div class="bg-[#2c2018] p-4 rounded-xl border border-[#d4af37]/20 mb-6 flex justify-between items-center">
                <span class="text-sm text-gray-300">Phòng đã chọn:</span>
                <strong id="modalSelectedRoomDisplay" class="text-lg text-yellow-400 font-serif">Chưa chọn</strong>
            </div>

            <div class="flex justify-end gap-3">
                <button type="button" onclick="closeRoomSelectionModal()" class="bg-[#2c2018] border border-[#d4af37]/30 text-[#f8f1e7] font-semibold px-6 py-2.5 rounded-xl hover:bg-[#38281f] transition">
                    Hủy
                </button>
                <button type="button" onclick="confirmRoomSelection()" class="bg-gradient-to-r from-[#d4af37] to-[#f5d77a] text-[#21170f] font-bold px-8 py-2.5 rounded-xl hover:opacity-90 transition shadow-md">
                    XÁC NHẬN SỐ PHÒNG
                </button>
            </div>
        </div>
    </div>

    @Html.Partial("~/Views/Shared/_LuxuryModal.cshtml")

</body>
</html>

