@{ ViewBag.Title = "Giới thiệu"; }
<section class="max-w-4xl mx-auto bg-white border border-amber-200 rounded-2xl p-8 shadow-sm">
    <h1 class="text-3xl font-serif font-bold text-amber-800 mb-4">Luxury Hotel</h1>
    <p class="mb-4">Khám phá @ViewBag.RoomTypeCount loại phòng và @ViewBag.PhysicalRoomCount phòng đang phục vụ tại khách sạn.</p>
    <p class="mb-6">Bạn có thể chọn số phòng theo ngày lưu trú, đăng ký dịch vụ, gọi món và theo dõi đơn đặt phòng trên website. Thanh toán chuyển khoản được nhân viên đối soát trước khi xác nhận.</p>
    <a href="@Url.Action("Index", "Room")" class="inline-block bg-amber-700 text-white font-bold rounded-lg px-5 py-3">Xem các loại phòng</a>
</section>
